// PADRÃO do sistema para a barra de ferramentas de LISTAS.
//
// Três peças que devem ser usadas juntas em qualquer tela de listagem,
// dentro de um card próprio, acima da lista:
//   ListSearchBox  — busca textual
//   ListFilterBtn  — filtro em lista suspensa
//   ListAddBtn     — abrir o cadastro
//
// Estilo comum (regra do padrão): em repouso são NEUTROS (fundo `surface`,
// borda cinza, ícone/texto secundários) e ficam LARANJA (borda + ícone +
// texto) quando ativos — foco no campo de busca, hover/aberto no filtro,
// e no filtro também quando há um filtro APLICADO, para o usuário perceber
// que a lista está restrita.
//
// UI sem lógica (§1/§3): só coletam texto/opção e avisam via `changed()`;
// a filtragem acontece no Rust sobre a lista completa em cache.
import { Theme } from "../theme.slint";
import { AssetIcon, SearchIcon } from "icons.slint";

// Campo de busca (ícone + input) usado nas listas do painel.
export component ListSearchBox inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder: "Buscar...";
    callback changed();
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.btn-accent : Theme.border;
    background: Theme.surface;

    SearchIcon {
        x: 10px;
        y: (parent.height - 14px) / 2;
        icon-size: 14px;
        // Focado: ícone acompanha a borda na cor de destaque.
        icon-color: input.has-focus ? Theme.btn-accent : Theme.text-secondary;
    }
    input := TextInput {
        x: 32px;
        width: parent.width - 42px;
        height: parent.height;
        vertical-alignment: center;
        text <=> root.value;
        font-size: Theme.fs-13;
        color: Theme.text-primary;
        single-line: true;
        edited => { root.changed(); }
    }
    if root.value == "": Text {
        x: 32px;
        width: parent.width - 42px;
        height: parent.height;
        text: root.placeholder;
        font-size: Theme.fs-13;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

// Opção de um dropdown de filtro (chave + rótulo).
export struct FilterOption {
    key: string,
    label: string,
}

// Botão de filtro com lista suspensa.
export component ListFilterBtn inherits TouchArea {
    in property <[FilterOption]> options;
    in-out property <string> selected: "all";
    callback changed();

    /// Rótulo exibido no botão. O chamador informa (ele já define as
    /// opções) — o Slint não permite percorrer lista em expressão.
    in property <string> label: "Filtrar";
    /// Chave da opção "sem filtro". Quando `selected` difere dela, o botão
    /// fica realçado mesmo em repouso: sinaliza que a lista está filtrada.
    in property <string> neutral-key: "all";

    // Largura suficiente para o maior rótulo ("Suspensas") sem elidir.
    width: 128px;
    height: 32px;
    clicked => { popup.show(); }

    // Neutro em repouso; laranja no hover ou quando há filtro ativo. NÃO
    // usamos estado de "aberto": esta versão do Slint não avisa quando o
    // popup fecha por clique-fora, então o realce ficaria preso em laranja.
    property <bool> filtrando: root.selected != root.neutral-key;
    property <bool> realcado: root.has-hover || root.filtrando;

    Rectangle {
        x: 0; y: 0;
        width: parent.width; height: parent.height;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.realcado ? Theme.btn-accent : Theme.border;
        background: Theme.surface;
        HorizontalLayout {
            padding-left: 9px; padding-right: 8px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                AssetIcon {
                    width: 14px; height: 14px; icon-size: 14px;
                    icon-color: root.realcado ? Theme.btn-accent : Theme.text-secondary;
                    source: @image-url("../assets/icons/filtro.svg");
                }
            }
            Text {
                text: root.label;
                horizontal-stretch: 1;
                font-size: Theme.fs-meta; font-weight: Theme.fw-strong;
                color: root.realcado ? Theme.btn-accent : Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: "▾";
                font-size: Theme.fs-11;
                color: root.realcado ? Theme.btn-accent : Theme.text-secondary;
                vertical-alignment: center;
            }
        }
    }

    popup := PopupWindow {
        x: 0; y: 36px;
        close-policy: close-on-click-outside;
        width: root.width;
        Rectangle {
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.card-border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000030;
            VerticalLayout {
                padding: 4px;
                for o in root.options: opt := TouchArea {
                    height: 32px;
                    clicked => {
                        root.selected = o.key;
                        root.changed();
                    }
                    Rectangle {
                        x: 0; y: 0;
                        width: parent.width; height: parent.height;
                        border-radius: Theme.radius-sm;
                        background: root.selected == o.key
                            ? Theme.btn-accent.transparentize(0.90)
                            : (opt.has-hover ? Theme.row-hover : transparent);
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text {
                                text: o.label;
                                font-size: Theme.fs-meta;
                                font-weight: root.selected == o.key ? 700 : 500;
                                color: root.selected == o.key ? Theme.btn-accent : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Botão "+" quadrado (abrir cadastro).
export component ListAddBtn inherits TouchArea {
    width: 32px;
    height: 32px;
    Rectangle {
        x: 0; y: 0;
        width: parent.width; height: parent.height;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.has-hover ? Theme.btn-accent : Theme.border;
        background: Theme.surface;
        // AssetIcon preenche o botão e centraliza o glifo geometricamente
        // — mais confiável que centralizar um Text de "+" (a caixa da fonte
        // não é simétrica e o sinal fica deslocado).
        AssetIcon {
            width: parent.width; height: parent.height; icon-size: 14px;
            icon-color: root.has-hover ? Theme.btn-accent : Theme.text-secondary;
            source: @image-url("../assets/icons/adicionar.svg");
        }
    }
}
