import { Theme } from "../theme.slint";
import { AssetIcon } from "../components/icons.slint";
import { ActionBtn, OutlineBtn } from "../components/buttons.slint";
import { EmptyState } from "../components/empty_state.slint";
import { WalletSummary, WalletMovementRow } from "../types.slint";
import { PaginationBar } from "../components/pagination.slint";

// Card "Carteira do Cliente" — exibido no detalhe do cliente.
//
// Quando `summary.has-account = false`, mostra apenas o CTA
// "Abrir carteira"; senão exibe saldo + botões + timeline.

component WalletActionBtn inherits TouchArea {
    in property <string> label;
    in property <bool> primary;
    height: 32px;
    width: 120px;
    Rectangle {
        border-radius: 8px;
        // Primário = só CONTORNO na cor de destaque (estilo Relatórios).
        border-width: root.primary ? 1.5px : 1px;
        border-color: root.primary ? Theme.sidebar-sel-bg : Theme.border;
        background: root.has-hover ? Theme.row-hover
            : (root.primary ? transparent : Theme.surface);
        Text {
            width: parent.width; height: parent.height;
            text: root.label;
            font-size: 12px; font-weight: 700;
            color: root.primary ? Theme.sidebar-sel-bg : Theme.text-primary;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

component MovementRow inherits Rectangle {
    in property <WalletMovementRow> data;
    // Altura controlada pelo pai (paginação): o pai define height/visible.
    // Card próprio por movimento (padrão das listas do sistema).
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: ta.has-hover ? Theme.row-hover : Theme.surface;
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 10px;
        // Ícone do movimento — só assets do projeto (§ sem ícones criados):
        // entrada (verde) → entrada-estoque; saída (vermelho) → saida-estoque;
        // limite de fiado / neutro → atividade.
        Rectangle {
            width: 30px; height: 30px;
            y: (parent.height - 30px) / 2;
            border-radius: 6px;
            background: root.data.amount-tone == "pos" ? #E8F5E9
                : (root.data.amount-tone == "neutral" ? Theme.row-alt : #FFEBEE);
            if root.data.amount-tone == "pos": AssetIcon {
                width: parent.width; height: parent.height;
                icon-size: 15px; icon-color: #2E7D32;
                source: @image-url("../assets/icons/entrada-estoque.svg");
            }
            if root.data.amount-tone == "neg": AssetIcon {
                width: parent.width; height: parent.height;
                icon-size: 15px; icon-color: #E53935;
                source: @image-url("../assets/icons/saida-estoque.svg");
            }
            if root.data.amount-tone == "neutral": AssetIcon {
                width: parent.width; height: parent.height;
                icon-size: 15px; icon-color: Theme.text-secondary;
                source: @image-url("../assets/icons/atividade.svg");
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.data.title;
                font-size: 12px; font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: root.data.time-display;
                font-size: 10px;
                color: Theme.text-secondary;
                overflow: elide;
            }
            // Observação/justificativa digitada no modal da operação.
            if root.data.notes != "": Text {
                text: root.data.notes;
                font-size: 10px;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.data.amount-display;
                font-size: 12px; font-weight: 800;
                color: root.data.amount-tone == "pos" ? #2E7D32
                    : (root.data.amount-tone == "neutral" ? Theme.text-primary : #E53935);
                horizontal-alignment: right;
            }
            Text {
                text: root.data.balance-after-display;
                font-size: 10px;
                color: Theme.text-secondary;
                horizontal-alignment: right;
            }
        }
    }
}

export component WalletCard inherits Rectangle {
    in property <WalletSummary> summary;
    in property <[WalletMovementRow]> movements;
    // Trocar o cliente selecionado volta o histórico para a página 1.
    in property <string> reset-key;

    callback open-deposit();
    callback open-withdraw();
    callback open-adjust();
    callback open-limit();
    callback open-wallet();   // primeira abertura quando has-account = false

    // Paginação client-side do histórico: 5 movimentos por página (mesmo
    // padrão da lista de pedidos em customers_page).
    property <int> page: 1;
    property <int> total-pages:
        root.movements.length == 0 ? 0 : (root.movements.length + 4) / 5;
    property <int> eff-page:
        root.total-pages == 0 ? 1
        : (root.page > root.total-pages ? root.total-pages
            : (root.page < 1 ? 1 : root.page));
    property <int> win-start: (root.eff-page - 1) * 5;
    property <string> rk: root.reset-key;
    changed rk => { root.page = 1; }

    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;
    background: Theme.surface;

    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        // Header
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                Text {
                    text: "Carteira do Cliente";
                    font-size: 14px; font-weight: 700;
                    color: Theme.text-primary;
                }
                Text {
                    text: root.summary.has-account
                        ? root.summary.status-label
                        : "Nenhuma carteira ativa";
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
            }
            if root.summary.has-account: HorizontalLayout {
                alignment: center;
                WalletActionBtn {
                    label: "Limite";
                    primary: false;
                    width: 80px;
                    clicked => { root.open-limit(); }
                }
            }
        }

        // Sem carteira: CTA
        if !root.summary.has-account: VerticalLayout {
            spacing: 12px;
            alignment: center;
            Rectangle {
                background: #FFF3E0;
                border-radius: 10px;
                height: 92px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    alignment: center;
                    Text {
                        text: "Este cliente ainda não tem carteira ativa.";
                        font-size: 13px; font-weight: 700;
                        color: #FF9800;
                    }
                    Text {
                        text: "Abra uma carteira para registrar depósitos, saques e vendas no fiado.";
                        font-size: 11px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                WalletActionBtn {
                    label: "Abrir Carteira";
                    primary: true;
                    width: 140px;
                    clicked => { root.open-wallet(); }
                }
            }
        }

        // Com carteira: saldo + ações + timeline
        if root.summary.has-account: VerticalLayout {
            spacing: 14px;

            // Banner do saldo
            Rectangle {
                background: root.summary.balance-tone == "neg"
                    ? #FFEBEE
                    : (root.summary.balance-tone == "pos" ? #E8F5E9 : #f5f5f4);
                border-radius: 10px;
                height: 96px;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 14px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "SALDO ATUAL";
                            font-size: 9px; font-weight: 800;
                            color: Theme.text-secondary;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: root.summary.balance-display;
                            font-size: 26px; font-weight: 800;
                            color: root.summary.balance-tone == "neg"
                                ? #C62828
                                : (root.summary.balance-tone == "pos" ? #2E7D32 : Theme.text-primary);
                        }
                        Text {
                            text: root.summary.available-display;
                            font-size: 11px;
                            color: Theme.text-secondary;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "LIMITE DE FIADO";
                            font-size: 9px; font-weight: 800;
                            color: Theme.text-secondary;
                            letter-spacing: 1px;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: root.summary.credit-limit-display;
                            font-size: 14px; font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-alignment: right;
                        }
                    }
                }
            }

            // Botões de ação
            HorizontalLayout {
                spacing: 8px;
                WalletActionBtn {
                    label: "+ Depositar";
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => { root.open-deposit(); }
                }
                WalletActionBtn {
                    label: "− Sacar";
                    primary: false;
                    horizontal-stretch: 1;
                    clicked => { root.open-withdraw(); }
                }
                WalletActionBtn {
                    label: "Ajustar";
                    primary: false;
                    horizontal-stretch: 1;
                    clicked => { root.open-adjust(); }
                }
            }

            // Timeline
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    Text {
                        text: "HISTÓRICO";
                        font-size: 10px; font-weight: 800;
                        color: Theme.text-secondary;
                        letter-spacing: 1px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.summary.movements-count + " movimentos";
                        font-size: 11px;
                        color: Theme.text-secondary;
                    }
                }
                // Cada movimento em card próprio; caixa envolvente só
                // no estado vazio (moldura da ilustração).
                if root.movements.length > 0: VerticalLayout {
                    spacing: 8px;
                    // Área com altura reservada p/ 5 linhas (5×56 + 4×8 =
                    // 312px): a lista preenche de cima p/ baixo e a barra de
                    // paginação fica FIXA mesmo com menos de 5 movimentos.
                    Rectangle {
                        min-height: 312px;
                        VerticalLayout {
                            // spacing 0: as linhas fora da página colapsam
                            // para altura 0 sem deixar folga no topo — o gap
                            // de 8px é aplicado por linha (menos a primeira).
                            spacing: 0px;
                            alignment: start;
                            for m[i] in root.movements: Rectangle {
                                property <bool> shown: i >= root.win-start && i < root.win-start + 5;
                                property <bool> firstp: i == root.win-start;
                                property <length> row-h: m.notes == "" ? 56px : 72px;
                                height: shown ? (firstp ? row-h : row-h + 8px) : 0px;
                                MovementRow {
                                    x: 0;
                                    y: parent.firstp ? 0px : 8px;
                                    width: parent.width;
                                    height: parent.row-h;
                                    visible: parent.shown;
                                    data: m;
                                }
                            }
                        }
                    }
                    if root.total-pages > 1: PaginationBar {
                        total-pages: root.total-pages;
                        effective-page: root.eff-page;
                        change-page(p) => { root.page = p; }
                    }
                }
                if root.movements.length == 0: Rectangle {
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    background: Theme.bg;
                    // Altura = arte (200px) + rótulo/paddings do
                    // EmptyState (56px) — sem isso a ilustração
                    // vazava para fora do card.
                    height: 256px;
                    EmptyState {
                        source: @image-url("../assets/illustrations/financial-data-presentation.svg");
                        title: "Sem movimentações";
                        art-size: 200px;
                    }
                }
            }
        }
    }
}
