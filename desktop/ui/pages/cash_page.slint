import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card } from "../components/cards.slint";
import { ActionBtn, OutlineBtn } from "../components/buttons.slint";
import { AssetIcon } from "../components/icons.slint";
import { EmptyState } from "../components/empty_state.slint";
import { CashSessionRow, CashMovementRow, CashMethodTotalRow, CashSummaryData } from "../types.slint";

// ── Tela: Gestão de Caixa ─────────────────────────────────────────
// Dois estados controlados por `summary.open`:
//   - fechado: cabeçalho + histórico de sessões + abrir caixa
//   - aberto:  card escuro "Total Esperado", cards de totais,
//              "Pagamentos" (esq.) e "Movimentações" (dir.)
//
// AI_RULES §1/§14: tudo já vem formatado de Rust; UI só pinta.

// Segmento do filtro de movimentações — um por opção dentro do "trilho"
// (ver o container abaixo). MESMO padrão do controle de PERÍODO dos
// Relatórios: sem borda quando inativo, tint + borda na cor de destaque
// quando selecionado. O trilho externo é quem tem fundo/borda/sombra.
component SegBtn inherits TouchArea {
    in property <string> label;
    in property <bool> selected;
    in property <length> pad: 12px;
    width: seg-t.preferred-width + root.pad * 2;
    Rectangle {
        border-radius: 7px;
        border-width: root.selected ? 1.5px : 0px;
        border-color: Theme.btn-accent;
        background: root.selected ? Theme.btn-accent.transparentize(0.90)
            : (root.has-hover ? Theme.row-hover : transparent);
        seg-t := Text {
            width: parent.width; height: parent.height;
            text: root.label;
            font-size: 13px; font-weight: 700;
            color: root.selected ? Theme.btn-accent : Theme.text-primary;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

// Card de total simples (Total / Sangrias / Suprimentos).
component StatCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    horizontal-stretch: 1;
    preferred-width: 0px;
    height: 76px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;
    background: Theme.surface;
    VerticalLayout {
        padding-left: 16px; padding-right: 14px;
        padding-top: 14px; padding-bottom: 14px;
        spacing: 5px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 10px; font-weight: 800;
            letter-spacing: 1px;
            color: Theme.text-secondary;
        }
        Text {
            text: root.value;
            font-size: 20px; font-weight: 800;
            color: Theme.text-primary;
        }
    }
}

// Bloco de métrica do rodapé do card escuro.
component HeroStat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: white;
    horizontal-stretch: 1;
    preferred-width: 0px;
    spacing: 3px;
    Text {
        text: root.label;
        font-size: 9px; font-weight: 800;
        letter-spacing: 1px;
        color: #A8A29A;
    }
    Text {
        text: root.value;
        font-size: 14px; font-weight: 800;
        color: root.value-color;
        overflow: elide;
    }
}

export component CashPage inherits VerticalLayout {
    in property <CashSummaryData> summary;
    in property <[CashSessionRow]> sessions;
    in property <[CashMovementRow]> movements;
    in property <[CashMethodTotalRow]> method-totals;

    // Filtro local da lista de movimentações: "all" | "sale" | "sangria" | "suprimento"
    // Vive na UI porque é responsabilidade puramente visual (§14).
    in-out property <string> mv-filter: "all";

    // Sessão escolhida na lista → detalhes no modal (estado puramente visual).
    in-out property <CashSessionRow> detail-session;

    callback request-open();
    callback request-sangria();
    callback request-suprimento();
    callback request-close();

    // Cor fixa por forma de pagamento — IGUAL ao card "Formas de
    // Pagamento" do Dashboard (mesma cor nos dois temas): Dinheiro verde,
    // PIX azul, Crédito vermelho, Débito amarelo.
    pure function method-color(key: string) -> color {
        return key == "money" ? #2E7D32
            : (key == "pix" ? #1E88E5
            : (key == "credit" ? #E53935
            : (key == "debit" ? #F9A825
            : Theme.btn-accent)));  // wallet
    }

    // Cor do ícone de cada tipo de movimentação.
    pure function kind-color(kind: string) -> color {
        return kind == "sale" ? #2E7D32
            : (kind == "sangria" ? Theme.danger
            : (kind == "suprimento" ? #1E88E5
            : Theme.btn-accent));  // abertura
    }

    // Sem padding interno — o wrapper do main.slint já aplica 24px ao redor.
    padding: 0px;
    spacing: 16px;

    // ── Cabeçalho ─────────────────────────────────────────────────
    // Sem card: status (bolinha + título + selo de tempo), sub-linha e ações.
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 9px; height: 9px;
                        border-radius: 5px;
                        background: root.summary.open ? #4CAF50 : Theme.text-secondary;
                    }
                }
                Text {
                    text: root.summary.status-headline;
                    font-size: 22px; font-weight: 800;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                if root.summary.open && root.summary.status-subtitle != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 24px;
                        width: badge-txt.preferred-width + 20px;
                        border-radius: 7px;
                        background: Theme.accent.transparentize(0.86);
                        badge-txt := Text {
                            text: root.summary.status-subtitle;
                            font-size: 11px; font-weight: 700;
                            color: Theme.accent;
                            width: parent.width; height: parent.height;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
            Text {
                text: root.summary.open ? root.summary.opened-summary : root.summary.status-subtitle;
                font-size: 12px; color: Theme.text-secondary;
            }
        }
        // Ações.
        if !root.summary.open: VerticalLayout {
            alignment: center;
            ActionBtn {
                label: "Abrir Caixa";
                bg-color: Theme.btn-accent;
                icon: @image-url("../assets/icons/cadeado-aberto.svg");
                width: 150px; height: 38px;
                clicked => { root.request-open(); }
            }
        }
        if root.summary.open: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                OutlineBtn {
                    label: "Sangria";
                    neutral: true;
                    icon: @image-url("../assets/icons/saida-estoque.svg");
                    width: 128px; height: 38px;
                    clicked => { root.request-sangria(); }
                }
                OutlineBtn {
                    label: "Suprimento";
                    neutral: true;
                    icon: @image-url("../assets/icons/entrada-estoque.svg");
                    width: 140px; height: 38px;
                    clicked => { root.request-suprimento(); }
                }
                ActionBtn {
                    label: "Fechar Caixa";
                    bg-color: Theme.btn-accent;
                    icon: @image-url("../assets/icons/seguranca.svg");
                    width: 150px; height: 38px;
                    clicked => { root.request-close(); }
                }
            }
        }
    }

    // ── Estado FECHADO: histórico de sessões ──────────────────────
    // Sem card grande envolvendo: só o título e, abaixo, CADA sessão em seu
    // próprio card. Clicar num card abre o modal de detalhes.
    if !root.summary.open: VerticalLayout {
        vertical-stretch: 1;
        spacing: 12px;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: "SESSÕES ANTERIORES";
                font-size: 11px; font-weight: 800; letter-spacing: 1px;
                color: Theme.text-primary;
            }
            Text {
                text: "Histórico dos últimos fechamentos · toque para ver os detalhes";
                font-size: 11px; color: Theme.text-secondary;
            }
        }

        if root.sessions.length > 0: ScrollView {
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                // Respiro entre os cards vai na altura do wrapper de cada um;
                // o padding lateral evita a sombra ser recortada.
                padding-left: 2px; padding-right: 2px;
                for s in root.sessions: Rectangle {
                    height: 76px;
                    background: transparent;
                    card-ta := TouchArea {
                        clicked => {
                            root.detail-session = s;
                            detail-popup.show();
                        }
                    }
                    Rectangle {
                        x: 0; y: 0;
                        width: parent.width; height: 66px;
                        border-radius: 12px;
                        border-width: 1px; border-color: Theme.card-border;
                        drop-shadow-blur: 12px; drop-shadow-offset-y: 0px;
                        drop-shadow-color: Theme.card-shadow;
                        background: card-ta.has-hover ? Theme.row-hover : Theme.surface;
                        HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            spacing: 12px;
                            // Data + horários.
                            VerticalLayout {
                                alignment: center; spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: s.opened-date;
                                    font-size: 13px; font-weight: 700;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: "Abertura " + s.opened-time
                                        + (s.closed-time != "" ? " · Fechamento " + s.closed-time : "");
                                    font-size: 11px; color: Theme.text-secondary;
                                }
                            }
                            // Operador.
                            VerticalLayout {
                                alignment: center;
                                width: 150px;
                                Text {
                                    text: s.operator-name;
                                    font-size: 12px; color: Theme.text-primary;
                                    overflow: elide;
                                }
                            }
                            // Total.
                            VerticalLayout {
                                alignment: center;
                                width: 120px;
                                Text {
                                    text: s.total-display;
                                    font-size: 13px; font-weight: 700;
                                    color: Theme.text-primary;
                                    horizontal-alignment: right;
                                    width: parent.width;
                                }
                            }
                            // Diferença.
                            VerticalLayout {
                                alignment: center;
                                width: 110px;
                                Text {
                                    text: s.difference-display == "" ? "—" : s.difference-display;
                                    font-size: 12px; font-weight: 700;
                                    color: s.difference-display == "R$ 0,00" ? #2E7D32
                                        : (s.difference-display == "" ? Theme.text-secondary : Theme.danger);
                                    horizontal-alignment: right;
                                    width: parent.width;
                                }
                            }
                        }
                    }
                }
            }
        }
        if root.sessions.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            EmptyState {
                source: @image-url("../assets/illustrations/business-workflow.svg");
                title: "Caixa fechado";
                subtitle: "Abra o caixa para operar";
                art-size: 240px;
            }
        }
    }

    // ── Modal de detalhes da sessão (aberto ao tocar num card) ─────
    detail-popup := PopupWindow {
        width: 420px;
        height: 360px;
        x: (root.width - self.width) / 2;
        y: 120px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: 16px;
            background: Theme.surface;
            border-width: 1px; border-color: Theme.card-border;
            drop-shadow-blur: 24px; drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                Text {
                    text: "Sessão de " + root.detail-session.opened-date;
                    font-size: 17px; font-weight: 800; color: Theme.text-primary;
                }
                Rectangle { height: 1px; background: Theme.border; }
                // Linhas de detalhe (rótulo à esquerda, valor à direita).
                for row in [
                    { l: "Abertura", v: root.detail-session.opened-time },
                    { l: "Fechamento", v: root.detail-session.closed-time == "" ? "—" : root.detail-session.closed-time },
                    { l: "Abriu", v: root.detail-session.operator-name },
                    { l: "Fechou", v: root.detail-session.closed-by == "" ? "—" : root.detail-session.closed-by },
                    { l: "Total", v: root.detail-session.total-display },
                    { l: "Diferença", v: root.detail-session.difference-display == "" ? "—" : root.detail-session.difference-display },
                    { l: "Status", v: root.detail-session.status-label },
                ]: HorizontalLayout {
                    Text {
                        text: row.l;
                        font-size: 13px; color: Theme.text-secondary;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: row.v;
                        font-size: 13px; font-weight: 600; color: Theme.text-primary;
                    }
                }
            }
        }
    }

    // ── Estado ABERTO ─────────────────────────────────────────────
    if root.summary.open: HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;

        // ── Coluna esquerda: total esperado + pagamentos ──
        VerticalLayout {
            width: 272px;
            spacing: 16px;

            // Card escuro — total esperado no fechamento.
            Rectangle {
                height: 150px;
                border-radius: 16px;
                background: Theme.sidebar-bg;
                clip: true;
                VerticalLayout {
                    padding: 18px;
                    spacing: 0px;
                    Text {
                        text: "TOTAL ESPERADO";
                        font-size: 10px; font-weight: 800;
                        letter-spacing: 1.4px;
                        color: #A8A29A;
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: root.summary.cash-now-display;
                        font-size: 30px; font-weight: 800;
                        color: white;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Rectangle { height: 1px; background: #FFFFFF14; }
                    Rectangle { height: 12px; }
                    HorizontalLayout {
                        spacing: 8px;
                        HeroStat {
                            label: "VENDAS";
                            value: root.summary.sales-count-display;
                        }
                        HeroStat {
                            label: "TICKET MÉDIO";
                            value: root.summary.ticket-display;
                        }
                    }
                }
            }

            // Pagamentos da sessão — altura conforme a lista.
            Card {
                height: pay-l.preferred-height;
                border-radius: 14px;
                pay-l := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "PAGAMENTOS";
                        font-size: 11px; font-weight: 800; letter-spacing: 1px;
                        color: Theme.text-primary;
                    }
                    for m in root.method-totals: Rectangle {
                        height: 46px;
                        background: transparent;
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 34px; height: 34px;
                                    border-radius: 9px;
                                    background: root.method-color(m.key).transparentize(0.88);
                                    if m.key == "money": AssetIcon { width: 100%; height: 100%; icon-size: 18px; icon-color: root.method-color(m.key); source: @image-url("../assets/icons/pay-dinheiro.svg"); }
                                    if m.key == "pix": AssetIcon { width: 100%; height: 100%; icon-size: 18px; icon-color: root.method-color(m.key); source: @image-url("../assets/icons/pay-pix.svg"); }
                                    if m.key == "credit": AssetIcon { width: 100%; height: 100%; icon-size: 18px; icon-color: root.method-color(m.key); source: @image-url("../assets/icons/pay-cartao-credito.svg"); }
                                    if m.key == "debit": AssetIcon { width: 100%; height: 100%; icon-size: 18px; icon-color: root.method-color(m.key); source: @image-url("../assets/icons/pay-cartao-debito.svg"); }
                                    if m.key == "wallet": AssetIcon { width: 100%; height: 100%; icon-size: 18px; icon-color: root.method-color(m.key); source: @image-url("../assets/icons/pay-carteira.svg"); }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                min-width: 0;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: m.label;
                                    font-size: 12.5px; font-weight: 700;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: m.count-display;
                                    font-size: 10.5px;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: m.amount-display;
                                    font-size: 13px; font-weight: 800;
                                    color: Theme.text-primary;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }
                }
            }
            // Espaço livre abaixo dos cards da coluna.
            Rectangle { vertical-stretch: 1; background: transparent; }
        }

        // ── Coluna direita: totais + movimentações ──
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 16px;

            HorizontalLayout {
                spacing: 16px;
                StatCard { label: "TOTAL"; value: root.summary.total-day-display; }
                StatCard { label: "SANGRIAS"; value: root.summary.sangrias-display; }
                StatCard { label: "SUPRIMENTOS"; value: root.summary.suprimentos-display; }
            }

            // Sem `Card`: a lista de movimentações fica direto sobre o fundo
            // da página (sem o retângulo grande com borda/sombra). Cada
            // movimentação já é o próprio cartão.
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;

                    // Título + filtro segmentado.
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 14px;
                        padding-top: 16px; padding-bottom: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: "MOVIMENTAÇÕES";
                                font-size: 11px; font-weight: 800; letter-spacing: 1px;
                                color: Theme.text-primary;
                            }
                        }
                        // Trilho segmentado — mesmo container do controle de
                        // período dos Relatórios (fundo, borda e sombra no
                        // trilho; o segmento ativo em pill laranja).
                        Rectangle {
                            height: 40px;
                            border-radius: 10px;
                            border-width: 1px; border-color: Theme.card-border;
                            drop-shadow-blur: 12px;
                            drop-shadow-offset-y: 0px;
                            drop-shadow-color: Theme.card-shadow;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding: 4px; spacing: 4px;
                                SegBtn {
                                    label: "Tudo";
                                    selected: root.mv-filter == "all";
                                    clicked => { root.mv-filter = "all"; }
                                }
                                SegBtn {
                                    label: "Vendas";
                                    selected: root.mv-filter == "sale";
                                    clicked => { root.mv-filter = "sale"; }
                                }
                                SegBtn {
                                    label: "Sangrias";
                                    selected: root.mv-filter == "sangria";
                                    clicked => { root.mv-filter = "sangria"; }
                                }
                                SegBtn {
                                    label: "Suprim.";
                                    selected: root.mv-filter == "suprimento";
                                    clicked => { root.mv-filter = "suprimento"; }
                                }
                            }
                        }
                    }


                    if root.movements.length > 0: ScrollView {
                        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            // Folga lateral para a sombra dos cards não ser
                            // recortada; o respiro entre eles vai na altura
                            // do wrapper (colapsa quando o filtro esconde).
                            padding-left: 12px; padding-right: 12px;
                            padding-top: 8px; padding-bottom: 8px;
                            for mv in root.movements: Rectangle {
                                height: (root.mv-filter == "all" || root.mv-filter == mv.kind) ? 58px : 0px;
                                visible: root.mv-filter == "all" || root.mv-filter == mv.kind;
                                background: transparent;
                                Rectangle {
                                x: 0; y: 0;
                                width: parent.width; height: 50px;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.card-border;
                                drop-shadow-blur: 8px;
                                drop-shadow-offset-y: 0px;
                                drop-shadow-color: Theme.card-shadow;
                                background: mv-ta.has-hover ? Theme.row-hover : Theme.surface;
                                mv-ta := TouchArea { }
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    spacing: 12px;
                                    Text {
                                        text: mv.time-display;
                                        font-size: 12px; color: Theme.text-secondary;
                                        width: 54px; vertical-alignment: center;
                                    }
                                    // Ícone do tipo + rótulo.
                                    HorizontalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 10px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 28px; height: 28px;
                                                border-radius: 8px;
                                                background: root.kind-color(mv.kind).transparentize(0.88);
                                                if mv.kind == "sale": AssetIcon { width: 100%; height: 100%; icon-size: 15px; icon-color: root.kind-color(mv.kind); source: @image-url("../assets/icons/vendas-pedidos.svg"); }
                                                if mv.kind == "sangria": AssetIcon { width: 100%; height: 100%; icon-size: 15px; icon-color: root.kind-color(mv.kind); source: @image-url("../assets/icons/saida-estoque.svg"); }
                                                if mv.kind == "suprimento": AssetIcon { width: 100%; height: 100%; icon-size: 15px; icon-color: root.kind-color(mv.kind); source: @image-url("../assets/icons/entrada-estoque.svg"); }
                                                if mv.kind != "sale" && mv.kind != "sangria" && mv.kind != "suprimento": AssetIcon { width: 100%; height: 100%; icon-size: 15px; icon-color: root.kind-color(mv.kind); source: @image-url("../assets/icons/cadeado-aberto.svg"); }
                                            }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            min-width: 0;
                                            alignment: center;
                                            Text {
                                                text: mv.title;
                                                font-size: 12.5px; font-weight: 700;
                                                color: Theme.text-primary;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    Text {
                                        text: mv.method-label;
                                        font-size: 11px; color: Theme.text-secondary;
                                        width: 140px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                    Text {
                                        text: mv.amount-display;
                                        font-size: 12.5px; font-weight: 800;
                                        color: mv.sign == "pos" ? #2E7D32 : (mv.sign == "neg" ? Theme.danger : Theme.text-primary);
                                        width: 110px; horizontal-alignment: right; vertical-alignment: center;
                                    }
                                }
                                }
                            }
                        }
                    }

                    if root.movements.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        EmptyState {
                            source: @image-url("../assets/illustrations/financial-data-presentation.svg");
                            title: "Sem movimentações";
                            subtitle: "As vendas e ajustes da sessão aparecem aqui";
                            art-size: 260px;
                        }
                    }
                }
            }
        }
    }
}
