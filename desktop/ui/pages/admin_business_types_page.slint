// Painel do super admin — Tipos de Empresa (ramo do estabelecimento).
// Vitrine em GRADE: um card por tipo com nome, descrição e status. O
// cadastro/edição vive num MODAL. UI sem lógica (§1/§3): lista/salvar
// delegam ao Rust (rotas /admin/business-types).
import { Theme } from "../theme.slint";
import { AdminBusinessTypeRow } from "../types.slint";
import { EmptyState } from "../components/empty_state.slint";
import { AssetIcon } from "../components/icons.slint";

// Botão de ação só-ícone (editar / excluir).
component IconActionBtn inherits TouchArea {
    in property <image> icon;
    in property <color> hover-color;
    in property <color> hover-bg;
    width: 30px; height: 30px;
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: 6px;
        background: root.has-hover ? root.hover-bg : transparent;
        AssetIcon {
            width: parent.width; height: parent.height; icon-size: 16px;
            icon-color: root.has-hover ? root.hover-color : Theme.text-secondary;
            source: root.icon;
        }
    }
}

// Card de UM tipo de empresa.
component TypeCard inherits Rectangle {
    in property <AdminBusinessTypeRow> b;
    callback edit();
    callback remove();

    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;
    clip: true;

    VerticalLayout {
        padding: 20px;
        spacing: 0px;

        // Nome + selo de inativo.
        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: root.b.name;
                font-size: 15px; font-weight: 800;
                color: Theme.text-primary;
                overflow: elide;
                vertical-alignment: center;
            }
            if !root.b.active: Rectangle {
                width: inat.preferred-width + 16px; height: 20px;
                border-radius: 6px;
                background: Theme.danger.transparentize(0.88);
                inat := Text {
                    width: parent.width; height: parent.height;
                    text: "Inativo";
                    font-size: 10px; font-weight: 700; color: Theme.danger;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 10px; }

        Text {
            text: root.b.description == "" ? "Sem descrição" : root.b.description;
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
            overflow: elide;
        }

        // Empurra o rodapé para a base — cards da linha alinham o rodapé.
        Rectangle { vertical-stretch: 1; background: transparent; min-height: 12px; }

        Rectangle { height: 1px; background: Theme.border; }
        Rectangle { height: 12px; }

        // Rodapé: ordem + ações.
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: "Ordem: " + root.b.sort-order;
                    font-size: 11px;
                    color: Theme.text-secondary;
                }
            }
            VerticalLayout {
                alignment: center;
                IconActionBtn {
                    icon: @image-url("../assets/icons/editar.svg");
                    hover-color: Theme.btn-accent;
                    hover-bg: Theme.row-hover;
                    clicked => { root.edit(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconActionBtn {
                    icon: @image-url("../assets/icons/lixeira.svg");
                    hover-color: Theme.danger;
                    hover-bg: #FFEBEE;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

// Célula da grade: mantém a largura da coluna mesmo quando vazia.
component TypeCell inherits Rectangle {
    in property <bool> filled;
    in property <AdminBusinessTypeRow> b;
    callback edit();
    callback remove();
    horizontal-stretch: 1;
    preferred-width: 0px;
    background: transparent;
    if root.filled: TypeCard {
        width: parent.width; height: parent.height;
        b: root.b;
        edit => { root.edit(); }
        remove => { root.remove(); }
    }
}

export component AdminBusinessTypesPage inherits VerticalLayout {
    in property <[AdminBusinessTypeRow]> business-types;
    callback new-type();
    callback edit-type(string);
    // Exclusão pede confirmação: passa (id, nome) para o modal.
    callback delete-type(string, string);

    // 3 tipos por linha; a última linha completa com células vazias.
    property <int> per-row: 3;
    property <int> row-count: (root.business-types.length + root.per-row - 1) / root.per-row;

    spacing: 16px;

    // Cabeçalho: título à esquerda, "Novo Tipo" à direita.
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: "Tipos de Empresa"; font-size: 20px; font-weight: 800; color: Theme.text-primary; }
            Text {
                text: "Ramos de estabelecimento da plataforma";
                font-size: 13px; color: Theme.text-secondary;
            }
        }
        VerticalLayout {
            alignment: center;
            new-ta := TouchArea {
                width: 148px; height: 40px;
                clicked => { root.new-type(); }
                Rectangle {
                    border-radius: 10px;
                    background: new-ta.has-hover ? Theme.btn-accent.darker(0.12) : Theme.btn-accent;
                    HorizontalLayout {
                        alignment: center; spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            AssetIcon {
                                width: 14px; height: 14px; icon-size: 14px;
                                icon-color: white;
                                source: @image-url("../assets/icons/adicionar.svg");
                            }
                        }
                        Text {
                            text: "Novo Tipo";
                            font-size: 13px; font-weight: 700; color: white;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Empty state centralizado no espaço livre.
    if root.business-types.length == 0: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            EmptyState {
                source: @image-url("../assets/illustrations/finance-management.svg");
                art-size: 380px;
                title: "Nenhum tipo de empresa";
                subtitle: "Cadastre os ramos de estabelecimento (ex.: Restaurante, Loja)";
            }
        }
    }

    // Vitrine: grade de 3 cards por linha.
    if root.business-types.length > 0: Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: grid.preferred-height;
        grid := VerticalLayout {
            spacing: 18px;
            alignment: start;
            padding-left: 6px; padding-right: 6px;
            padding-top: 6px; padding-bottom: 14px;
            for row-idx in root.row-count: HorizontalLayout {
                spacing: 18px;
                height: 176px;
                TypeCell {
                    filled: row-idx * 3 < root.business-types.length;
                    b: root.business-types[row-idx * 3];
                    edit => { root.edit-type(root.business-types[row-idx * 3].id); }
                    remove => { root.delete-type(root.business-types[row-idx * 3].id, root.business-types[row-idx * 3].name); }
                }
                TypeCell {
                    filled: row-idx * 3 + 1 < root.business-types.length;
                    b: root.business-types[row-idx * 3 + 1];
                    edit => { root.edit-type(root.business-types[row-idx * 3 + 1].id); }
                    remove => { root.delete-type(root.business-types[row-idx * 3 + 1].id, root.business-types[row-idx * 3 + 1].name); }
                }
                TypeCell {
                    filled: row-idx * 3 + 2 < root.business-types.length;
                    b: root.business-types[row-idx * 3 + 2];
                    edit => { root.edit-type(root.business-types[row-idx * 3 + 2].id); }
                    remove => { root.delete-type(root.business-types[row-idx * 3 + 2].id, root.business-types[row-idx * 3 + 2].name); }
                }
            }
        }
    }
}
