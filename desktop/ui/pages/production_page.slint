// Tela de PRODUÇÃO (recurso da "fábrica"). Lista os produtos e permite
// produzir N unidades de cada um — consome a ficha técnica (insumos) e dá
// entrada no estoque. UI sem lógica (§1/§3): "Produzir" abre o modal, que
// delega ao Rust (ProductService::produce).
import { Theme } from "../theme.slint";
import { ActionBtn } from "../components/buttons.slint";
import { EmptyState } from "../components/empty_state.slint";
import { ProductData } from "../types.slint";
import { ProductsState } from "../state/products.slint";

export component ProductionPage inherits VerticalLayout {
    spacing: 16px;

    // Cabeçalho.
    VerticalLayout {
        spacing: 2px;
        Text { text: "Produção"; font-size: 20px; font-weight: 800; color: Theme.text-primary; }
        Text {
            text: "Produza itens: dá entrada no estoque do produto e consome os insumos da ficha técnica.";
            font-size: 13px; color: Theme.text-secondary;
        }
    }

    if ProductsState.products.length == 0: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            EmptyState {
                source: @image-url("../assets/illustrations/finance-management.svg");
                art-size: 340px;
                title: "Nenhum produto";
                subtitle: "Cadastre produtos (com ficha técnica) para produzir.";
            }
        }
    }

    if ProductsState.products.length > 0: Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: list.preferred-height;
        list := VerticalLayout {
            spacing: 8px;
            alignment: start;
            padding-right: 6px;
            for p in ProductsState.products: Rectangle {
                height: 62px;
                border-radius: Theme.radius-xl;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.card-border;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 12px;
                    spacing: 12px;
                    // Nome + status de estoque.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: p.name;
                            font-size: 14px; font-weight: 700; color: Theme.text-primary;
                            overflow: elide;
                        }
                        Text {
                            text: p.unlimited-stock ? "Estoque ilimitado (não produzível)"
                                : ("Em estoque: " + p.stock-quantity + "  ·  " + p.stock-status-label);
                            font-size: 11px; color: Theme.text-secondary;
                        }
                    }
                    // Botão Produzir (some p/ produto de estoque ilimitado).
                    VerticalLayout {
                        alignment: center;
                        if !p.unlimited-stock: ActionBtn {
                            label: "Produzir";
                            width: 130px; height: 36px;
                            clicked => {
                                ProductsState.produce-product-id = p.id;
                                ProductsState.produce-product-name = p.name;
                                ProductsState.produce-quantity = "";
                                ProductsState.produce-error = "";
                                ProductsState.produce-modal-open = true;
                            }
                        }
                    }
                }
            }
        }
    }
}
