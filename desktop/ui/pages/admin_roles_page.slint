// Painel do super admin — Funções (RBAC do painel). Mesma estrutura da tela
// de Empresas: toolbar (busca + "+") + UM CARD POR FUNÇÃO; cadastro num modal.
// UI sem lógica (§1/§3) — o backend valida as telas e enforça por rota (§11).
import { Theme } from "../theme.slint";
import { AdminRoleRow } from "../types.slint";
import { EmptyState } from "../components/empty_state.slint";
import { ListSearchBox, ListAddBtn } from "../components/list_toolbar.slint";
import { AssetIcon } from "../components/icons.slint";

component IconActionBtn inherits TouchArea {
    in property <image> icon;
    in property <color> hover-color;
    in property <color> hover-bg;
    width: 30px; height: 30px;
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: 6px;
        background: root.has-hover ? root.hover-bg : transparent;
        AssetIcon {
            width: parent.width; height: parent.height; icon-size: 16px;
            icon-color: root.has-hover ? root.hover-color : Theme.text-secondary;
            source: root.icon;
        }
    }
}

component RoleCard inherits Rectangle {
    in property <AdminRoleRow> r;
    callback edit();
    callback remove();

    height: 74px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;

    HorizontalLayout {
        padding-left: 16px; padding-right: 14px;
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 2;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.r.name;
                font-size: 14px; font-weight: 700; color: Theme.text-primary; overflow: elide;
            }
            Text {
                text: root.r.screen-count + (root.r.screen-count == 1 ? " Tela · " : " Telas · ") + root.r.screens-summary;
                font-size: 11.5px; color: Theme.text-secondary; overflow: elide;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.r.users == 0 ? "Nenhum Usuário"
                    : (root.r.users == 1 ? "1 Usuário" : root.r.users + " Usuários");
                font-size: 11.5px; font-weight: root.r.users > 0 ? 700 : 400;
                color: root.r.users > 0 ? Theme.btn-accent : Theme.text-secondary;
                horizontal-alignment: center; overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            IconActionBtn {
                icon: @image-url("../assets/icons/editar.svg");
                hover-color: Theme.btn-accent;
                hover-bg: Theme.row-hover;
                clicked => { root.edit(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconActionBtn {
                icon: @image-url("../assets/icons/lixeira.svg");
                hover-color: Theme.danger;
                hover-bg: #FFEBEE;
                clicked => { root.remove(); }
            }
        }
    }
}

export component AdminRolesPage inherits VerticalLayout {
    in property <[AdminRoleRow]> roles;
    in-out property <string> search;
    callback new-role();
    callback edit-role(string);
    callback delete-role(string, string);
    callback filters-changed();

    spacing: 12px;

    VerticalLayout {
        spacing: 2px;
        Text { text: "Funções"; font-size: 20px; font-weight: 800; color: Theme.text-primary; }
        Text {
            text: "Defina quais telas do painel cada função libera.";
            font-size: 13px; color: Theme.text-secondary;
        }
    }

    Rectangle {
        height: 56px;
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 0px;
        drop-shadow-color: Theme.card-shadow;
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                ListSearchBox {
                    value <=> root.search;
                    placeholder: "Buscar por nome da função...";
                    changed => { root.filters-changed(); }
                }
            }
            VerticalLayout {
                alignment: center;
                ListAddBtn { clicked => { root.new-role(); } }
            }
        }
    }

    if root.roles.length == 0: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            EmptyState {
                source: @image-url("../assets/illustrations/leadership.svg");
                art-size: 320px;
                title: "Nenhuma função";
                subtitle: "Crie funções para restringir o acesso dos administradores";
            }
        }
    }

    if root.roles.length > 0: Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: cards.preferred-height;
        cards := VerticalLayout {
            spacing: 10px;
            alignment: start;
            padding-left: 14px; padding-right: 14px;
            padding-top: 14px; padding-bottom: 14px;
            for r in root.roles: RoleCard {
                r: r;
                edit => { root.edit-role(r.id); }
                remove => { root.delete-role(r.id, r.name); }
            }
        }
    }
}
