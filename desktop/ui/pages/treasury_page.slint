import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TreasurySummary, TreasuryMovementRow, TreasuryChartBar, TreasuryBreakdownRow } from "../types.slint";
import { ActionBtn } from "../components/buttons.slint";
import { AssetIcon } from "../components/icons.slint";

// ── Tela: Carteira do estabelecimento (tesouraria) ────────────────
//
// Regras (AI_RULES.md §1, §3, §14): a UI só renderiza — saldo, filtros
// e agregações são DERIVADOS no Rust (inicial + entradas − saídas,
// consolidando Pedidos, Carteira de clientes, Financeiro e os aportes/
// retiradas manuais). O cadastro inicial coleta o saldo inicial e
// delega ao service.

// Caixa de ícone quadrada (entrada verde / saída vermelha / neutra).
component MoneyIcon inherits Rectangle {
    in property <string> tone;  // "pos" | "neg" | "neutral"
    in property <length> box: 32px;
    in property <bool> on-dark: false;
    width: root.box; height: root.box;
    border-radius: 8px;
    background: root.on-dark
        ? (root.tone == "pos" ? #2E7D3233 : (root.tone == "neg" ? #E5393533 : #FFFFFF1A))
        : (root.tone == "pos" ? #E8F5E9 : (root.tone == "neg" ? #FFEBEE : Theme.row-alt));
    AssetIcon {
        width: 100%; height: 100%;
        icon-size: root.box * 0.46;
        icon-color: root.tone == "pos" ? #2E7D32
            : (root.tone == "neg" ? #E53935
            : (root.on-dark ? #D6D3CA : Theme.text-secondary));
        source: root.tone == "neg"
            ? @image-url("../assets/icons/saida-estoque.svg")
            : @image-url("../assets/icons/entrada-estoque.svg");
    }
}

// Barra de UMA hora do mini-gráfico: sobe ou desce a partir da linha
// central. Horas sem movimento viram um traço fino sobre a linha.
component ChartBar inherits Rectangle {
    in property <TreasuryChartBar> data;
    in property <bool> hovered;
    callback hover(bool);
    horizontal-stretch: 1;
    preferred-width: 0px;
    // Metade útil: a linha central fica no meio da área do gráfico.
    property <length> half: root.height / 2;
    property <bool> empty: root.data.progress < 0.005;
    property <length> bar-h: root.empty ? 4px : max(6px, root.half * root.data.progress);
    Rectangle {
        x: 0;
        width: root.width;
        y: root.empty
            ? root.half - 2px
            : (root.data.positive ? root.half - root.bar-h : root.half);
        height: root.bar-h;
        border-radius: 5px;
        background: root.data.current
            ? Theme.btn-accent
            : (root.hovered ? #FFFFFF47 : #FFFFFF1F);
    }
    // Área de hover da COLUNA inteira — não só da barra.
    bar-ta := TouchArea {
        changed has-hover => { root.hover(bar-ta.has-hover); }
    }
}

// Linha rótulo → valor do card flutuante.
component TipLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color;
    in property <bool> strong: false;
    spacing: 10px;
    Text {
        text: root.label;
        font-size: 11px;
        font-weight: root.strong ? 700 : 400;
        color: root.strong ? #E6E3DC : #A8A29A;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        font-size: root.strong ? 12px : 11px;
        font-weight: 800;
        color: root.value-color;
        vertical-alignment: center;
    }
}

// Card flutuante do gráfico: hora, entradas, saídas e o líquido.
component ChartTip inherits Rectangle {
    in property <TreasuryChartBar> data;
    width: 196px;
    height: tip-l.preferred-height;
    border-radius: 10px;
    background: #2B2B28;
    border-width: 1px;
    border-color: #FFFFFF1F;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000066;
    tip-l := VerticalLayout {
        padding: 12px;
        spacing: 7px;
        Text {
            text: root.data.hour-label;
            font-size: 11px; font-weight: 800;
            letter-spacing: 0.6px;
            color: white;
        }
        Rectangle { height: 1px; background: #FFFFFF1F; }
        TipLine { label: "Entradas"; value: root.data.inflow-display; value-color: #7BD389; }
        TipLine { label: "Saídas"; value: root.data.outflow-display; value-color: #FF8A80; }
        Rectangle { height: 1px; background: #FFFFFF1F; }
        TipLine {
            label: "Total";
            value: root.data.net-display;
            value-color: root.data.positive ? #7BD389 : #FF8A80;
            strong: true;
        }
    }
}

// Card branco padrão da tela.
component Panel inherits Rectangle {
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;
    background: Theme.surface;
}

// Linha do detalhamento: um card por origem (rótulo → valor).
// Origens sem movimento no dia ficam apagadas.
component BreakdownRow inherits Rectangle {
    in property <TreasuryBreakdownRow> data;
    height: 42px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.data.label;
            font-size: 12px;
            color: root.data.muted ? Theme.text-secondary.transparentize(0.4) : Theme.text-primary;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: root.data.value;
            font-size: 12px; font-weight: 700;
            color: root.data.muted
                ? Theme.text-secondary.transparentize(0.4)
                : (root.data.negative ? #C62828 : #2E7D32);
            vertical-alignment: center;
        }
    }
}

// Cabeçalho de um grupo do detalhamento (Entradas / Saídas): rótulo
// e, ABAIXO dele, o total do grupo.
component BreakdownGroup inherits HorizontalLayout {
    in property <string> label;
    in property <string> total;
    in property <bool> negative;
    spacing: 8px;
    VerticalLayout {
        alignment: start;
        padding-top: 4px;
        Rectangle {
            width: 8px; height: 8px;
            border-radius: 4px;
            background: root.negative ? #E53935 : #2E7D32;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            font-size: 10px; font-weight: 800; letter-spacing: 1px;
            color: Theme.text-secondary;
        }
        Text {
            text: root.total;
            font-size: 15px; font-weight: 800;
            color: root.negative ? #C62828 : #2E7D32;
        }
    }
}

// Linha do fechamento de conta (rodapé do detalhamento).
component TotalLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;
    in property <length> value-size: 12px;
    spacing: 8px;
    Text {
        text: root.label;
        font-size: 11.5px;
        color: Theme.text-secondary;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        font-size: root.value-size; font-weight: 800;
        color: root.value-color;
        vertical-alignment: center;
    }
}

export component TreasuryPage inherits VerticalLayout {
    in property <TreasurySummary> summary;
    in property <[TreasuryMovementRow]> movements;
    in property <[TreasuryChartBar]> chart;
    /// Detalhamento do dia, separado por sentido.
    in property <[TreasuryBreakdownRow]> breakdown-in;
    in property <[TreasuryBreakdownRow]> breakdown-out;
    in-out property <string> initial-input;
    in-out property <string> notes-input;
    in property <string> setup-error;
    callback refresh();
    callback open-treasury();

    // Índice da barra sob o cursor (-1 = nenhuma) — estado puramente
    // visual, vive na UI (§14).
    private property <int> chart-hovered: -1;
    // Geometria do mini-gráfico, reaproveitada para posicionar o card
    // flutuante sobre a barra correta.
    property <length> chart-x: root.width * 0.40;
    property <length> chart-w: root.width * 0.60 - 26px;
    property <length> chart-gap: 8px;
    property <length> chart-slot: (root.chart-w - root.chart-gap * 11) / 12;
    callback open-deposit();
    callback open-withdraw();
    callback open-goal();

    // Sem padding: a distância das paredes vem do wrapper (main.slint).
    padding: 0px;
    spacing: 16px;

    // ── Cabeçalho: título + filtro de período ──
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: "Carteira"; font-size: 22px; font-weight: 800; color: Theme.text-primary; }
            Text { text: "Gestão do dinheiro do estabelecimento"; font-size: 12px; color: Theme.text-secondary; }
        }
    }

    // ── Setup inicial (sem carteira cadastrada) ──
    if !root.summary.has-account: HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: start;
            padding-top: 32px;
            Panel {
                width: 520px;
                height: setup-l.preferred-height;
                setup-l := VerticalLayout {
                    padding: 24px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Image { width: 40px; height: 40px; image-fit: contain; source: @image-url("../assets/icons-orange/empty-wallet.svg"); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 2px;
                            Text { text: "Criar carteira do estabelecimento"; font-size: 16px; font-weight: 700; color: Theme.text-primary; }
                            Text { text: "Informe o saldo inicial. Entradas e saídas de Pedidos, Caixa, Financeiro e Fiados passam a compor o saldo."; font-size: 11px; color: Theme.text-secondary; wrap: word-wrap; }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "SALDO INICIAL"; font-size: 11px; font-weight: 700; color: Theme.text-secondary; letter-spacing: 0.5px; }
                        Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: initial-in.has-focus ? Theme.primary : Theme.border;
                            background: Theme.surface;
                            initial-in := TextInput {
                                x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                                text <=> root.initial-input;
                                font-size: 16px; font-weight: 700;
                                color: Theme.text-primary;
                                vertical-alignment: center; single-line: true;
                            }
                            if initial-in.text == "" && !initial-in.has-focus: Text {
                                x: 12px; y: 0; height: parent.height;
                                text: "0,00"; font-size: 16px; color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "OBSERVAÇÃO"; font-size: 11px; font-weight: 700; color: Theme.text-secondary; letter-spacing: 0.5px; }
                        Rectangle {
                            height: 64px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: notes-in.has-focus ? Theme.primary : Theme.border;
                            background: Theme.surface;
                            notes-in := TextInput {
                                x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                                text <=> root.notes-input;
                                font-size: 13px; color: Theme.text-primary;
                                wrap: word-wrap; single-line: false;
                            }
                            if notes-in.text == "" && !notes-in.has-focus: Text {
                                x: 12px; y: 8px;
                                text: "Anotações internas (opcional)";
                                font-size: 13px; color: Theme.text-secondary;
                            }
                        }
                    }
                    if root.setup-error != "": Text {
                        text: root.setup-error;
                        font-size: 12px; color: #C62828; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        ActionBtn {
                            label: "Criar Carteira";
                            bg-color: Theme.btn-accent;
                            icon: @image-url("../assets/icons/confirmar.svg");
                            width: 170px; height: 40px;
                            clicked => { root.open-treasury(); }
                        }
                    }
                }
            }
        }
    }

    // ── HERO: saldo + mini-gráfico + resumo do período ──
    if root.summary.has-account: Rectangle {
        height: 260px;
        border-radius: 16px;
        background: Theme.sidebar-bg;
        clip: true;

        // Mini-gráfico das últimas 12 horas, na metade direita do card.
        // Cada barra cresce a partir da linha central: para CIMA quando a
        // hora fechou positiva, para BAIXO quando fechou negativa.
        HorizontalLayout {
            x: root.chart-x;
            y: 22px;
            width: root.chart-w;
            height: 148px;
            spacing: root.chart-gap;
            for b[i] in root.chart: ChartBar {
                data: b;
                hovered: root.chart-hovered == i;
                hover(on) => {
                    if (on) {
                        root.chart-hovered = i;
                    } else if (root.chart-hovered == i) {
                        root.chart-hovered = -1;
                    }
                }
            }
        }

        // Card flutuante da barra sob o cursor. Fica DEPOIS das barras
        // para desenhar por cima; o x acompanha a coluna, preso às
        // bordas do card para não sair pela lateral.
        if root.chart-hovered >= 0: ChartTip {
            data: root.chart[root.chart-hovered];
            y: 30px;
            x: clamp(
                root.chart-x + root.chart-hovered * (root.chart-slot + root.chart-gap)
                    + root.chart-slot / 2 - self.width / 2,
                12px,
                root.width - self.width - 12px);
        }

        VerticalLayout {
            padding: 22px;
            spacing: 0px;

            // Saldo em destaque.
            Text {
                text: "SALDO ATUAL";
                font-size: 10px; font-weight: 800;
                letter-spacing: 1.4px;
                color: #A8A29A;
            }
            Rectangle { height: 6px; }
            HorizontalLayout {
                spacing: 0px;
                alignment: start;
                Text {
                    text: root.summary.balance-main;
                    font-size: 34px; font-weight: 800;
                    color: root.summary.balance-negative ? #FF8A80 : white;
                    vertical-alignment: bottom;
                }
                Text {
                    text: root.summary.balance-cents;
                    font-size: 18px; font-weight: 800;
                    color: root.summary.balance-negative ? #FF8A80 : #E6E3DC;
                    vertical-alignment: bottom;
                }
            }
            Text {
                text: "Inicial + entradas − saídas";
                font-size: 11px;
                color: #8F8A80;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
            Rectangle { height: 1px; background: #FFFFFF14; }
            Rectangle { height: 14px; }

            // Rodapé: entradas / saídas / saldo inicial + líquido.
            HorizontalLayout {
                spacing: 22px;
                // Entradas
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        MoneyIcon { tone: "pos"; box: 30px; on-dark: true; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: "ENTRADAS"; font-size: 9px; font-weight: 800; letter-spacing: 1px; color: #A8A29A; }
                        Text { text: root.summary.inflow-display; font-size: 14px; font-weight: 800; color: white; }
                    }
                }
                // Saídas
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        MoneyIcon { tone: "neg"; box: 30px; on-dark: true; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: "SAÍDAS"; font-size: 9px; font-weight: 800; letter-spacing: 1px; color: #A8A29A; }
                        Text { text: root.summary.outflow-display; font-size: 14px; font-weight: 800; color: white; }
                    }
                }
                // Saldo inicial
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        MoneyIcon { tone: "neutral"; box: 30px; on-dark: true; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text { text: "SALDO INICIAL"; font-size: 9px; font-weight: 800; letter-spacing: 1px; color: #A8A29A; }
                        Text { text: root.summary.initial-display; font-size: 14px; font-weight: 800; color: white; }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                // Resultado do período.
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.summary.net-label;
                        font-size: 9px; font-weight: 800; letter-spacing: 1px;
                        color: #A8A29A;
                        horizontal-alignment: right;
                    }
                    Text {
                        text: root.summary.net-display;
                        font-size: 15px; font-weight: 800;
                        color: root.summary.net-positive ? #7BD389 : #FF8A80;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    // ── Corpo: movimentações (esq.) + ações/meta/detalhamento (dir.) ──
    if root.summary.has-account: HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;

        // Movimentações
        Panel {
            horizontal-stretch: 3;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: "MOVIMENTAÇÕES";
                        font-size: 11px; font-weight: 800; letter-spacing: 1px;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Últimas 10";
                        font-size: 11px; color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                }

                if root.movements.length == 0: Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "Nenhuma movimentação registrada";
                            font-size: 13px; color: Theme.text-secondary;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.movements.length > 0: ScrollView {
                    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 6px;
                        for m in root.movements: Rectangle {
                            height: 54px;
                            border-radius: 10px;
                            background: mv-ta.has-hover ? Theme.row-hover : transparent;
                            mv-ta := TouchArea { }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 10px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    MoneyIcon { tone: m.tone; box: 30px; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: m.title;
                                        font-size: 12.5px; font-weight: 700;
                                        color: Theme.text-primary;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: m.source + " · " + m.time-display;
                                        font-size: 10.5px;
                                        color: Theme.text-secondary;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: m.amount-display;
                                        font-size: 13px; font-weight: 800;
                                        color: m.tone == "pos" ? #2E7D32 : #E53935;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Coluna direita
        VerticalLayout {
            horizontal-stretch: 2;
            spacing: 16px;
            alignment: start;

            // Ações: Depositar / Sacar
            Panel {
                height: 96px;
                HorizontalLayout {
                    padding: 14px;
                    spacing: 12px;
                    dep-ta := TouchArea {
                        horizontal-stretch: 1;
                        clicked => { root.open-deposit(); }
                        Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: dep-ta.has-hover ? #2E7D32 : #C8E6C9;
                            background: dep-ta.has-hover ? #DCEFDC : #EDF7ED;
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: center;
                                    AssetIcon {
                                        width: 18px; height: 18px; icon-size: 18px;
                                        icon-color: #2E7D32;
                                        source: @image-url("../assets/icons/entrada-estoque.svg");
                                    }
                                }
                                Text {
                                    text: "Depositar";
                                    font-size: 12.5px; font-weight: 700; color: #2E7D32;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                    wit-ta := TouchArea {
                        horizontal-stretch: 1;
                        clicked => { root.open-withdraw(); }
                        Rectangle {
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: wit-ta.has-hover ? #E53935 : #FFCDD2;
                            background: wit-ta.has-hover ? #FBE0E0 : #FDEFEF;
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                HorizontalLayout {
                                    alignment: center;
                                    AssetIcon {
                                        width: 18px; height: 18px; icon-size: 18px;
                                        icon-color: #E53935;
                                        source: @image-url("../assets/icons/saida-estoque.svg");
                                    }
                                }
                                Text {
                                    text: "Sacar";
                                    font-size: 12.5px; font-weight: 700; color: #E53935;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Meta de reserva do mês
            Panel {
                height: goal-l.preferred-height;
                goal-l := VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Meta de reserva do mês";
                            font-size: 13px; font-weight: 700;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        goal-ta := TouchArea {
                            width: 26px; height: 26px;
                            clicked => { root.open-goal(); }
                            Rectangle {
                                border-radius: 6px;
                                background: goal-ta.has-hover ? Theme.row-hover : transparent;
                                AssetIcon {
                                    width: 100%; height: 100%; icon-size: 13px;
                                    icon-color: goal-ta.has-hover ? Theme.btn-accent : Theme.text-secondary;
                                    source: @image-url("../assets/icons/editar.svg");
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.border;
                        Rectangle {
                            x: 0; y: 0;
                            width: parent.width * root.summary.goal-progress;
                            height: parent.height;
                            border-radius: 4px;
                            background: Theme.btn-accent;
                        }
                    }
                    Text {
                        text: root.summary.goal-display;
                        font-size: 11px; color: Theme.text-secondary;
                        overflow: elide;
                    }
                }
            }

            // Detalhamento por origem, agrupado por sentido.
            Panel {
                height: bd-l.preferred-height;
                bd-l := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "DETALHAMENTO";
                            font-size: 11px; font-weight: 800; letter-spacing: 1px;
                            color: Theme.text-primary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Hoje";
                            font-size: 11px; color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }

                    // ── Entradas ──
                    BreakdownGroup {
                        label: "ENTRADAS";
                        total: "+ " + root.summary.inflow-display;
                    }
                    VerticalLayout {
                        spacing: 8px;
                        for r in root.breakdown-in: BreakdownRow { data: r; }
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    // ── Saídas ──
                    BreakdownGroup {
                        label: "SAÍDAS";
                        total: "− " + root.summary.outflow-display;
                        negative: true;
                    }
                    VerticalLayout {
                        spacing: 8px;
                        for r in root.breakdown-out: BreakdownRow { data: r; }
                    }

                    // ── Fechamento de conta ──
                    Rectangle { height: 2px; }
                    Rectangle { height: 1px; background: Theme.border; }
                    Rectangle { height: 2px; }
                    TotalLine {
                        label: "Saldo inicial";
                        value: root.summary.initial-display;
                    }
                    TotalLine {
                        label: root.summary.net-label;
                        value: root.summary.net-display;
                        value-color: root.summary.net-positive ? #2E7D32 : #C62828;
                    }
                    Rectangle {
                        height: 46px;
                        border-radius: 10px;
                        background: root.summary.balance-negative ? #FDEFEF : #EDF7ED;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            TotalLine {
                                label: "SALDO ATUAL";
                                value: root.summary.balance-display;
                                value-size: 16px;
                                value-color: root.summary.balance-negative ? #C62828 : #2E7D32;
                            }
                        }
                    }
                }
            }
        }
    }
}
