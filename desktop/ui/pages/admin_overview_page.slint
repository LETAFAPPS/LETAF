// Painel do super admin — Dashboard (visão geral cross-tenant).
// UI sem lógica (§1/§3): todos os números/séries vêm prontos do Rust
// (ui/admin), que os busca online em GET /admin/overview. Aqui só renderiza.
import { Theme } from "../theme.slint";
import { AdminRevenuePoint } from "../types.slint";

// ── Cores dos status (reaproveitadas nas quebras) ──
// active=verde, overdue=laranja, cancelled=vermelho, inactive=cinza.
global Palette {
    out property <color> active: #2E7D32;
    out property <color> overdue: #E65100;
    out property <color> cancelled: #C62828;
    out property <color> inactive: #9E9E9E;
    out property <color> company-on: #1E88E5;
    out property <color> company-off: #BDBDBD;
    // Ano anterior no gráfico (cinza neutro); ano atual = destaque.
    out property <color> prev-year: #C7CAD1;
}

// Card de KPI (número grande + rótulo). `accent` pinta em destaque.
component KpiCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> accent: false;
    horizontal-stretch: 1;
    // `min-width: 0` para a largura ser dividida igualmente entre os cards
    // (sem isso, o texto mais largo faz o card ficar maior que os demais).
    min-width: 0;
    height: 104px;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.accent ? Theme.btn-accent : Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;
    VerticalLayout {
        padding: 18px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.value;
            font-size: root.accent ? 25px : 27px;
            font-weight: 800;
            color: root.accent ? Theme.btn-accent : Theme.text-primary;
            overflow: elide;
        }
        Text {
            text: root.label;
            font-size: 12.5px; color: Theme.text-secondary;
            overflow: elide;
        }
    }
}

// Painel branco com título e conteúdo livre (@children).
component Panel inherits Rectangle {
    in property <string> title;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;
    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        alignment: start;
        if root.title != "": Text {
            text: root.title;
            font-size: 13px; font-weight: 700; color: Theme.text-secondary;
        }
        @children
    }
}

// Item da quebra de status (bolinha + contagem + rótulo).
component StatusItem inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    in property <color> dot;
    spacing: 8px;
    Rectangle {
        width: 10px; height: 10px; border-radius: 5px;
        background: root.dot;
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: root.value;
        font-size: 14px; font-weight: 800; color: Theme.text-primary;
        vertical-alignment: center;
    }
    Text {
        text: root.label;
        font-size: 13px; color: Theme.text-secondary;
        vertical-alignment: center;
    }
}

// Um segmento da barra de proporção: retângulo de pontas arredondadas,
// largura ∝ valor (separado dos vizinhos pelo spacing do container).
component ProportionSegment inherits Rectangle {
    in property <int> value;
    in property <color> tone;
    horizontal-stretch: root.value * 1.0;
    border-radius: self.height / 2;
    background: root.tone;
}

// Uma barra do gráfico (com tooltip do valor ao passar o mouse).
component ChartBar inherits TouchArea {
    in property <float> value;
    in property <float> max-value;
    in property <string> amount;
    in property <color> tone;
    in property <length> plot-height;
    horizontal-stretch: 1;
    height: root.max-value > 0
        ? max(3px, (root.plot-height - 4px) * (root.value / root.max-value))
        : 3px;
    if self.has-hover && root.value > 0: Rectangle {
        y: -26px;
        width: tip.preferred-width + 14px;
        height: 22px;
        border-radius: 6px;
        background: Theme.text-primary;
        tip := Text {
            text: root.amount;
            color: Theme.surface;
            font-size: 10.5px; font-weight: 700;
            horizontal-alignment: center;
            width: parent.width;
        }
    }
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: 4px;
        background: root.has-hover ? root.tone.darker(0.15) : root.tone;
        animate background { duration: 120ms; }
    }
}

// Legenda de um ano (quadradinho colorido + rótulo).
component LegendItem inherits HorizontalLayout {
    in property <string> label;
    in property <color> tone;
    spacing: 6px;
    Rectangle {
        width: 12px; height: 12px; border-radius: 3px; background: root.tone;
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: root.label;
        font-size: 12px; color: Theme.text-secondary; vertical-alignment: center;
    }
}

// Gráfico de barras da receita mensal (jan–dez): ano atual × anterior.
component RevenueChart inherits VerticalLayout {
    in property <[AdminRevenuePoint]> points;
    in property <float> max-value;
    in property <int> year;
    in property <int> prev-year;
    property <length> plot-height: 170px;

    spacing: 10px;

    // Legenda dos anos.
    HorizontalLayout {
        spacing: 18px;
        alignment: end;
        LegendItem { label: "\{root.prev-year}"; tone: Palette.prev-year; }
        LegendItem { label: "\{root.year}"; tone: Theme.btn-accent; }
    }

    // Barras: um grupo por mês (ano anterior + ano atual lado a lado).
    HorizontalLayout {
        height: root.plot-height;
        spacing: 8px;
        for p in root.points: VerticalLayout {
            horizontal-stretch: 1;
            alignment: end;
            HorizontalLayout {
                spacing: 3px;
                alignment: center;
                ChartBar {
                    value: p.previous;
                    max-value: root.max-value;
                    amount: "\{root.prev-year}: " + p.previous-amount;
                    tone: Palette.prev-year;
                    plot-height: root.plot-height;
                }
                ChartBar {
                    value: p.current;
                    max-value: root.max-value;
                    amount: "\{root.year}: " + p.current-amount;
                    tone: Theme.btn-accent;
                    plot-height: root.plot-height;
                }
            }
        }
    }
    // Rótulos dos meses.
    HorizontalLayout {
        spacing: 8px;
        for p in root.points: Text {
            horizontal-stretch: 1;
            text: p.label;
            font-size: 10px; color: Theme.text-secondary;
            horizontal-alignment: center;
        }
    }
}

export component AdminOverviewPage inherits VerticalLayout {
    in property <int> companies;
    in property <int> active-companies;
    in property <int> suspended-companies;
    in property <int> active-subs;
    in property <int> overdue-subs;
    in property <int> cancelled-subs;
    in property <int> inactive-subs;
    in property <int> referrals;
    in property <string> mrr: "R$ 0,00";
    in property <string> annual-revenue: "R$ 0,00";
    in property <string> arpa: "R$ 0,00";
    in property <string> top-plan: "—";
    in property <int> current-year;
    in property <int> prev-year;
    in property <float> revenue-max;
    in property <[AdminRevenuePoint]> revenue-points;

    spacing: 16px;

    // Cabeçalho.
    VerticalLayout {
        spacing: 2px;
        Text {
            text: "Dashboard";
            font-size: 20px; font-weight: 800; color: Theme.text-primary;
        }
        Text {
            text: "Visão geral de todas as empresas do sistema.";
            font-size: 13px; color: Theme.text-secondary;
        }
    }

    // Linha primária de KPIs (4 cards de mesma largura e altura).
    // Ordem: Receita Mensal · Ticket Médio · Empresas · Receita Anual.
    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 16px;
        KpiCard { label: "Receita Mensal"; value: root.mrr; accent: true; }
        KpiCard { label: "Ticket Médio"; value: root.arpa; }
        KpiCard { label: "Empresas"; value: "\{root.companies}"; }
        KpiCard { label: "Receita Anual"; value: root.annual-revenue; }
    }

    // Gráfico de receita anual (jan–dez, ano atual × anterior).
    // `vertical-stretch: 0` → o card ajusta à altura do conteúdo, deixando o
    // espaçamento de baixo igual ao de cima (padding simétrico do painel).
    Panel {
        vertical-stretch: 0;
        RevenueChart {
            points: root.revenue-points;
            max-value: root.revenue-max;
            year: root.current-year;
            prev-year: root.prev-year;
        }
    }

    // Quebras: assinaturas × empresas + indicações à direita.
    // Todos no mesmo HorizontalLayout → mesma altura (o mais alto define).
    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 16px;

        // Assinaturas por status.
        Panel {
            horizontal-stretch: 2;
            title: "Assinaturas";
            HorizontalLayout {
                spacing: 28px;
                alignment: start;
                StatusItem { label: "Ativas"; value: root.active-subs; dot: Palette.active; }
                StatusItem { label: "Vencidas"; value: root.overdue-subs; dot: Palette.overdue; }
                StatusItem { label: "Canceladas"; value: root.cancelled-subs; dot: Palette.cancelled; }
                StatusItem { label: "Inativas"; value: root.inactive-subs; dot: Palette.inactive; }
            }
            // Barra de proporção: um retângulo arredondado por status,
            // separados entre si (status zerados são omitidos).
            HorizontalLayout {
                height: 10px;
                spacing: 5px;
                if root.active-subs > 0: ProportionSegment { value: root.active-subs; tone: Palette.active; }
                if root.overdue-subs > 0: ProportionSegment { value: root.overdue-subs; tone: Palette.overdue; }
                if root.cancelled-subs > 0: ProportionSegment { value: root.cancelled-subs; tone: Palette.cancelled; }
                if root.inactive-subs > 0: ProportionSegment { value: root.inactive-subs; tone: Palette.inactive; }
            }
        }

        // Empresas: ativas × suspensas.
        Panel {
            horizontal-stretch: 1.4;
            title: "Empresas";
            HorizontalLayout {
                spacing: 28px;
                alignment: start;
                StatusItem { label: "Ativas"; value: root.active-companies; dot: Palette.company-on; }
                StatusItem { label: "Suspensas"; value: root.suspended-companies; dot: Palette.company-off; }
            }
            HorizontalLayout {
                height: 10px;
                spacing: 5px;
                if root.active-companies > 0: ProportionSegment { value: root.active-companies; tone: Palette.company-on; }
                if root.suspended-companies > 0: ProportionSegment { value: root.suspended-companies; tone: Palette.company-off; }
            }
        }

        // Indicações (funcionalidade futura) — à direita.
        Panel {
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Indicações";
                    font-size: 13px; font-weight: 700; color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: eb.preferred-width + 14px; height: 18px;
                    border-radius: 9px;
                    background: Theme.btn-accent.transparentize(0.85);
                    eb := Text {
                        text: "Em breve";
                        font-size: 10px; font-weight: 700; color: Theme.btn-accent;
                        x: 7px; vertical-alignment: center;
                    }
                }
            }
            Text {
                text: "\{root.referrals}";
                font-size: 24px; font-weight: 800; color: Theme.text-primary;
            }
        }
    }

    // Absorve o espaço livre para os cards ficarem no topo (sem esticar).
    Rectangle { vertical-stretch: 1; }
}
