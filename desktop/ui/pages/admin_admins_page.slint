// Painel do super admin — Usuários (administradores). Mesma estrutura da tela
// de Empresas: toolbar (busca + "+") num card e UM CARD POR USUÁRIO; o
// cadastro/edição vive num MODAL. UI sem lógica (§1/§3).
import { Theme } from "../theme.slint";
import { AdminUserRow } from "../types.slint";
import { EmptyState } from "../components/empty_state.slint";
import { ListSearchBox, ListAddBtn } from "../components/list_toolbar.slint";
import { AssetIcon } from "../components/icons.slint";

// Botão de ação só-ícone (editar / excluir) — mesmo estilo da tela Empresas.
component IconActionBtn inherits TouchArea {
    in property <image> icon;
    in property <color> hover-color;
    in property <color> hover-bg;
    width: 30px; height: 30px;
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: 6px;
        background: root.has-hover ? root.hover-bg : transparent;
        AssetIcon {
            width: parent.width; height: parent.height; icon-size: 16px;
            icon-color: root.has-hover ? root.hover-color : Theme.text-secondary;
            source: root.icon;
        }
    }
}

// Interruptor liga/desliga (ativa/desativa o acesso do usuário).
component ToggleSwitch inherits TouchArea {
    in property <bool> on;
    width: 46px; height: 26px;
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: self.height / 2;
        background: root.on ? #1E88E5 : #BDBDBD;
        animate background { duration: 120ms; }
        Rectangle {
            width: 20px; height: 20px; border-radius: 10px;
            background: white;
            x: root.on ? parent.width - self.width - 3px : 3px;
            y: (parent.height - self.height) / 2;
            animate x { duration: 120ms; }
        }
    }
}

// Card de UM usuário na lista.
component UserCard inherits Rectangle {
    in property <AdminUserRow> u;
    // `true` = super admin master (só edição — sem toggle nem excluir).
    property <bool> is-master: root.u.role-id == "";
    callback edit();
    callback remove();
    callback toggle-active();

    height: 72px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;

    HorizontalLayout {
        padding-left: 14px; padding-right: 14px;
        spacing: 12px;

        // Avatar do perfil (foto se houver; senão ícone cinza).
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px; height: 44px;
                border-radius: 12px;
                background: #9E9E9E1F;
                clip: true;
                AssetIcon {
                    width: parent.width; height: parent.height; icon-size: 22px;
                    icon-color: Theme.text-secondary;
                    source: @image-url("../assets/icons/usuario.svg");
                }
                Image {
                    source: root.u.avatar;
                    width: parent.width; height: parent.height;
                    image-fit: cover;
                }
            }
        }

        // Nome + e-mail (+ função / master).
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.u.name;
                font-size: 14px; font-weight: 700;
                color: root.u.active ? Theme.text-primary : Theme.text-secondary;
                overflow: elide;
            }
            Text {
                text: root.is-master ? "Super Admin" : (root.u.role-name == "" ? "Sem função" : root.u.role-name);
                font-size: 12px; color: Theme.text-secondary; overflow: elide;
            }
        }

        // Ativo/inativo (só para não-master).
        if !root.is-master: VerticalLayout {
            alignment: center;
            ToggleSwitch {
                on: root.u.active;
                clicked => { root.toggle-active(); }
            }
        }
        Rectangle { width: 8px; }
        // Editar (sempre).
        VerticalLayout {
            alignment: center;
            IconActionBtn {
                icon: @image-url("../assets/icons/editar.svg");
                hover-color: Theme.btn-accent;
                hover-bg: Theme.row-hover;
                clicked => { root.edit(); }
            }
        }
        // Excluir (só para não-master; o master é gerido só no DB).
        if !root.is-master: VerticalLayout {
            alignment: center;
            IconActionBtn {
                icon: @image-url("../assets/icons/lixeira.svg");
                hover-color: Theme.danger;
                hover-bg: #FFEBEE;
                clicked => { root.remove(); }
            }
        }
    }
}

export component AdminAdminsPage inherits VerticalLayout {
    in property <[AdminUserRow]> users;
    in-out property <string> search;
    callback new-user();
    callback edit-user(string);
    // Exclusão pede confirmação: passa (id, nome) para o modal.
    callback delete-user(string, string);
    // Ativa/desativa o acesso do usuário (id, novo-estado).
    callback set-user-active(string, bool);
    callback filters-changed();

    spacing: 12px;

    // Cabeçalho.
    VerticalLayout {
        spacing: 2px;
        Text { text: "Usuários"; font-size: 20px; font-weight: 800; color: Theme.text-primary; }
        Text {
            text: "Gerencie os acessos de administradores.";
            font-size: 13px; color: Theme.text-secondary;
        }
    }

    // Toolbar: busca + adicionar (mesmo estilo da tela de Empresas).
    Rectangle {
        height: 56px;
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 0px;
        drop-shadow-color: Theme.card-shadow;
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                ListSearchBox {
                    value <=> root.search;
                    placeholder: "Buscar por nome ou e-mail...";
                    changed => { root.filters-changed(); }
                }
            }
            VerticalLayout {
                alignment: center;
                ListAddBtn { clicked => { root.new-user(); } }
            }
        }
    }

    // Empty state centralizado no espaço livre.
    if root.users.length == 0: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            EmptyState {
                source: @image-url("../assets/empty/virtual-assistant.svg");
                title: "Nenhum administrador";
            }
        }
    }

    // Lista: UM CARD POR USUÁRIO.
    if root.users.length > 0: Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: cards.preferred-height;
        cards := VerticalLayout {
            spacing: 10px;
            alignment: start;
            // Folga p/ a sombra dos cards não ser recortada pelo Flickable.
            padding-left: 14px; padding-right: 14px;
            padding-top: 14px; padding-bottom: 14px;
            for u in root.users: UserCard {
                u: u;
                edit => { root.edit-user(u.id); }
                remove => { root.delete-user(u.id, u.name); }
                toggle-active => { root.set-user-active(u.id, !u.active); }
            }
        }
    }
}
