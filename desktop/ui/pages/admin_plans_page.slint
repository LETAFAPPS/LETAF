// Painel do super admin — Planos (catálogo). Mesma estrutura da tela de
// Empresas: toolbar (busca + "+") num card e UM CARD POR PLANO; o cadastro/
// edição vive num MODAL. UI sem lógica (§1/§3): lista/salvar delegam ao Rust.
import { Theme } from "../theme.slint";
import { AdminPlanRow } from "../types.slint";
import { EmptyState } from "../components/empty_state.slint";
import { ListSearchBox, ListAddBtn } from "../components/list_toolbar.slint";
import { AssetIcon } from "../components/icons.slint";

// Botão de ação só-ícone (editar / excluir) — mesmo estilo da tela Empresas.
component IconActionBtn inherits TouchArea {
    in property <image> icon;
    in property <color> hover-color;
    in property <color> hover-bg;
    width: 30px; height: 30px;
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: 6px;
        background: root.has-hover ? root.hover-bg : transparent;
        AssetIcon {
            width: parent.width; height: parent.height; icon-size: 16px;
            icon-color: root.has-hover ? root.hover-color : Theme.text-secondary;
            source: root.icon;
        }
    }
}

// Card de UM plano na lista.
component PlanCard inherits Rectangle {
    in property <AdminPlanRow> p;
    callback edit();
    callback remove();

    height: 84px;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;

    HorizontalLayout {
        padding-left: 16px; padding-right: 14px;
        spacing: 12px;

        // Identificação: nome (+ selo/inativo) + valores.
        VerticalLayout {
            horizontal-stretch: 2;
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.p.name;
                    font-size: 14px; font-weight: 700; color: Theme.text-primary;
                    overflow: elide; vertical-alignment: center; height: 20px;
                }
                if root.p.highlight-label != "": Rectangle {
                    width: hl.preferred-width + 12px; height: 18px; border-radius: 9px;
                    background: Theme.sidebar-sel-bg;
                    y: (parent.height - self.height) / 2;
                    hl := Text {
                        x: 6px; text: root.p.highlight-label; font-size: 9px; font-weight: 700;
                        color: white; vertical-alignment: center;
                    }
                }
                if !root.p.active: Rectangle {
                    width: inat.preferred-width + 12px; height: 18px; border-radius: 5px;
                    background: Theme.danger.transparentize(0.85);
                    y: (parent.height - self.height) / 2;
                    inat := Text {
                        text: "Inativo"; font-size: 10px; font-weight: 700; color: Theme.danger;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                }
            }
            Text {
                text: root.p.amount-display + " a cada " + root.p.period-months
                    + (root.p.period-months == 1 ? " mês" : " meses") + " · " + root.p.monthly-display
                    + (root.p.trial-days > 0 ? " · " + root.p.trial-days + " dias grátis" : "");
                font-size: 11.5px; color: Theme.text-secondary; overflow: elide;
            }
        }

        // Uso do plano (empresas usando).
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.p.companies == 0 ? "Nenhuma empresa usa este plano"
                    : (root.p.companies == 1 ? "1 empresa usa este plano"
                        : root.p.companies + " empresas usam este plano");
                font-size: 11.5px; font-weight: root.p.companies > 0 ? 700 : 400;
                color: root.p.companies > 0 ? Theme.btn-accent : Theme.text-secondary;
                horizontal-alignment: center; overflow: elide;
            }
        }

        // Ações: editar + excluir (só-ícone, estilo Empresas).
        VerticalLayout {
            alignment: center;
            IconActionBtn {
                icon: @image-url("../assets/icons/1.2/editar.svg");
                hover-color: Theme.btn-accent;
                hover-bg: Theme.row-hover;
                clicked => { root.edit(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconActionBtn {
                icon: @image-url("../assets/icons/1.2/lixeira.svg");
                hover-color: Theme.danger;
                hover-bg: #FFEBEE;
                clicked => { root.remove(); }
            }
        }
    }
}

export component AdminPlansPage inherits VerticalLayout {
    in property <[AdminPlanRow]> plans;
    in-out property <string> search;
    callback new-plan();
    callback edit-plan(string);
    callback delete-plan(string);
    callback filters-changed();

    spacing: 12px;

    // Cabeçalho.
    VerticalLayout {
        spacing: 2px;
        Text { text: "Planos"; font-size: 20px; font-weight: 800; color: Theme.text-primary; }
        Text {
            text: "Catálogo de planos visível para a empresa.";
            font-size: 13px; color: Theme.text-secondary;
        }
    }

    // Toolbar: busca + adicionar (mesmo estilo da tela de Empresas).
    Rectangle {
        height: 56px;
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 0px;
        drop-shadow-color: Theme.card-shadow;
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                ListSearchBox {
                    value <=> root.search;
                    placeholder: "Buscar por nome do plano...";
                    changed => { root.filters-changed(); }
                }
            }
            VerticalLayout {
                alignment: center;
                ListAddBtn { clicked => { root.new-plan(); } }
            }
        }
    }

    // Empty state centralizado no espaço livre.
    if root.plans.length == 0: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            EmptyState {
                source: @image-url("../assets/empty/invoice.svg");
                title: "Nenhum plano";
                subtitle: "Cadastre os planos da plataforma";
            }
        }
    }

    // Lista: UM CARD POR PLANO.
    if root.plans.length > 0: Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: cards.preferred-height;
        cards := VerticalLayout {
            spacing: 10px;
            alignment: start;
            // Folga p/ a sombra dos cards não ser recortada pelo Flickable.
            padding-left: 14px; padding-right: 14px;
            padding-top: 14px; padding-bottom: 14px;
            for p in root.plans: PlanCard {
                p: p;
                edit => { root.edit-plan(p.id); }
                remove => { root.delete-plan(p.id); }
            }
        }
    }
}
