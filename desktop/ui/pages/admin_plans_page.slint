// Painel do super admin — Planos (catálogo). Vitrine em GRADE: um card
// por plano com preço em destaque, benefícios com "✓" e o total de
// assinantes no rodapé. O cadastro/edição vive num MODAL.
// UI sem lógica (§1/§3): lista/salvar delegam ao Rust.
import { Theme } from "../theme.slint";
import { AdminPlanRow } from "../types.slint";
import { EmptyState } from "../components/empty_state.slint";
import { AssetIcon } from "../components/icons.slint";

// Botão de ação só-ícone (editar / excluir) — mesmo estilo da tela Empresas.
component IconActionBtn inherits TouchArea {
    in property <image> icon;
    in property <color> hover-color;
    in property <color> hover-bg;
    width: 30px; height: 30px;
    Rectangle {
        width: parent.width; height: parent.height;
        border-radius: Theme.radius-sm;
        background: root.has-hover ? root.hover-bg : transparent;
        AssetIcon {
            width: parent.width; height: parent.height; icon-size: 16px;
            icon-color: root.has-hover ? root.hover-color : Theme.text-secondary;
            source: root.icon;
        }
    }
}

// Card de UM plano (vitrine).
component PlanCard inherits Rectangle {
    in property <AdminPlanRow> p;
    callback edit();
    callback remove();

    // Plano em destaque ganha a faixa superior na cor da marca.
    property <bool> featured: root.p.highlight-label != "";

    background: Theme.surface;
    border-radius: Theme.radius-2xl;
    border-width: 1px;
    border-color: root.featured ? Theme.btn-accent.transparentize(0.6) : Theme.card-border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: Theme.card-shadow;
    clip: true;

    // Faixa de destaque no topo do card "Popular".
    if root.featured: Rectangle {
        x: 0; y: 0;
        width: parent.width; height: 3px;
        background: Theme.btn-accent;
    }

    VerticalLayout {
        padding: 20px;
        padding-top: 22px;
        spacing: 0px;

        // Nome + selos (destaque / inativo).
        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: root.p.name;
                font-size: 15px; font-weight: 800;
                color: Theme.text-primary;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.p.highlight-label != "": Rectangle {
                width: hl.preferred-width + 16px; height: 20px;
                border-radius: Theme.radius-sm;
                background: Theme.btn-accent.transparentize(0.88);
                hl := Text {
                    width: parent.width; height: parent.height;
                    text: root.p.highlight-label;
                    font-size: 10px; font-weight: 700;
                    color: Theme.btn-accent;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            if !root.p.active: Rectangle {
                width: inat.preferred-width + 16px; height: 20px;
                border-radius: Theme.radius-sm;
                background: Theme.danger.transparentize(0.88);
                inat := Text {
                    width: parent.width; height: parent.height;
                    text: "Inativo";
                    font-size: 10px; font-weight: 700; color: Theme.danger;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 12px; }

        // Preço em destaque: valor grande + "/mês" discreto.
        HorizontalLayout {
            spacing: 2px;
            alignment: start;
            Text {
                text: root.p.monthly-value;
                font-size: 28px; font-weight: 800;
                color: Theme.text-primary;
                vertical-alignment: bottom;
            }
            Text {
                text: "/mês";
                font-size: 12px; font-weight: 600;
                color: Theme.text-secondary;
                vertical-alignment: bottom;
            }
        }
        Text {
            text: root.p.amount-display + " " + root.p.cycle-display;
            font-size: 10.5px;
            color: Theme.text-secondary;
            overflow: elide;
        }

        Rectangle { height: 14px; }

        // Benefícios (derivados da descrição, no Rust).
        VerticalLayout {
            spacing: 7px;
            for f in root.p.features: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    AssetIcon {
                        width: 12px; height: 12px; icon-size: 12px;
                        icon-color: Theme.btn-accent;
                        source: @image-url("../assets/icons/confirmar.svg");
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: f;
                    font-size: 12px;
                    color: Theme.text-primary;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        // Empurra o rodapé para a base — todos os cards da linha
        // terminam com o rodapé alinhado, independentemente do número
        // de benefícios.
        Rectangle { vertical-stretch: 1; background: transparent; min-height: 12px; }

        Rectangle { height: 1px; background: Theme.border; }
        Rectangle { height: 12px; }

        // Rodapé: assinantes + ações.
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;
                alignment: center;
                Text {
                    text: root.p.subscribers-display;
                    font-size: 14px; font-weight: 800;
                    color: Theme.text-primary;
                }
                Text {
                    text: root.p.companies == 1 ? "assinante" : "assinantes";
                    font-size: 10.5px;
                    color: Theme.text-secondary;
                }
            }
            VerticalLayout {
                alignment: center;
                IconActionBtn {
                    icon: @image-url("../assets/icons/editar.svg");
                    hover-color: Theme.btn-accent;
                    hover-bg: Theme.row-hover;
                    clicked => { root.edit(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconActionBtn {
                    icon: @image-url("../assets/icons/lixeira.svg");
                    hover-color: Theme.danger;
                    hover-bg: #FFEBEE;
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

// Célula da grade: mantém a largura da coluna mesmo quando vazia
// (a última linha pode ter 1 ou 2 planos).
component PlanCell inherits Rectangle {
    in property <bool> filled;
    in property <AdminPlanRow> p;
    callback edit();
    callback remove();
    horizontal-stretch: 1;
    preferred-width: 0px;
    background: transparent;
    if root.filled: PlanCard {
        width: parent.width; height: parent.height;
        p: root.p;
        edit => { root.edit(); }
        remove => { root.remove(); }
    }
}

export component AdminPlansPage inherits VerticalLayout {
    in property <[AdminPlanRow]> plans;
    in-out property <string> search;
    callback new-plan();
    callback edit-plan(string);
    // Exclusão pede confirmação: passa (id, nome) para o modal.
    callback delete-plan(string, string);
    callback filters-changed();

    // 3 planos por linha; a última linha completa com células vazias.
    property <int> per-row: 3;
    property <int> row-count: (root.plans.length + root.per-row - 1) / root.per-row;

    spacing: 16px;

    // Cabeçalho: título à esquerda, "Novo Plano" à direita.
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: "Planos"; font-size: 20px; font-weight: 800; color: Theme.text-primary; }
            Text {
                text: "Gestão de planos de assinatura";
                font-size: 13px; color: Theme.text-secondary;
            }
        }
        VerticalLayout {
            alignment: center;
            new-ta := TouchArea {
                width: 148px; height: 40px;
                clicked => { root.new-plan(); }
                Rectangle {
                    border-radius: Theme.radius-xl;
                    background: new-ta.has-hover ? Theme.btn-accent.darker(0.12) : Theme.btn-accent;
                    HorizontalLayout {
                        alignment: center; spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            AssetIcon {
                                width: 14px; height: 14px; icon-size: 14px;
                                icon-color: white;
                                source: @image-url("../assets/icons/adicionar.svg");
                            }
                        }
                        Text {
                            text: "Novo Plano";
                            font-size: 13px; font-weight: 700; color: white;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Empty state centralizado no espaço livre.
    if root.plans.length == 0: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center;
            EmptyState {
                source: @image-url("../assets/illustrations/finance-management.svg");
                art-size: 380px;
                title: "Nenhum plano";
                subtitle: "Cadastre os planos da plataforma";
            }
        }
    }

    // Vitrine: grade de 3 cards por linha.
    if root.plans.length > 0: Flickable {
        vertical-stretch: 1;
        viewport-width: self.width;
        viewport-height: grid.preferred-height;
        grid := VerticalLayout {
            spacing: 18px;
            alignment: start;
            // Folga p/ a sombra dos cards não ser recortada pelo Flickable.
            padding-left: 6px; padding-right: 6px;
            padding-top: 6px; padding-bottom: 14px;
            for row-idx in root.row-count: HorizontalLayout {
                spacing: 18px;
                height: 268px;
                PlanCell {
                    filled: row-idx * 3 < root.plans.length;
                    p: root.plans[row-idx * 3];
                    edit => { root.edit-plan(root.plans[row-idx * 3].id); }
                    remove => { root.delete-plan(root.plans[row-idx * 3].id, root.plans[row-idx * 3].name); }
                }
                PlanCell {
                    filled: row-idx * 3 + 1 < root.plans.length;
                    p: root.plans[row-idx * 3 + 1];
                    edit => { root.edit-plan(root.plans[row-idx * 3 + 1].id); }
                    remove => { root.delete-plan(root.plans[row-idx * 3 + 1].id, root.plans[row-idx * 3 + 1].name); }
                }
                PlanCell {
                    filled: row-idx * 3 + 2 < root.plans.length;
                    p: root.plans[row-idx * 3 + 2];
                    edit => { root.edit-plan(root.plans[row-idx * 3 + 2].id); }
                    remove => { root.delete-plan(root.plans[row-idx * 3 + 2].id, root.plans[row-idx * 3 + 2].name); }
                }
            }
        }
    }
}
