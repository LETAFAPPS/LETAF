// Detalhe da empresa (painel do super admin) — cabeçalho + "Gerenciar".
// UI sem lógica (§1/§3): tudo vem pronto de GET /admin/companies/{id}.
// O detalhe é enxuto: identidade + acesso + entrar na empresa. TODA a gestão
// (produtos, planos, configurações) acontece via "Gerenciar" (impersonation).
import { Theme } from "../theme.slint";
import { AdminCompanyDetail, AdminCompanyOrderRow } from "../types.slint";
import { ModalShell } from "../components/modal_shell.slint";
import { AssetIcon } from "../components/icons.slint";

export component AdminCompanyDetailModal inherits Rectangle {
    in property <AdminCompanyDetail> data;
    // Mantido para compatibilidade com o binding do main.slint (não exibido).
    in property <[AdminCompanyOrderRow]> orders;
    callback close();
    // "Gerenciar empresa": super admin entra na empresa (impersonation).
    callback manage();

    width: 100%;
    height: 100%;

    ModalShell {
        width: 100%;
        height: 100%;
        card-width: 440px;
        close => { root.close(); }

        VerticalLayout {
            spacing: 16px;

            // ── Cabeçalho: logo + nome + domínio completo (perto do nome) ──
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 68px; height: 68px;
                        border-radius: 16px;
                        background: Theme.btn-accent.transparentize(0.88);
                        clip: true;
                        AssetIcon {
                            width: parent.width; height: parent.height; icon-size: 30px;
                            icon-color: Theme.btn-accent;
                            source: @image-url("../assets/icons/empresa.svg");
                        }
                        Image {
                            source: root.data.logo;
                            width: parent.width; height: parent.height;
                            image-fit: cover;
                        }
                    }
                }
                Text {
                    text: root.data.name;
                    font-size: 18px; font-weight: 800; color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.data.domain;
                    font-size: 12.5px; color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
            }

            // ── Situação do acesso ──
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: badge.preferred-width + 16px; height: 22px;
                    border-radius: 6px;
                    background: root.data.active
                        ? #2E7D3222
                        : Theme.danger.transparentize(0.85);
                    badge := Text {
                        text: root.data.active ? "Acesso Ativo" : "Acesso Suspenso";
                        font-size: 11px; font-weight: 700;
                        color: root.data.active ? Theme.success : Theme.danger;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                }
            }

            // ── Gerenciar: entra na empresa (telas reais do ERP) ──
            manage-ta := TouchArea {
                height: 40px;
                clicked => { root.manage(); }
                Rectangle {
                    width: parent.width; height: parent.height;
                    border-radius: 8px;
                    background: manage-ta.has-hover ? #1565C0 : #1E88E5;
                    Text {
                        text: "Gerenciar Empresa";
                        color: white; font-size: 13px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                }
            }
        }
    }
}
