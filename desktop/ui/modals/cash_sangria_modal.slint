import { Theme } from "../theme.slint";
import { ModalHeader } from "../components/modal_header.slint";
import { AssetIcon } from "../components/icons.slint";
import { Card } from "../components/cards.slint";
import { ActionBtn, OutlineBtn } from "../components/buttons.slint";

// ── Modal: sangria (retirada de dinheiro) ─────────────────────────

export component CashSangriaModal inherits Rectangle {
    in property <string> cash-now-display;
    in-out property <string> amount-input;
    in-out property <string> reason-selected;   // chip ativo
    in-out property <string> detail-input;

    callback close();
    callback confirm();

    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Card {
                width: 460px;
                TouchArea { }

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    ModalHeader {
                        icon: @image-url("../assets/icons-orange/online-earning.svg");
                        title: "Sangria de caixa";
                        subtitle: "Retirada de dinheiro do caixa · ex: pagamento de despesa";
                    }


                    // Saldo atual (banner laranja claro)
                    Rectangle {
                        background: #FFF3E0;
                        border-radius: 8px;
                        height: 56px;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;
                            Rectangle {
                                width: 32px; height: 32px;
                                border-radius: 6px;
                                background: Theme.btn-accent;
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: "↓"; font-size: 16px; font-weight: 700;
                                    color: white;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: "SAÍDA"; font-size: 10px; font-weight: 800; color: Theme.btn-accent; letter-spacing: 1px; }
                                Text {
                                    text: "Saldo Agora: " + root.cash-now-display;
                                    font-size: 12px; color: Theme.text-primary;
                                }
                            }
                        }
                    }

                    // Valor
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Valor"; font-size: 10px; font-weight: 700; color: Theme.text-secondary; letter-spacing: 1px; }
                        Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: amount-input.has-focus ? Theme.primary : Theme.border;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text {
                                    text: "−R$";
                                    font-size: 13px; font-weight: 600;
                                    color: Theme.btn-accent;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    amount-input := TextInput {
                                        x: 10px; y: 0;
                                        width: parent.width - 20px; height: parent.height;
                                        text <=> root.amount-input;
                                        font-size: 14px; font-weight: 600;
                                        color: Theme.btn-accent;
                                        vertical-alignment: center;
                                        single-line: true;
                                       
                                    }
                                    if root.amount-input == "": Text {
                                        x: 10px; y: 0;
                                        width: parent.width - 20px; height: parent.height;
                                        text: "0,00"; font-size: 14px; color: #BDBDBD;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            init-timer := Timer {
                                interval: 80ms; running: true;
                                triggered => { amount-input.focus(); self.running = false; }
                            }
                        }
                    }

                    // Motivo (chips)
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Motivo"; font-size: 10px; font-weight: 700; color: Theme.text-secondary; letter-spacing: 1px; }
                        HorizontalLayout {
                            spacing: 8px;
                            for opt[oi] in ["Depósito Bancário", "Despesa"]: ch-ta := TouchArea {
                                horizontal-stretch: 1; height: 32px;
                                clicked => { root.reason-selected = opt; }
                                Rectangle {
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.reason-selected == opt ? Theme.btn-accent : Theme.border;
                                    background: root.reason-selected == opt ? #FFF3E0 : (ch-ta.has-hover ? Theme.row-hover : Theme.surface);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: opt;
                                        font-size: 12px; font-weight: 600;
                                        color: root.reason-selected == opt ? Theme.btn-accent : Theme.text-primary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            for opt[oi] in ["Fornecedor", "Outro"]: ch2-ta := TouchArea {
                                horizontal-stretch: 1; height: 32px;
                                clicked => { root.reason-selected = opt; }
                                Rectangle {
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.reason-selected == opt ? Theme.btn-accent : Theme.border;
                                    background: root.reason-selected == opt ? #FFF3E0 : (ch2-ta.has-hover ? Theme.row-hover : Theme.surface);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: opt;
                                        font-size: 12px; font-weight: 600;
                                        color: root.reason-selected == opt ? Theme.btn-accent : Theme.text-primary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // Detalhe opcional
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Detalhes"; font-size: 10px; font-weight: 700; color: Theme.text-secondary; letter-spacing: 1px; }
                        Rectangle {
                            height: 36px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: detail-input.has-focus ? Theme.primary : Theme.border;
                            background: Theme.surface;
                            detail-input := TextInput {
                                x: 10px; y: 0;
                                width: parent.width - 20px; height: parent.height;
                                text <=> root.detail-input;
                                font-size: 12px; color: Theme.text-primary;
                                vertical-alignment: center;
                                single-line: true;
                            }
                            if root.detail-input == "": Text {
                                x: 10px; y: 0;
                                width: parent.width - 20px; height: parent.height;
                                text: "Ex: Banco do Brasil ag. 0001 · envelope #2204";
                                font-size: 12px; color: #BDBDBD;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        ActionBtn {
                            label: "Registrar Sangria";
                            bg-color: Theme.danger;
                            min-width: 160px; height: 40px;
                            clicked => { root.confirm(); }
                        }
                    }
                }
            }
        }
    }
}
