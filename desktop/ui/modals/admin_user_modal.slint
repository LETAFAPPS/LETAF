// Modal do super admin: cadastro/edição de um administrador (login).
// UI sem lógica (§1/§3): salvar delega ao Rust (POST/PUT /admin/admins).
import { Theme } from "../theme.slint";
import { FilterOption } from "../components/list_toolbar.slint";
import { FormField, PasswordField } from "../components/form_fields.slint";
import { OutlineBtn } from "../components/buttons.slint";
import { ModalShell } from "../components/modal_shell.slint";

export component AdminUserModal inherits Rectangle {
    in property <string> form-id;
    in-out property <string> form-name;
    in-out property <string> form-email;
    in-out property <string> form-password;
    // Função de administrador: opções (id→nome) + seleção ("" = master).
    in property <[FilterOption]> roles;
    in-out property <string> role-id;
    callback save();
    callback close();

    width: 100%;
    height: 100%;

    ModalShell {
        width: 100%;
        height: 100%;
        icon: @image-url("../assets/icons/1.2/customers.svg");
        icon-color: Theme.btn-accent;
        title: root.form-id == "" ? "Novo Administrador" : "Editar Administrador";
        message: "Gerencie os acessos de administradores.";
        card-width: 440px;
        close => { root.close(); }

        VerticalLayout {
            spacing: 12px;

            FormField {
                label: "Nome";
                value <=> root.form-name;
                placeholder: "Nome do administrador";
                icon: @image-url("../assets/icons/1.2/usuario.svg");
            }
            FormField {
                label: "E-mail";
                value <=> root.form-email;
                placeholder: "email@dominio.com";
                icon: @image-url("../assets/icons/1.2/email.svg");
            }
            PasswordField {
                label: "Senha";
                value <=> root.form-password;
                placeholder: root.form-id == "" ? "Defina uma senha" : "Deixe em branco para manter";
            }

            // Função: define quais telas do painel o usuário acessa.
            // "Master" (sem função) = acesso total.
            Text {
                text: "Função";
                font-size: 12.5px; font-weight: 600; color: Theme.text-secondary;
            }
            VerticalLayout {
                spacing: 6px;
                master := TouchArea {
                    height: 34px;
                    clicked => { root.role-id = ""; }
                    Rectangle {
                        border-radius: 8px;
                        border-width: root.role-id == "" ? 1.5px : 1px;
                        border-color: root.role-id == "" ? Theme.btn-accent : Theme.border;
                        background: root.role-id == "" ? Theme.btn-accent.transparentize(0.92)
                            : (master.has-hover ? Theme.row-hover : Theme.surface);
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            Text {
                                text: "Super Admin";
                                font-size: 13px; font-weight: root.role-id == "" ? 700 : 500;
                                color: root.role-id == "" ? Theme.btn-accent : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                for opt in root.roles: role-ta := TouchArea {
                    height: 34px;
                    clicked => { root.role-id = opt.key; }
                    Rectangle {
                        border-radius: 8px;
                        border-width: root.role-id == opt.key ? 1.5px : 1px;
                        border-color: root.role-id == opt.key ? Theme.btn-accent : Theme.border;
                        background: root.role-id == opt.key ? Theme.btn-accent.transparentize(0.92)
                            : (role-ta.has-hover ? Theme.row-hover : Theme.surface);
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            Text {
                                text: opt.label;
                                font-size: 13px; font-weight: root.role-id == opt.key ? 700 : 500;
                                color: root.role-id == opt.key ? Theme.btn-accent : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                padding-top: 2px;
                OutlineBtn {
                    label: "Salvar";
                    accent: true;
                    btn-color: Theme.btn-accent;
                    width: 130px; height: 40px;
                    clicked => { root.save(); }
                }
            }
        }
    }
}
