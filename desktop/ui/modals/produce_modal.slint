// Modal de PRODUÇÃO (recurso da "fábrica"): produzir N unidades do produto
// em edição — consome a ficha técnica e dá entrada no estoque. UI sem lógica
// (§1/§3): o "Produzir" delega ao Rust (ProductService::produce).
import { Theme } from "../theme.slint";
import { FormField } from "../components/form_fields.slint";
import { OutlineBtn } from "../components/buttons.slint";
import { ModalShell } from "../components/modal_shell.slint";

export component ProduceModal inherits Rectangle {
    in property <string> product-name;
    in-out property <string> form-quantity;
    in property <string> error;
    callback confirm();
    callback close();

    width: 100%;
    height: 100%;

    ModalShell {
        width: 100%;
        height: 100%;
        colored-icon: @image-url("../assets/icons-orange/data-configuration.svg");
        title: "Produzir";
        message: "Dá entrada no estoque de \"" + root.product-name + "\" e consome os insumos da ficha técnica.";
        card-width: 420px;
        close => { root.close(); }

        VerticalLayout {
            spacing: 12px;
            FormField {
                label: "Quantidade a produzir";
                value <=> root.form-quantity;
                placeholder: "Ex.: 10";
            }
            if root.error != "": Text {
                text: root.error;
                font-size: Theme.fs-caption; color: Theme.danger; wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                padding-top: 2px;
                OutlineBtn {
                    label: "Produzir";
                    accent: true;
                    btn-color: Theme.btn-accent;
                    width: 140px; height: 40px;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
