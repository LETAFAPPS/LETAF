import { Theme } from "../theme.slint";
import { ModalHeader } from "../components/modal_header.slint";
import { AssetIcon } from "../components/icons.slint";
import { Card } from "../components/cards.slint";
import { ActionBtn, OutlineBtn } from "../components/buttons.slint";

// ── Modal: ajuste de estoque ────────────────────────────────────────
//
// Dois modos controlados por `mode`:
// - "add":     ajuste manual. Um seletor Adicionar/Retirar (`direction`
//              = "in"/"out") define o sinal; a quantidade digitada é sempre
//              positiva e o Rust aplica o sinal (delta = ±qty).
// - "consume": consumo de funcionário — baixa `qty` com reason "consumo".
//
// AI_RULES §1/§14: UI só dispara `confirm`; o Rust valida e persiste.

export component StockAdjustModal inherits Rectangle {
    in property <string> mode;              // "add" | "consume"
    in-out property <string> direction;     // modo "add": "in" | "out"
    in property <string> product-name;
    in property <string> current-display;   // "5 un" / "1,250 kg"
    in-out property <string> qty-input;
    in-out property <string> reason-input;
    in property <string> error-message;

    callback close();
    callback confirm();

    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Card {
                width: 440px;
                TouchArea { }

                VerticalLayout {
                    padding: 22px;
                    spacing: 16px;

                    ModalHeader {
                        icon: @image-url("../assets/icons-orange/data-management.svg");
                        title: root.mode == "consume" ? "Registrar Consumo" : "Ajustar Estoque";
                        subtitle: root.product-name;
                    }

                    // Atual
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Estoque Atual:"; font-size: 12px; color: Theme.text-secondary; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: root.current-display; font-size: 14px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                    }

                    // Seletor Adicionar / Retirar (só no modo "add"). Estilo
                    // segmented: trilho cinza + pill colorida na opção ativa.
                    if root.mode == "add": Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: #F1ECE4;
                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;
                            in-ta := TouchArea {
                                clicked => { root.direction = "in"; }
                                Rectangle {
                                    border-radius: Theme.radius-sm;
                                    background: root.direction == "in" ? Theme.success : transparent;
                                    Text {
                                        text: "Adicionar";
                                        font-size: 13px; font-weight: 700;
                                        color: root.direction == "in" ? white : Theme.text-secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            out-ta := TouchArea {
                                clicked => { root.direction = "out"; }
                                Rectangle {
                                    border-radius: Theme.radius-sm;
                                    background: root.direction == "out" ? Theme.danger : transparent;
                                    Text {
                                        text: "Retirar";
                                        font-size: 13px; font-weight: 700;
                                        color: root.direction == "out" ? white : Theme.text-secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Campo quantidade
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: root.mode == "consume" ? "QUANTIDADE CONSUMIDA" : "QUANTIDADE";
                            font-size: 10px; font-weight: 700; color: Theme.text-secondary; letter-spacing: 1px;
                        }
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: qty-input.has-focus ? Theme.primary : Theme.border;
                            background: Theme.surface;
                            qty-input := TextInput {
                                x: 10px; y: 0;
                                width: parent.width - 20px; height: parent.height;
                                text <=> root.qty-input;
                                font-size: 14px; font-weight: 600; color: Theme.text-primary;
                                vertical-alignment: center;
                                single-line: true;
                               
                            }
                            if root.qty-input == "": Text {
                                x: 10px; y: 0;
                                width: parent.width - 20px; height: parent.height;
                                text: root.mode == "consume" ? "Ex.: 2" : "Ex.: 12";
                                font-size: 14px; color: #BDBDBD;
                                vertical-alignment: center;
                            }
                            init-timer := Timer {
                                interval: 80ms; running: true;
                                triggered => { qty-input.focus(); self.running = false; }
                            }
                        }
                    }

                    // Motivo (opcional)
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "MOTIVO (OPCIONAL)"; font-size: 10px; font-weight: 700; color: Theme.text-secondary; letter-spacing: 1px; }
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: reason-input.has-focus ? Theme.primary : Theme.border;
                            background: Theme.surface;
                            reason-input := TextInput {
                                x: 10px; y: 0;
                                width: parent.width - 20px; height: parent.height;
                                text <=> root.reason-input;
                                font-size: 12px; color: Theme.text-primary;
                                vertical-alignment: center;
                                single-line: true;
                            }
                            if root.reason-input == "": Text {
                                x: 10px; y: 0;
                                width: parent.width - 20px; height: parent.height;
                                text: "Ex.: ajuste de inventário, recebimento de fornecedor...";
                                font-size: 12px; color: #BDBDBD;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Erro (se houver)
                    if root.error-message != "": Rectangle {
                        background: #FFEBEE;
                        border-radius: Theme.radius-sm;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: "⚠ " + root.error-message;
                                font-size: 12px; font-weight: 600; color: Theme.danger;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Botões
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        ActionBtn {
                            label: "Confirmar";
                            bg-color: Theme.btn-accent;
                            width: 130px; height: 32px;
                            clicked => { root.confirm(); }
                        }
                    }
                }
            }
        }
    }
}
