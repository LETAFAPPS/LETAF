import { Theme } from "../theme.slint";
import { ModalHeader } from "../components/modal_header.slint";
import { Card } from "../components/cards.slint";
import { ActionBtn } from "../components/buttons.slint";

// ── Modal: cadastrar cartão de crédito recorrente (INTRO) ────────────────
//
// Igual ao PIX Automático (AI_RULES §3/§11): é um modal NATIVO do sistema que
// INICIA o cadastro; a etapa SEGURA (dados do cartão) abre em seguida numa
// página da Efí (Efi.js). Motivo: a Efi só tokeniza no cliente — número/CVV
// NUNCA passam pelos nossos servidores. É o análogo à autorização do PIX
// Automático, que acontece no app do banco.
//
// UI sem lógica: só dispara `submit` (inicia a etapa segura) e `close`.

export component CardModal inherits Rectangle {
    // `true` enquanto abre a etapa segura (evita duplo clique).
    in property <bool> loading: false;
    callback close();
    callback submit();

    background: Theme.scrim;

    TouchArea {
        clicked => { root.close(); }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Card {
                width: 460px;
                TouchArea { }
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;

                    ModalHeader {
                        icon: @image-url("../assets/icons-orange/network-protection.svg");
                        title: "Cadastrar Cartão";
                    }

                    Text {
                        text: "Cobrança automática recorrente no cartão de crédito. Por segurança, os dados do cartão são preenchidos numa etapa protegida da Efí, o número e o CVV NÃO passam pelos nossos servidores.";
                        font-size: Theme.fs-caption; color: Theme.text-secondary; wrap: word-wrap;
                    }
                    Text {
                        text: "Ao continuar, abrimos a etapa segura de cadastro e aguardamos a confirmação aqui.";
                        font-size: Theme.fs-caption; color: Theme.text-secondary; wrap: word-wrap;
                    }

                    Rectangle { height: 4px; }

                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        ActionBtn {
                            label: root.loading ? "Abrindo…" : "Cadastrar Cartão";
                            bg-color: Theme.btn-accent;
                            width: 190px;
                            clicked => {
                                if !root.loading {
                                    root.submit();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
