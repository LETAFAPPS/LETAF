import { Theme } from "../theme.slint";
import { ModalHeader } from "../components/modal_header.slint";
import { AssetIcon } from "../components/icons.slint";
import { Card } from "../components/cards.slint";
import { ActionBtn, OutlineBtn } from "../components/buttons.slint";

// ── Modal: suprimento (entrada de dinheiro) ───────────────────────

export component CashSuprimentoModal inherits Rectangle {
    in property <string> cash-now-display;
    in-out property <string> amount-input;
    in-out property <string> origin-selected;
    in-out property <string> detail-input;

    callback close();
    callback confirm();

    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Card {
                width: 460px;
                TouchArea { }

                VerticalLayout {
                    padding: 24px;
                    spacing: 14px;

                    ModalHeader {
                        icon: @image-url("../assets/icons-orange/online-earning.svg");
                        title: "Suprimento de caixa";
                        subtitle: "Entrada de dinheiro no caixa · ex: reforço de troco";
                    }


                    // Saldo atual (banner azul)
                    Rectangle {
                        background: #E3F2FD;
                        border-radius: 8px;
                        height: 56px;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;
                            Rectangle {
                                width: 32px; height: 32px;
                                border-radius: Theme.radius-sm;
                                background: Theme.info;
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: "↑"; font-size: Theme.fs-section; font-weight: Theme.fw-bold;
                                    color: white;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; alignment: center; spacing: 2px;
                                Text { text: "ENTRADA"; font-size: Theme.fs-label; font-weight: Theme.fw-extrabold; color: Theme.info; letter-spacing: 1px; }
                                Text {
                                    text: "Saldo Agora: " + root.cash-now-display;
                                    font-size: Theme.fs-caption; color: Theme.text-primary;
                                }
                            }
                        }
                    }

                    // Valor
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Valor"; font-size: Theme.fs-label; font-weight: Theme.fw-bold; color: Theme.text-secondary; letter-spacing: 1px; }
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: amount-input.has-focus ? Theme.primary : Theme.border;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text {
                                    text: "+R$";
                                    font-size: Theme.fs-13; font-weight: Theme.fw-strong;
                                    color: Theme.info;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    amount-input := TextInput {
                                        x: 10px; y: 0;
                                        width: parent.width - 20px; height: parent.height;
                                        text <=> root.amount-input;
                                        font-size: Theme.fs-body; font-weight: Theme.fw-strong;
                                        color: Theme.info;
                                        vertical-alignment: center;
                                        single-line: true;
                                       
                                    }
                                    if root.amount-input == "": Text {
                                        x: 10px; y: 0;
                                        width: parent.width - 20px; height: parent.height;
                                        text: "0,00"; font-size: Theme.fs-body; color: Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            init-timer := Timer {
                                interval: 80ms; running: true;
                                triggered => { amount-input.focus(); self.running = false; }
                            }
                        }
                    }

                    // Origem (chips)
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Origem"; font-size: Theme.fs-label; font-weight: Theme.fw-bold; color: Theme.text-secondary; letter-spacing: 1px; }
                        HorizontalLayout {
                            spacing: 8px;
                            for opt[oi] in ["Cofre Troco", "Conta Bancária"]: ch-ta := TouchArea {
                                horizontal-stretch: 1; height: 32px;
                                clicked => { root.origin-selected = opt; }
                                Rectangle {
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: root.origin-selected == opt ? Theme.info : Theme.border;
                                    background: root.origin-selected == opt ? #E3F2FD : (ch-ta.has-hover ? Theme.row-hover : Theme.surface);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: opt;
                                        font-size: Theme.fs-caption; font-weight: Theme.fw-strong;
                                        color: root.origin-selected == opt ? Theme.info : Theme.text-primary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            for opt[oi] in ["Transferência Caixa", "Outro"]: ch2-ta := TouchArea {
                                horizontal-stretch: 1; height: 32px;
                                clicked => { root.origin-selected = opt; }
                                Rectangle {
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: root.origin-selected == opt ? Theme.info : Theme.border;
                                    background: root.origin-selected == opt ? #E3F2FD : (ch2-ta.has-hover ? Theme.row-hover : Theme.surface);
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: opt;
                                        font-size: Theme.fs-caption; font-weight: Theme.fw-strong;
                                        color: root.origin-selected == opt ? Theme.info : Theme.text-primary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    // Detalhe opcional
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Detalhes"; font-size: Theme.fs-label; font-weight: Theme.fw-bold; color: Theme.text-secondary; letter-spacing: 1px; }
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: detail-input.has-focus ? Theme.primary : Theme.border;
                            background: Theme.surface;
                            detail-input := TextInput {
                                x: 10px; y: 0;
                                width: parent.width - 20px; height: parent.height;
                                text <=> root.detail-input;
                                font-size: Theme.fs-caption; color: Theme.text-primary;
                                vertical-alignment: center;
                                single-line: true;
                            }
                            if root.detail-input == "": Text {
                                x: 10px; y: 0;
                                width: parent.width - 20px; height: parent.height;
                                text: "Ex: 6 notas de R$ 5,00";
                                font-size: Theme.fs-caption; color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        ActionBtn {
                            label: "Registrar Suprimento";
                            bg-color: Theme.btn-accent;
                            min-width: 180px; height: 40px;
                            clicked => { root.confirm(); }
                        }
                    }
                }
            }
        }
    }
}
