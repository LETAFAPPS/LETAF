import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
export { ProductData, CustomerData, CategoryData, CategoryIconOption, SubcategoryData, BusinessHoursData, OrderData, OrderItemData, CategoryFilterEntry, SubcategoryFilterEntry, DiscountTierData, AddonGroupData, AddonData, VariationData, VariationOptionData, BannerData, CouponData, CustomerOrderRow, CustomerAddressRow, CatTreeRow, CatProduct, CatSub, KanbanCol, CalDay, PrinterData, PrinterCategoryRow, PdvProductRow, PdvCartRow, PdvCategoryChip, PdvCustomerRow, PdvAddressRow } from "types.slint";
import { Toast } from "components/cards.slint";
import { LoginPage } from "pages/login_page.slint";
import { Sidebar } from "layouts/sidebar.slint";
import { ProductsPage } from "pages/products_page.slint";
import { ProductionPage } from "pages/production_page.slint";
import { CategoriesPage } from "pages/categories_page.slint";
import { CollaboratorsPage } from "pages/collaborators_page.slint";
// ── Estado por feature (AI_RULES §8): cada global mora em
// `state/<feature>.slint`. Re-exportados para o Rust chegar neles via
// `ui.global::<XState>()`.
import { BannersState } from "state/banners.slint";
import { ProductsState } from "state/products.slint";
import { InsumosState } from "state/insumos.slint";
import { InsumosPage } from "pages/insumos_page.slint";
import { CustomersState } from "state/customers.slint";
import { CategoriesState } from "state/categories.slint";
import { AddonsState } from "state/addons.slint";
import { CouponsState } from "state/coupons.slint";
import { OrdersState } from "state/orders.slint";
import { ProductConfigState } from "state/product_config.slint";
import { PdvUiState } from "state/pdv.slint";
import { CashState } from "state/cash.slint";
import { InventoryState } from "state/inventory.slint";
import { DashboardState } from "state/dashboard.slint";
import { ReportsState } from "state/reports.slint";
import { FinanceState } from "state/finance.slint";
import { WalletState } from "state/wallet.slint";
import { TreasuryState } from "state/treasury.slint";
import { SubscriptionState } from "state/subscription.slint";
import { SettingsState } from "state/settings.slint";
import { PrintersState } from "state/printers.slint";
import { CollaboratorsState } from "state/collaborators.slint";
import { AdminState } from "state/admin.slint";
export { BannersState, ProductsState, InsumosState, CustomersState, CategoriesState, AddonsState, CouponsState, OrdersState, ProductConfigState, PdvUiState, CashState, InventoryState, DashboardState, ReportsState, FinanceState, WalletState, TreasuryState, SubscriptionState, SettingsState, PrintersState, CollaboratorsState, AdminState }
import { CustomersPage } from "pages/customers_page.slint";
import { OrdersPage, CalendarPopup } from "pages/orders_page.slint";
import { SettingsPage } from "pages/settings_page.slint";
// `ProductFormPage` deixou de ser instanciada aqui — a `ProductsPage`
// embute o form no painel direito da master-detail (Fase 9). O arquivo
// continua existindo porque o `ProductsPage` o importa com `embedded:
// true` para reaproveitar todos os cards.
import { AddonsPage } from "pages/addons_page.slint";
import { BannersPage } from "pages/banners_page.slint";
import { BannerModal } from "modals/banner_modal.slint";
import { CouponsPage } from "pages/coupons_page.slint";
import { CouponModal } from "modals/coupon_modal.slint";
import { CategoryModal, SubcategoryModal } from "modals/category_modal.slint";
import { AddonGroupModal, AddonItemModal } from "modals/addon_modal.slint";
import { CustomerModal } from "modals/customer_modal.slint";
import { SettingsModal } from "modals/settings_modal.slint";
import { CancelOrderModal } from "modals/cancel_order_modal.slint";
import { ReceiptModal } from "modals/receipt_modal.slint";
import { EditOrderModal } from "modals/edit_order_modal.slint";
import { ProductConfiguratorModal } from "modals/product_configurator_modal.slint";
import { UpdateModal } from "modals/update_modal.slint";
import { LogoutConfirmModal } from "modals/logout_confirm_modal.slint";
import { DeleteConfirmModal } from "modals/delete_confirm_modal.slint";
import { ProduceModal } from "modals/produce_modal.slint";
import { NewOrderAlarmModal } from "modals/new_order_alarm_modal.slint";
import { PrinterModal } from "modals/printer_modal.slint";
import { PdvPage } from "pages/pdv_page.slint";
import { AdminOverviewPage } from "pages/admin_overview_page.slint";
import { AdminCompaniesPage } from "pages/admin_companies_page.slint";
import { AdminCompanyDetailModal } from "modals/admin_company_detail_modal.slint";
import { AdminSubscriptionModal } from "modals/admin_subscription_modal.slint";
import { AdminPlanModal } from "modals/admin_plan_modal.slint";
import { AdminUserModal } from "modals/admin_user_modal.slint";
import { AdminRolesPage } from "pages/admin_roles_page.slint";
import { AdminRoleModal } from "modals/admin_role_modal.slint";
import { AdminAdminsPage } from "pages/admin_admins_page.slint";
import { AdminPlansPage } from "pages/admin_plans_page.slint";
import { PdvSoldModal } from "modals/pdv_sold_modal.slint";
import { PdvCustomerPickerModal } from "modals/pdv_customer_picker_modal.slint";
import { PdvCartModal } from "modals/pdv_cart_modal.slint";
import { CashPage } from "pages/cash_page.slint";
import { InventoryPage } from "pages/inventory_page.slint";
import { StockAdjustModal } from "modals/stock_adjust_modal.slint";
import { CashOpenModal } from "modals/cash_open_modal.slint";
import { CashSangriaModal } from "modals/cash_sangria_modal.slint";
import { CashSuprimentoModal } from "modals/cash_suprimento_modal.slint";
import { CashCloseModal } from "modals/cash_close_modal.slint";
import { PdvBlockedView } from "pages/pdv_blocked_view.slint";
import { NavPerms } from "types.slint";
import { DashboardPage } from "pages/dashboard_page.slint";
import { ReportsPage } from "pages/reports_page.slint";
import { WalletDepositModal, WalletWithdrawModal, WalletAdjustModal, WalletLimitModal } from "modals/wallet_modals.slint";
import { FinancePage } from "pages/finance_page.slint";
import { TreasuryPage } from "pages/treasury_page.slint";
import { TreasuryModal } from "modals/treasury_modal.slint";
import { FinanceEntryModal } from "modals/finance_entry_modal.slint";
import { SubscriptionPage } from "pages/subscription_page.slint";
import { PixChargeModal } from "modals/pix_charge_modal.slint";
import { CardModal } from "modals/card_modal.slint";
import { PixAutoModal } from "modals/pix_auto_modal.slint";
import { PlanChangeConfirmModal } from "modals/plan_change_confirm_modal.slint";
import { ProfileModal } from "modals/profile_modal.slint";

// ══════════════════════════════════════════════════════════════════════════════
//  JANELA PRINCIPAL
// ══════════════════════════════════════════════════════════════════════════════
//
// Regras aplicadas (AI_RULES.md §1, §3, §8, §11):
// - Desktop usa Slint (§3)
// - UI nao contem logica de negocio (§1, §14)
// - Callbacks delegam ao Rust (§1)
// - Login obrigatorio para sincronizar (§11)
// - Componentes reutilizaveis, responsivo (§3, §8)
// - Telas separadas para lista e cadastro (responsabilidade unica, §8)

export component MainWindow inherits Window {
    title: "LETAF";
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 480px;
    background: Theme.bg;

    /// Altura útil da janela em pixels lógicos. Atualizada pelo Rust
    /// no setup e em cada resize via `Window::on_resize_event` (ou
    /// equivalente). Necessária porque `root.height` em layouts
    /// aninhados não propaga corretamente via property — usar valor
    /// setado em Rust evita toda a cadeia de layout buggy do Slint.
    in-out property <length> live-window-height: 800px;
    // Tipografia base do sistema: Geist + corpo 14/400 (spec).
    // Todo `Text` herda a família; se a Geist não estiver
    // instalada/embarcada, o Slint usa o fallback padrão.
    default-font-family: Theme.font-sans;
    default-font-size: Theme.fs-body;
    default-font-weight: Theme.fw-regular;

    // ── Sidebar (Fase 14F: colapsada por padrão) ────
    /// `true` mostra rótulos + 248px; `false` esconde rótulos + 76px.
    /// Toggle ao clicar no logo do topo.
    in-out property <bool> sidebar-expanded: false;

    // ── Login state ─────────────────────────────────
    in-out property <bool> logged-in: false;
    in-out property <string> login-email: "";
    in-out property <string> login-password: "";
    in-out property <string> login-status: "";
    in-out property <bool> login-remember-me: false;
    /// Subdomínio do último login (vazio = nunca logou). Exibido no
    /// rodapé da tela de login para identificar o estabelecimento.
    in-out property <string> login-subdomain: "";
    /// Versão do app (ex.: "v0.1.0") — exibida na tela de login.
    in-out property <string> app-version: "";

    // ── Atualização do desktop (RBAC-independente) ──
    // Preenchidas pelo UpdateChecker (Rust) quando há versão nova.
    in-out property <bool> update-available: false;
    in-out property <string> update-version;
    in-out property <string> update-notes;
    in-out property <bool> update-mandatory: false;
    in-out property <string> update-url;
    in-out property <string> update-sha256;
    /// Status do auto-update ("Baixando…", "Instalando…") e erro, se houver.
    in-out property <string> update-status;
    in-out property <string> update-error;
    /// Auto-update: baixa, valida sha256, substitui o binário e reinicia.
    callback apply-update();
    /// Fallback manual: abre a URL de download no navegador/SO.
    callback open-update-url();
    callback do-login();
    callback login-with-pin();
    // Recuperação de senha ("esqueci a senha") — estado + ações no Rust.
    in-out property <int> recovery-step: 0;
    in-out property <string> recovery-email: "";
    in-out property <string> recovery-code: "";
    in-out property <string> recovery-new-password: "";
    in-out property <string> recovery-status: "";
    in-out property <bool> recovery-busy: false;
    callback recovery-forgot();
    callback recovery-verify();
    callback recovery-reset();
    // Perfil do usuário logado (clique na conta do menu lateral). O Rust
    // busca /auth/me ao abrir e salva via PUT /auth/profile.
    in-out property <bool> profile-open: false;
    in-out property <string> profile-name: "";
    in-out property <string> profile-email: "";
    in-out property <string> profile-new-password: "";
    in-out property <string> profile-status: "";
    in-out property <bool> profile-busy: false;
    // Foto de perfil decodificada (vazia = sem foto).
    in-out property <image> profile-avatar;
    // Base64 da foto atual (reenviado no save; "" = sem foto).
    in-out property <string> profile-avatar-data: "";
    // `true` enquanto a foto escolhida está sendo processada.
    in-out property <bool> profile-avatar-loading: false;
    callback open-profile();
    callback profile-save();
    // Abre o seletor de arquivo e envia a nova foto (Rust).
    callback profile-pick-avatar();
    callback do-logout();
    callback dark-mode-changed(bool);

    // ── Impersonation (super admin gerenciando uma empresa) ──
    // `true` enquanto o super admin está "dentro" de uma empresa; mostra um
    // banner fixo no topo e o botão de sair. A autoridade é o backend (§11):
    // aqui é só UI — o token com escopo do tenant é que dá (ou não) o acesso.
    in-out property <bool> impersonating: false;
    in-out property <string> impersonating-company: "";
    callback exit-impersonation();

    // ── Navegacao ───────────────────────────────────
    // Pedidos é a tela principal do operador (fluxo do dia). "dashboard",
    // Landing inicial: Dashboard (visão consolidada de KPIs + vendas
    // da semana). Atalhos da sidebar redirecionam para Pedidos/PDV.
    in-out property <string> active-tab: "dashboard";
    // Aba inicial a aplicar APÓS o primeiro frame. Setar `active-tab`
    // direto no restore (antes da janela montar) faz o Slint montar a
    // página durante o layout inicial → recursão de binding em telas que
    // dependem de `root.height` (ex.: PDV). Adiar via Timer monta a tela
    // com o layout já estabelecido, como numa navegação normal.
    in-out property <string> pending-initial-tab: "";
    Timer {
        interval: 1ms;
        // `running` segue só o binding: ao zerar pending-initial-tab no
        // triggered, vira false sozinho (sem atribuição imperativa).
        running: root.pending-initial-tab != "";
        triggered => {
            root.active-tab = root.pending-initial-tab;
            root.pending-initial-tab = "";
            // Sessão restaurada de super admin: carrega o painel ao abrir
            // (qualquer aba de plataforma).
            if root.active-tab == "admin-overview" || root.active-tab == "admin-companies"
               || root.active-tab == "admin-admins"
               || root.active-tab == "admin-plans" || root.active-tab == "admin-roles" {
                AdminState.refresh();
            }
        }
    }
    in-out property <bool> show-modal: false;
    in-out property <string> modal-type: "";
    in-out property <bool> show-delete-confirm: false;
    in-out property <string> delete-target-id: "";
    in-out property <string> delete-target-name: "";
    in-out property <string> delete-target-type: "";
    callback confirm-delete();

    /// Total de pedidos ativos (status != Entregue/Cancelado).
    /// Alimentado em Rust e usado no badge da sidebar.
    in-out property <int> orders-active-count: 0;
    /// Badges da sidebar: contas vencidas (Financeiro) e produtos fora
    /// de estoque (Estoque). Alimentados em Rust.
    in-out property <int> finance-overdue-count: 0;
    in-out property <int> stock-out-count: 0;
    in-out property <string> status-message: "Pronto";
    in-out property <string> editing-id: "";

    // ── Sidebar (status de sync + identidade do usuário) ───
    // Regras aplicadas (AI_RULES.md §7, §11):
    // Estado do SyncWorker exposto à UI; preenchido pelo Rust.
    // `user-role` é placeholder até roles serem implementados no User.
    in-out property <bool>   sync-online: true;
    in-out property <string> sync-status-label: "Sincronizado";
    in-out property <string> sync-last-label: "Agora";
    in-out property <int>    sync-pending-count: 0;
    in-out property <string> user-role: "Admin";
    in-out property <string> user-name: "Minha conta";
    // Permissões de navegação (RBAC §11). Default libera tudo até o login
    // calcular as permissões reais do operador. `collaborators-perms` é
    // o catálogo + estado para a tela de Colaboradores (Slice 4b/4c).
    in-out property <NavPerms> nav-perms: { is-admin: true };

    in-out property <bool> show-logout-confirm: false;

    /// Número de ações pendentes (faturas + status overdue) — alimenta
    /// o badge ao lado de PLANO & COBRANÇA na sidebar. 0 = sem badge.
    in-out property <int> subscription-pending-count: 0;

    // ── Alarme de novos pedidos ──────────────────────────────────
    // `alarm-active`: estado lógico do alarme; enquanto true, o som
    //   continua e o modal volta sozinho se o operador apenas
    //   fechar. Setado pelo SyncWorker via observer task em Rust.
    // `alarm-visible`: controla a renderização do modal. Pode ser
    //   false enquanto `alarm-active` for true (intervalo de 5s
    //   entre reabertura — regra do projeto).
    // `alarm-pending-count`: quantidade total de Pendings no banco
    //   neste instante; usado pelo corpo do modal.
    in-out property <bool> alarm-active: false;
    in-out property <bool> alarm-visible: false;
    in-out property <int>  alarm-pending-count: 0;
    callback alarm-acknowledge();
    callback alarm-dismiss();
    // Reabre o modal 5 s após o operador fechar (regra: "enquanto não
    // clicar no botão, não vai parar de avisar"). `running` só é true
    // quando o alarme está ATIVO mas o modal está ESCONDIDO — quando
    // visível, o Timer pausa; quando o operador aciona, fica false.
    alarm-reopen-timer := Timer {
        interval: 5s;
        running: root.alarm-active && !root.alarm-visible;
        triggered => { root.alarm-visible = true; }
    }

    in-out property <bool> toast-visible: false;
    in-out property <string> toast-message: "";
    in-out property <string> toast-type: "success";

    toast-timer := Timer {
        interval: 3000ms;
        running: root.toast-visible;
        triggered => { root.toast-visible = false; }
    }

    // ════════════════════════════════════════════════
    //  TELA DE LOGIN
    // ════════════════════════════════════════════════
    if !root.logged-in: LoginPage {
        email <=> root.login-email;
        password <=> root.login-password;
        status <=> root.login-status;
        remember-me <=> root.login-remember-me;
        subdomain: root.login-subdomain;
        app-version: root.app-version;
        server-online: root.sync-online;
        server-last: root.sync-last-label;
        do-login => { root.do-login(); }
        login-with-pin => { root.login-with-pin(); }
        recovery-step <=> root.recovery-step;
        recovery-email <=> root.recovery-email;
        recovery-code <=> root.recovery-code;
        recovery-new-password <=> root.recovery-new-password;
        recovery-status <=> root.recovery-status;
        recovery-busy: root.recovery-busy;
        forgot-request => { root.recovery-forgot(); }
        verify-submit => { root.recovery-verify(); }
        reset-submit => { root.recovery-reset(); }
    }

    // ════════════════════════════════════════════════
    //  AREA PRINCIPAL (pos-login)
    // ════════════════════════════════════════════════
    if root.logged-in: VerticalLayout {

        // Banner de impersonation: fixo no topo enquanto o super admin
        // gerencia uma empresa (telas reais do ERP). "Sair" volta ao painel.
        if root.impersonating: Rectangle {
            height: 50px;
            // Mesma cor do menu lateral (a pedido).
            background: Theme.sidebar-bg;
            // Grupo (texto + X) centralizado no card; o X fica logo ao lado
            // do texto "Gerenciando".
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                padding-left: 10px; padding-right: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Gerenciando";
                        color: white; font-size: 13px; font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.impersonating-company;
                        color: #ffffffcc; font-size: 11px;
                        horizontal-alignment: center; overflow: elide;
                    }
                }
                // Sair da empresa = X (ao lado do texto, centralizado no botão).
                VerticalLayout {
                    alignment: center;
                    exit-ta := TouchArea {
                        width: 32px; height: 32px;
                        clicked => { root.exit-impersonation(); }
                        Rectangle {
                            width: parent.width; height: parent.height;
                            border-radius: 6px;
                            background: exit-ta.has-hover ? #ffffff33 : transparent;
                            Text {
                                text: "✕"; color: white; font-size: 15px;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {

        Sidebar {
            active-tab <=> root.active-tab;
            expanded <=> root.sidebar-expanded;
            nav: root.nav-perms;
            store-name: SettingsState.store-name;
            user-role: root.user-role;
            user-name: root.user-name;
            store-logo-image: SettingsState.store-logo-image;
            user-avatar: root.profile-avatar;
            orders-count: root.orders-active-count;
            subscription-pending-count: root.subscription-pending-count;
            finance-overdue-count: root.finance-overdue-count;
            stock-out-count: root.stock-out-count;
            sync-online: root.sync-online;
            sync-status-label: root.sync-status-label;
            sync-last-label: root.sync-last-label;
            sync-pending-count: root.sync-pending-count;
            dark-mode-changed(d) => { root.dark-mode-changed(d); }
            navigate(tab) => {
                root.active-tab = tab;
                root.show-modal = false;
                if tab == "products" {
                    ProductsState.refresh-products();
                    CategoriesState.refresh-categories();
                    CategoriesState.refresh-subcategories();
                } else if tab == "insumos" {
                    InsumosState.refresh-insumos();
                } else if tab == "producao" {
                    // Estoque atualizado ao entrar na Produção.
                    ProductsState.refresh-products();
                } else if tab == "categories" {
                    CategoriesState.subcategory-filter-category-id = "all";
                    CategoriesState.refresh-categories();
                    CategoriesState.refresh-subcategories();
                } else if tab == "addons" {
                    AddonsState.selected-addon-group-id = "";
                    AddonsState.selected-addon-group-name = "";
                    AddonsState.current-group-addons = [];
                    AddonsState.refresh-addon-groups();
                } else if tab == "customers" {
                    CustomersState.refresh-customers();
                } else if tab == "collaborators" {
                    CollaboratorsState.refresh-collaborators();
                } else if tab == "orders" {
                    OrdersState.order-detail-id = "";
                    OrdersState.refresh-orders();
                } else if tab == "pdv" {
                    // Recarrega produtos/categorias ao abrir o PDV — senão um
                    // produto recém-cadastrado não aparece até reiniciar o app.
                    PdvUiState.pdv-refresh();
                } else if tab == "settings" {
                    SettingsState.refresh-business-hours();
                } else if tab == "banners" {
                    // Garante que a lista de produtos esteja carregada
                    // para resolver `item-name` no banner de produto.
                    ProductsState.refresh-products();
                    BannersState.refresh-banners();
                } else if tab == "coupons" {
                    CouponsState.refresh-coupons();
                } else if tab == "cash" {
                    CashState.cash-refresh();
                } else if tab == "treasury" {
                    TreasuryState.treasury-refresh();
                } else if tab == "inventory" {
                    InventoryState.inventory-refresh();
                } else if tab == "dashboard" {
                    DashboardState.dashboard-refresh();
                } else if tab == "reports" {
                    ReportsState.report-refresh();
                } else if tab == "subscription" {
                    // Refresca ao ABRIR: o listener de sync só recomputa com a
                    // aba visível (evitava requisição HTTP a cada 30s com a
                    // tela fechada).
                    SubscriptionState.subscription-refresh();
                } else if tab == "admin-overview" || tab == "admin-companies"
                       || tab == "admin-admins"
                       || tab == "admin-plans" || tab == "admin-roles" {
                    AdminState.refresh();
                }
                // Importante: NÃO disparar cash-refresh ao entrar no
                // PDV. O estado já é pré-carregado no boot e após
                // login; disparar aqui causava re-entrância de
                // renderização (modal aparece no mesmo frame em que
                // a aba muda + callback async modifica cash-summary),
                // o que travava a UI ao entrar na aba PDV.
            }
            request-logout => { root.show-logout-confirm = true; }
            open-profile => { root.open-profile(); }
            toggle-expanded => { root.sidebar-expanded = !root.sidebar-expanded; }
        }

        // PDV mora FORA do ScrollView raiz pra receber a altura
        // total do HorizontalLayout pai (Sidebar + conteúdo). Sem
        // isso, o cart Rectangle não estica e o footer fica solto
        // no meio do card. PDV não precisa de scroll de página
        // (cabe no viewport; tem ScrollView interno só pro carrinho).
        //
        // Envolvido num Rectangle wrapper com `vertical-stretch: 1`
        // pra GARANTIR altura definida. PdvPage interno usa
        // `width/height: parent.*` pra preencher — referência sem
        // loop porque o Rectangle não depende do PdvPage pra seu
        // tamanho.
        if root.active-tab == "pdv" && CashState.cash-blocked: Rectangle {
            horizontal-stretch: 1;
            height: root.height;
            PdvBlockedView {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                go-to-cash => { root.active-tab = "cash"; }
            }
        }

        if root.active-tab == "pdv" && !CashState.cash-blocked: Rectangle {
            horizontal-stretch: 1;
            // Em vez de vertical-stretch (que o Slint às vezes
            // ignora aqui), seto height literal = altura da Window
            // (root). Sem ambiguidade.
            height: root.height;
            pdv-page := PdvPage {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                window-height: root.live-window-height;
                customer-picker-open: PdvUiState.pdv-show-customer-picker;
                sold-modal-open: PdvUiState.pdv-show-sold;
                products: PdvUiState.pdv-products;
            cart: PdvUiState.pdv-cart;
            categories: PdvUiState.pdv-categories;
            categories-row2: PdvUiState.pdv-categories-row2;
            cats-width-changed(w) => { PdvUiState.pdv-cats-width-changed(w); }
            search-text <=> PdvUiState.pdv-search-text;
            subtotal-display: PdvUiState.pdv-subtotal-display;
            discount-display: PdvUiState.pdv-discount-display;
            additional-display: PdvUiState.pdv-additional-display;
            delivery-fee-display: PdvUiState.pdv-delivery-fee-display;
            total-display: PdvUiState.pdv-total-display;
            discount-input <=> PdvUiState.pdv-discount-input;
            additional-input <=> PdvUiState.pdv-additional-input;
            cart-count: PdvUiState.pdv-cart-count;
            sale-type <=> PdvUiState.pdv-sale-type;
            payment-method <=> PdvUiState.pdv-payment-method;
            payment-card-type <=> PdvUiState.pdv-payment-card-type;
            secondary-payment <=> PdvUiState.pdv-secondary-payment;
            amount-paid-input <=> PdvUiState.pdv-amount-paid-input;
            change-display: PdvUiState.pdv-change-display;
            remaining-display: PdvUiState.pdv-remaining-display;
            split-enabled <=> PdvUiState.pdv-split-enabled;
            split-m1 <=> PdvUiState.pdv-split-m1;
            split-m2 <=> PdvUiState.pdv-split-m2;
            split-m3 <=> PdvUiState.pdv-split-m3;
            split-v1-input <=> PdvUiState.pdv-split-v1-input;
            split-v2-input <=> PdvUiState.pdv-split-v2-input;
            split-v3-input <=> PdvUiState.pdv-split-v3-input;
            split-v1 <=> PdvUiState.pdv-split-v1;
            split-v2 <=> PdvUiState.pdv-split-v2;
            split-v3 <=> PdvUiState.pdv-split-v3;
            split-amount-changed(i, v) => { PdvUiState.pdv-split-amount-changed(i, v); }
            customer-name: PdvUiState.pdv-customer-name;
            wallet-has-account: PdvUiState.pdv-wallet-has-account;
            wallet-balance-display: PdvUiState.pdv-wallet-balance-display;
            wallet-balance-tone: PdvUiState.pdv-wallet-balance-tone;
            wallet-credit-limit-display: PdvUiState.pdv-wallet-credit-limit-display;
            wallet-available-display: PdvUiState.pdv-wallet-available-display;
            wallet-available-amount: PdvUiState.pdv-wallet-available-amount;
            total-amount: PdvUiState.pdv-total-amount;
            delivery-street <=> PdvUiState.pdv-delivery-street;
            delivery-number <=> PdvUiState.pdv-delivery-number;
            delivery-neighborhood <=> PdvUiState.pdv-delivery-neighborhood;
            finalize-error: PdvUiState.pdv-finalize-error;
            search-changed(q) => { PdvUiState.pdv-search-changed(q); }
            submit-search => { PdvUiState.pdv-submit-search(); }
            toggle-category(id) => { PdvUiState.pdv-toggle-category(id); }
            clear-categories => { PdvUiState.pdv-clear-categories(); }
            add-product(id) => { PdvUiState.pdv-add-product(id); }
            inc-line(id) => { PdvUiState.pdv-inc-line(id); }
            dec-line(id) => { PdvUiState.pdv-dec-line(id); }
            remove-line(id) => { PdvUiState.pdv-remove-line(id); }
            open-cart => { PdvUiState.pdv-show-cart-modal = true; }
            clear-cart => { PdvUiState.pdv-clear-cart(); }
            finalize => { PdvUiState.pdv-finalize(); }
            open-customer-picker => { PdvUiState.pdv-open-customer-picker(); }
            clear-customer => { PdvUiState.pdv-clear-customer(); }
            discount-changed(v) => { PdvUiState.pdv-discount-changed(v); }
            additional-changed(v) => { PdvUiState.pdv-additional-changed(v); }
            amount-paid-changed(v) => { PdvUiState.pdv-amount-paid-changed(v); }
            customer-addresses: PdvUiState.pdv-customer-addresses;
            use-address(id) => { PdvUiState.pdv-use-address(id); }
            }
        }

        // ScrollView raiz da área de conteúdo: garante que, em janelas
        // estreitas (largura abaixo do preferred-width das páginas), o
        // conteúdo seja rolável vertical/horizontalmente em vez de ser
        // cortado. min-width: 0 no layout interno permite encolhimento.
        // Não renderiza no PDV — ele vive fora.
        if root.active-tab != "pdv": ScrollView { vertical-scrollbar-policy: ScrollBarPolicy.always-off; horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-stretch: 1;
            VerticalLayout {
                min-width: 0;
                // TODAS as telas ficam a 24px das paredes (referência:
                // Caixa e Clientes). Duas exceções, ambas para chegar nos
                // mesmos 24px finais:
                // - Relatórios = 0px: a página aplica os 24px por dentro do
                //   ScrollView, dando folga p/ a sombra dos cards roláveis;
                // - Assinatura = 12px: a página já reserva 12px de folga
                //   para a sombra dentro do Flickable.
                padding: root.active-tab == "reports" ? 0px
                    : (root.active-tab == "subscription" ? 12px : 24px);
                spacing: 16px;

                // ── Painel do administrador (super admin) ──
                if root.active-tab == "admin-overview": AdminOverviewPage {
                    companies: AdminState.companies-count;
                    active-companies: AdminState.active-companies;
                    suspended-companies: AdminState.suspended-companies;
                    active-subs: AdminState.active-subs;
                    overdue-subs: AdminState.overdue-subs;
                    cancelled-subs: AdminState.cancelled-subs;
                    inactive-subs: AdminState.inactive-subs;
                    referrals: AdminState.referrals;
                    mrr: AdminState.mrr;
                    annual-revenue: AdminState.annual-revenue;
                    arpa: AdminState.arpa;
                    top-plan: AdminState.top-plan;
                    current-year: AdminState.current-year;
                    prev-year: AdminState.prev-year;
                    revenue-max: AdminState.revenue-max;
                    revenue-points: AdminState.revenue-points;
                }
                if root.active-tab == "admin-companies": AdminCompaniesPage {
                    companies: AdminState.companies;
                    form-name <=> AdminState.company-form-name;
                    form-subdomain <=> AdminState.company-form-subdomain;
                    form-admin-name <=> AdminState.company-form-admin-name;
                    form-admin-email <=> AdminState.company-form-admin-email;
                    form-admin-password <=> AdminState.company-form-admin-password;
                    form-admin-phone <=> AdminState.company-form-admin-phone;
                    form-phone <=> AdminState.company-form-phone;
                    form-whatsapp <=> AdminState.company-form-whatsapp;
                    form-email <=> AdminState.company-form-email;
                    form-document <=> AdminState.company-form-document;
                    form-discount <=> AdminState.company-form-discount;
                    form-address <=> AdminState.company-form-address;
                    form-neighborhood <=> AdminState.company-form-neighborhood;
                    form-zip <=> AdminState.company-form-zip;
                    form-city <=> AdminState.company-form-city;
                    form-uf <=> AdminState.company-form-uf;
                    form-location-url <=> AdminState.company-form-location-url;
                    form-plan <=> AdminState.company-form-plan;
                    plan-options: AdminState.company-form-plan-options;
                    form-business-type <=> AdminState.company-form-business-type;
                    business-type-options: AdminState.company-form-business-type-options;
                    form-trial <=> AdminState.company-form-trial;
                    logo-image: AdminState.company-form-logo-image;
                    cover-image: AdminState.company-form-cover-image;
                    logo-loading: AdminState.company-form-logo-loading;
                    cover-loading: AdminState.company-form-cover-loading;
                    has-logo: AdminState.company-form-logo-data != "";
                    has-cover: AdminState.company-form-cover-data != "";
                    save-company => { AdminState.save-company(); }
                    pick-logo => { AdminState.pick-company-logo(); }
                    pick-cover => { AdminState.pick-company-cover(); }
                    cep-changed(v) => { AdminState.company-cep-changed(v); }
                    cep-loading: AdminState.company-cep-loading;
                    // Encaminha máscara/verificação ao global (§11).
                    mask-field(k, v) => { AdminState.apply-mask(k, v) }
                    field-error(r, v) => { AdminState.field-error(r, v) }
                    show-form <=> AdminState.company-show-form;
                    tentou-salvar <=> AdminState.company-form-attempted;
                    editing <=> AdminState.company-editing;
                    edit-id <=> AdminState.company-edit-id;
                    new-company => { AdminState.company-new-form(); }
                    edit-company(id) => { AdminState.company-edit(id); }
                    delete-company(id, name) => {
                        AdminState.del-company-id = id;
                        AdminState.del-company-name = name;
                        AdminState.del-company-open = true;
                    }
                    set-company-active(id, active) => { AdminState.set-company-active(id, active); }
                    open-detail(id) => { AdminState.open-company-detail(id); }
                    // Gerenciar assinatura direto do card da empresa.
                    manage-subscription(c) => {
                        AdminState.sub-edit-company-id = c.id;
                        AdminState.sub-edit-company-name = c.name;
                        AdminState.sub-edit-plan = c.plan-id;
                        AdminState.sub-edit-status = c.status == "none" ? "inactive" : c.status;
                        AdminState.sub-edit-discount = c.discount;
                        AdminState.sub-edit-discount-name = c.discount-name;
                        AdminState.sub-edit-open = true;
                    }
                    search <=> AdminState.company-search;
                    filter <=> AdminState.company-filter;
                    plan-filter <=> AdminState.company-plan-filter;
                    plan-filter-options: AdminState.company-plan-filter-options;
                    plan-filter-label: AdminState.company-plan-filter-label;
                    filters-changed => { AdminState.filter-companies(); }
                }
                if root.active-tab == "admin-admins": AdminAdminsPage {
                    users: AdminState.users;
                    search <=> AdminState.user-search;
                    new-user => { AdminState.new-user(); }
                    edit-user(id) => { AdminState.edit-user(id); }
                    delete-user(id, name) => {
                        AdminState.del-user-id = id;
                        AdminState.del-user-name = name;
                        AdminState.del-user-open = true;
                    }
                    set-user-active(id, active) => { AdminState.set-user-active(id, active); }
                    filters-changed => { AdminState.filter-users(); }
                }
                if root.active-tab == "admin-roles": AdminRolesPage {
                    roles: AdminState.admin-roles;
                    search <=> AdminState.role-search;
                    new-role => { AdminState.role-new(); }
                    edit-role(id) => { AdminState.role-edit(id); }
                    delete-role(id, name) => {
                        AdminState.del-role-id = id;
                        AdminState.del-role-name = name;
                        AdminState.del-role-open = true;
                    }
                    filters-changed => { AdminState.filter-roles(); }
                }
                if root.active-tab == "admin-plans": AdminPlansPage {
                    plans: AdminState.plans;
                    search <=> AdminState.plan-search;
                    new-plan => { AdminState.plan-new(); }
                    edit-plan(id) => { AdminState.plan-edit(id); }
                    delete-plan(id, name) => {
                        AdminState.del-plan-id = id;
                        AdminState.del-plan-name = name;
                        AdminState.del-plan-open = true;
                    }
                    filters-changed => { AdminState.filter-plans(); }
                }

                // Produtos — master-detail com editor inline (não há mais
                // aba `product-form` separada; o form vive no painel direito).
                if root.active-tab == "products": ProductsPage {
                    products: ProductsState.products;
                    products-active-count: ProductsState.products-active-count;
                    products-inactive-count: ProductsState.products-inactive-count;
                    products-per-page: SettingsState.products-per-page;
                    filter-cats: ProductsState.filter-cats;
                    filter-subs: ProductsState.filter-subs;
                    filter-status: ProductsState.filter-status;
                    filter-stock: ProductsState.filter-stock;
                    filter-active-count: ProductsState.filter-active-count;
                    selected-product-id: ProductsState.selected-product-id;
                    detail-product: ProductsState.detail-product;
                    // Pass-through do estado do form (in-out → o Rust escreve
                    // direto via setters; aqui só pontuamos a ligação).
                    editing-id <=> root.editing-id;
                    product-name <=> ProductsState.product-name;
                    product-description <=> ProductsState.product-description;
                    product-price <=> ProductsState.product-price;
                    product-cost-price <=> ProductsState.product-cost-price;
                    product-stock-quantity <=> ProductsState.product-stock-quantity;
                    product-min-stock <=> ProductsState.product-min-stock;
                    product-margin-display: ProductsState.product-margin-display;
                    product-unlimited-stock <=> ProductsState.product-unlimited-stock;
                    product-availability-enabled <=> ProductsState.product-availability-enabled;
                    product-availability <=> ProductsState.product-availability;
                    product-discount-kind <=> ProductsState.product-discount-kind;
                    product-discount-value <=> ProductsState.product-discount-value;
                    product-discount-min-qty <=> ProductsState.product-discount-min-qty;
                    product-discount-tiers <=> ProductsState.product-discount-tiers;
                    product-barcode <=> ProductsState.product-barcode;
                    product-unit <=> ProductsState.product-unit;
                    product-balance-mode <=> ProductsState.product-balance-mode;
                    product-image-data <=> ProductsState.product-image-data;
                    product-image-loading <=> ProductsState.product-image-loading;
                    product-category-id <=> ProductsState.product-category-id;
                    product-category-name <=> ProductsState.product-category-name;
                    product-category-open <=> ProductsState.product-category-open;
                    product-subcategory-id <=> ProductsState.product-subcategory-id;
                    product-subcategory-name <=> ProductsState.product-subcategory-name;
                    product-subcategory-open <=> ProductsState.product-subcategory-open;
                    product-error-name <=> ProductsState.product-error-name;
                    product-error-price <=> ProductsState.product-error-price;
                    product-error-stock <=> ProductsState.product-error-stock;
                    product-save-error <=> ProductsState.product-save-error;
                    categories: CategoriesState.categories;
                    subcategories: CategoriesState.subcategories;
                    addon-groups: ProductsState.product-addon-groups;
                    variations <=> ProductsState.product-variations;
                    // Filtros / sidebar
                    search-changed(q) => { ProductsState.filter-products(q); }
                    toggle-category-filter(id) => { ProductsState.toggle-category-filter(id); }
                    toggle-subcategory-filter(id) => { ProductsState.toggle-subcategory-filter(id); }
                    set-status-filter(v) => { ProductsState.set-status-filter(v); }
                    set-stock-filter(v)  => { ProductsState.set-stock-filter(v); }
                    reset-product-filters => { ProductsState.reset-product-filters(); }
                    // Toggles (Ativo / Web visível) usam os mesmos
                    // callbacks já existentes — o Rust faz o flip.
                    toggle-product-active(id) => { ProductsState.toggle-product-active(id); }
                    toggle-product-web-visible(id) => { ProductsState.toggle-product-web-visible(id); }
                    select-product(id) => { ProductsState.select-product(id); }
                    request-duplicate(p) => { ProductsState.duplicate-product(p.id); }
                    // "+ Novo produto" — limpa o form e marca a seleção
                    // com o sentinel "new" para o painel direito virar
                    // o cadastro (sem trocar de aba).
                    request-new => {
                        // Zera o snapshot do detalhe primeiro — sem isso,
                        // o card de imagem mostraria a foto do último
                        // produto selecionado até o operador escolher
                        // outra imagem.
                        ProductsState.clear-detail-product();
                        root.editing-id = "";
                        ProductsState.product-name = ""; ProductsState.product-description = "";
                        ProductsState.product-price = ""; ProductsState.product-stock-quantity = "";
                        ProductsState.product-cost-price = ""; ProductsState.product-min-stock = "";
                        ProductsState.product-margin-display = "—";
                        ProductsState.product-unlimited-stock = false;
                        ProductsState.product-availability-enabled = false;
                        ProductsState.product-discount-kind = "none";
                        ProductsState.product-discount-value = "";
                        ProductsState.product-discount-min-qty = "";
                        ProductsState.load-discount-tiers("");
                        ProductsState.load-product-addon-groups("");
                        ProductsState.load-product-ingredients("");
                        ProductsState.load-product-gallery("");
                        ProductsState.load-product-variations("");
                        ProductsState.product-barcode = ""; ProductsState.product-unit = "un";
                        ProductsState.product-balance-mode = "price";
                        ProductsState.product-image-data = "";
                        ProductsState.product-cover-color = "";
                        ProductsState.product-category-id = ""; ProductsState.product-category-name = "";
                        ProductsState.product-subcategory-id = ""; ProductsState.product-subcategory-name = "";
                        ProductsState.product-category-open = false; ProductsState.product-subcategory-open = false;
                        ProductsState.product-error-name = ""; ProductsState.product-error-price = ""; ProductsState.product-error-stock = "";
                        ProductsState.selected-product-id = "new";
                    }
                    request-delete(id, name, type) => {
                        root.delete-target-id = id; root.delete-target-name = name;
                        root.delete-target-type = type; root.show-delete-confirm = true;
                    }
                    // Callbacks do form (encaminham aos do MainWindow).
                    add-product => { ProductsState.add-product(); }
                    update-product => { ProductsState.update-product(); }
                    export-products => { ProductsState.export-products(); }
                    import-products => { ProductsState.import-products(); }
                    pick-product-image => { ProductsState.pick-product-image(); }
                    remove-product-image => { ProductsState.remove-product-image(); }
                    add-discount-tier => { ProductsState.add-discount-tier(); }
                    remove-discount-tier(idx) => { ProductsState.remove-discount-tier(idx); }
                    toggle-addon-group(id) => { ProductsState.toggle-product-addon-group(id); }
                    add-variation => { ProductsState.add-variation(); }
                    remove-variation(idx) => { ProductsState.remove-variation(idx); }
                    add-variation-option(idx) => { ProductsState.add-variation-option(idx); }
                    remove-variation-option(vidx, oidx) => { ProductsState.remove-variation-option(vidx, oidx); }
                    apply-time-mask(t) => { SettingsState.apply-time-mask(t) }
                }

            // Insumos (matéria-prima) — lê/escreve direto no InsumosState.
            if root.active-tab == "insumos": InsumosPage { }

            // Produção (só "fábrica") — tela própria.
            if root.active-tab == "producao": ProductionPage { }

            // Categorias
            if root.active-tab == "categories": CategoriesPage {
                category-tree: CategoriesState.category-tree;
                category-count: CategoriesState.category-count;
                selected-category-id: CategoriesState.selected-category-id;
                detail-category: CategoriesState.detail-category;
                detail-color: CategoriesState.detail-color;
                detail-prod-count: CategoriesState.detail-prod-count;
                detail-sub-count: CategoriesState.detail-sub-count;
                detail-stock-value: CategoriesState.detail-stock-value;
                detail-catalog-pct: CategoriesState.detail-catalog-pct;
                detail-catalog-hint: CategoriesState.detail-catalog-hint;
                detail-cat-products: CategoriesState.detail-cat-products;
                detail-cat-subs: CategoriesState.detail-cat-subs;
                select-category(id) => { CategoriesState.select-category(id); }
                toggle-category(id) => { CategoriesState.toggle-category(id); }
                request-new-category => {
                    root.editing-id = ""; CategoriesState.category-name = "";
                    CategoriesState.category-description = ""; CategoriesState.category-error-name = "";
                    CategoriesState.category-icon-name = "";
                    root.modal-type = "category"; root.show-modal = true;
                }
                request-edit-category(c) => {
                    root.editing-id = c.id; CategoriesState.category-name = c.name;
                    CategoriesState.category-description = c.description; CategoriesState.category-error-name = "";
                    CategoriesState.category-icon-name = c.icon-name;
                    root.modal-type = "category"; root.show-modal = true;
                }
                request-new-sub-in(cat-id, cat-name) => {
                    root.editing-id = ""; CategoriesState.subcategory-name = "";
                    CategoriesState.subcategory-category-id = cat-id;
                    CategoriesState.subcategory-category-name = cat-name;
                    CategoriesState.subcategory-error-name = ""; CategoriesState.subcategory-error-category = "";
                    CategoriesState.subcategory-category-open = false;
                    root.modal-type = "subcategory"; root.show-modal = true;
                }
                request-edit-subcategory(s) => {
                    root.editing-id = s.id; CategoriesState.subcategory-name = s.name;
                    CategoriesState.subcategory-category-id = s.category-id; CategoriesState.subcategory-category-name = s.category-name;
                    CategoriesState.subcategory-error-name = ""; CategoriesState.subcategory-error-category = "";
                    CategoriesState.subcategory-category-open = false;
                    root.modal-type = "subcategory"; root.show-modal = true;
                }
                request-new-product-in(cat-id, cat-name) => {
                    // Mesmo motivo do `request-new` em ProductsPage: zera
                    // o snapshot do detalhe antes do form.
                    ProductsState.clear-detail-product();
                    root.editing-id = "";
                    ProductsState.product-name = ""; ProductsState.product-description = "";
                    ProductsState.product-price = ""; ProductsState.product-stock-quantity = "";
                    ProductsState.product-cost-price = ""; ProductsState.product-min-stock = "";
                    ProductsState.product-margin-display = "—";
                    ProductsState.product-unlimited-stock = false;
                    ProductsState.product-availability-enabled = false;
                    ProductsState.product-discount-kind = "none";
                    ProductsState.product-discount-value = "";
                    ProductsState.product-discount-min-qty = "";
                    ProductsState.load-discount-tiers("");
                    ProductsState.load-product-addon-groups("");
                    ProductsState.load-product-variations("");
                    ProductsState.product-barcode = ""; ProductsState.product-unit = "un";
                    ProductsState.product-balance-mode = "price";
                    ProductsState.product-image-data = "";
                    ProductsState.product-cover-color = "";
                    ProductsState.product-category-id = cat-id; ProductsState.product-category-name = cat-name;
                    ProductsState.product-subcategory-id = ""; ProductsState.product-subcategory-name = "";
                    ProductsState.product-category-open = false; ProductsState.product-subcategory-open = false;
                    ProductsState.product-error-name = ""; ProductsState.product-error-price = ""; ProductsState.product-error-stock = "";
                    // Navega para Produtos (master-detail) com a aba do
                    // formulário já preparada como "Novo Produto" e a
                    // categoria pré-selecionada.
                    ProductsState.selected-product-id = "new";
                    root.active-tab = "products";
                }
                request-delete(id, name, type) => {
                    root.delete-target-id = id; root.delete-target-name = name;
                    root.delete-target-type = type; root.show-delete-confirm = true;
                }
            }

            // Colaboradores (RBAC — Funções + Funcionários)
            if root.active-tab == "collaborators": CollaboratorsPage {
                roles: CollaboratorsState.collab-roles;
                employees: CollaboratorsState.collab-employees;
                perm-rows: CollaboratorsState.collab-perm-rows;
                role-combo: CollaboratorsState.collab-role-combo;
                editing-role-id <=> CollaboratorsState.collab-editing-role-id;
                role-name <=> CollaboratorsState.collab-role-name;
                emp-id <=> CollaboratorsState.collab-emp-id;
                emp-name <=> CollaboratorsState.collab-emp-name;
                emp-email <=> CollaboratorsState.collab-emp-email;
                emp-password <=> CollaboratorsState.collab-emp-password;
                emp-role-index <=> CollaboratorsState.collab-emp-role-index;
                perm-active: CollaboratorsState.collab-perm-active;
                perm-total: CollaboratorsState.collab-perm-total;
                mark-all-perms => { CollaboratorsState.collab-mark-all-perms(); }
                refresh => { CollaboratorsState.refresh-collaborators(); }
                new-role => { CollaboratorsState.collab-new-role(); }
                edit-role(id) => { CollaboratorsState.collab-edit-role(id); }
                save-role(id, name) => { CollaboratorsState.collab-save-role(id, name); }
                toggle-perm(k, e, on) => { CollaboratorsState.collab-toggle-perm(k, e, on); }
                new-employee => { CollaboratorsState.collab-new-employee(); }
                edit-employee(id) => { CollaboratorsState.collab-edit-employee(id); }
                save-employee(id, n, em, pw, idx) => { CollaboratorsState.collab-save-employee(id, n, em, pw, idx); }
                role-search-changed(q) => { CollaboratorsState.collab-role-search-changed(q); }
                emp-search-changed(q) => { CollaboratorsState.collab-emp-search-changed(q); }
                // Exclusão de função/funcionário passa pelo modal de
                // confirmação global (type "job-role" / "employee").
                request-delete(id, name, type) => {
                    root.delete-target-id = id; root.delete-target-name = name;
                    root.delete-target-type = type; root.show-delete-confirm = true;
                }
            }

            // Adicionais (Fase 4B)
            if root.active-tab == "addons": AddonsPage {
                groups: AddonsState.addon-groups;
                addons: AddonsState.current-group-addons;
                selected-group-id <=> AddonsState.selected-addon-group-id;
                selected-group-name: AddonsState.selected-addon-group-name;
                request-new-group => {
                    AddonsState.addon-group-form-id = "";
                    AddonsState.addon-group-form-name = "";
                    AddonsState.addon-group-form-selection = "single";
                    // Single sempre começa com limites fixos 0/1.
                    AddonsState.addon-group-form-min = "0";
                    AddonsState.addon-group-form-max = "1";
                    AddonsState.addon-group-form-error = "";
                    root.modal-type = "addon-group";
                    root.show-modal = true;
                }
                request-edit-group(g) => {
                    AddonsState.addon-group-form-id = g.id;
                    AddonsState.addon-group-form-name = g.name;
                    AddonsState.addon-group-form-selection = g.selection;
                    AddonsState.addon-group-form-min = g.min-select;
                    AddonsState.addon-group-form-max = g.max-select;
                    AddonsState.addon-group-form-error = "";
                    root.modal-type = "addon-group";
                    root.show-modal = true;
                }
                request-delete-group(id, name) => {
                    root.delete-target-id = id; root.delete-target-name = name;
                    root.delete-target-type = "addon-group"; root.show-delete-confirm = true;
                }
                select-group(id) => { AddonsState.select-addon-group(id); }
                request-new-addon => {
                    AddonsState.addon-form-id = "";
                    AddonsState.addon-form-name = "";
                    AddonsState.addon-form-price = "";
                    AddonsState.addon-form-error = "";
                    root.modal-type = "addon"; root.show-modal = true;
                }
                request-edit-addon(a) => {
                    AddonsState.addon-form-id = a.id;
                    AddonsState.addon-form-name = a.name;
                    AddonsState.addon-form-price = a.price;
                    AddonsState.addon-form-error = "";
                    root.modal-type = "addon"; root.show-modal = true;
                }
                request-delete-addon(id, name) => {
                    root.delete-target-id = id; root.delete-target-name = name;
                    root.delete-target-type = "addon"; root.show-delete-confirm = true;
                }
                toggle-addon-active(id) => { AddonsState.toggle-addon-active(id); }
            }

            // Banners (Fase 7) — apenas lista + botão de novo banner.
            // Cadastro/edição abrem o `BannerModal` (instanciado abaixo
            // junto com os demais modais globais).
            if root.active-tab == "banners": BannersPage {
                banners: BannersState.banners;
                banners-active-count: BannersState.banners-active-count;
                banners-inactive-count: BannersState.banners-inactive-count;
                request-new => {
                    root.editing-id = "";
                    BannersState.banner-title = "";
                    BannersState.banner-item-type = "product";
                    BannersState.banner-product-id = ""; BannersState.banner-product-name = "";
                    BannersState.banner-product-search = "";
                    BannersState.banner-url = "";
                    BannersState.banner-image-data = "";
                    BannersState.banner-error-title = ""; BannersState.banner-error-image = ""; BannersState.banner-error-target = "";
                    root.modal-type = "banner"; root.show-modal = true;
                }
                request-edit(b) => {
                    root.editing-id = b.id;
                    BannersState.banner-title = b.title;
                    BannersState.banner-item-type = b.item-type;
                    BannersState.banner-product-id = b.item-id; BannersState.banner-product-name = b.item-name;
                    BannersState.banner-product-search = "";
                    BannersState.banner-url = b.item-url;
                    BannersState.banner-image-data = b.image-data;
                    BannersState.banner-error-title = ""; BannersState.banner-error-image = ""; BannersState.banner-error-target = "";
                    root.modal-type = "banner"; root.show-modal = true;
                }
                toggle-banner-active(id) => { BannersState.toggle-banner-active(id); }
                delete-banner(id) => {
                    root.delete-target-id = id; root.delete-target-name = "este banner";
                    root.delete-target-type = "banner"; root.show-delete-confirm = true;
                }
            }

            // Cupons (Fase 8) — lista + botão de novo cupom.
            // Cadastro/edição abrem o `CouponModal` (instanciado abaixo).
            if root.active-tab == "coupons": CouponsPage {
                coupons: CouponsState.coupons;
                coupons-active-count: CouponsState.coupons-active-count;
                coupons-inactive-count: CouponsState.coupons-inactive-count;
                request-new => {
                    root.editing-id = "";
                    CouponsState.coupon-title = "";
                    CouponsState.coupon-code = "";
                    CouponsState.coupon-type = "standard";
                    CouponsState.coupon-discount-kind = "fixed";
                    CouponsState.coupon-discount-value = "";
                    CouponsState.coupon-min-order = "";
                    CouponsState.coupon-max-discount = "";
                    CouponsState.coupon-per-user-limit = "";
                    CouponsState.coupon-usage-limit = "";
                    CouponsState.coupon-valid-from = "";
                    CouponsState.coupon-valid-until = "";
                    CouponsState.coupon-error-title = ""; CouponsState.coupon-error-code = "";
                    CouponsState.coupon-error-discount = ""; CouponsState.coupon-error-validity = "";
                    CouponsState.coupon-error-min = ""; CouponsState.coupon-error-per-user = ""; CouponsState.coupon-error-usage = "";
                    root.modal-type = "coupon"; root.show-modal = true;
                }
                request-edit(c) => {
                    root.editing-id = c.id;
                    CouponsState.coupon-title = c.title;
                    CouponsState.coupon-code = c.code;
                    CouponsState.coupon-type = c.coupon-type;
                    CouponsState.coupon-discount-kind = c.discount-kind;
                    CouponsState.coupon-discount-value = c.discount-value;
                    CouponsState.coupon-min-order = c.min-order-value;
                    CouponsState.coupon-max-discount = c.max-discount;
                    CouponsState.coupon-per-user-limit = c.per-user-limit;
                    CouponsState.coupon-usage-limit = c.usage-limit;
                    CouponsState.coupon-valid-from = c.valid-from;
                    CouponsState.coupon-valid-until = c.valid-until;
                    CouponsState.coupon-error-title = ""; CouponsState.coupon-error-code = "";
                    CouponsState.coupon-error-discount = ""; CouponsState.coupon-error-validity = "";
                    CouponsState.coupon-error-min = ""; CouponsState.coupon-error-per-user = ""; CouponsState.coupon-error-usage = "";
                    root.modal-type = "coupon"; root.show-modal = true;
                }
                toggle-coupon-active(id) => { CouponsState.toggle-coupon-active(id); }
                delete-coupon(id) => {
                    root.delete-target-id = id; root.delete-target-name = "este cupom";
                    root.delete-target-type = "coupon"; root.show-delete-confirm = true;
                }
            }

            // Clientes
            if root.active-tab == "customers": CustomersPage {
                customers: CustomersState.customers;
                selected-customer-id: CustomersState.selected-customer-id;
                detail-customer: CustomersState.detail-customer;
                detail-recent-orders: CustomersState.detail-recent-orders;
                detail-addresses: CustomersState.detail-addresses;
                search-changed(q) => { CustomersState.filter-customers(q); }
                select-customer(id) => { CustomersState.select-customer(id); }
                open-order(id) => { root.active-tab = "orders"; OrdersState.open-order(id); }
                request-new => {
                    root.editing-id = ""; CustomersState.customer-name = "";
                    CustomersState.customer-email = ""; CustomersState.customer-phone = "";
                    CustomersState.customer-document = ""; CustomersState.customer-notes = "";
                    CustomersState.customer-avatar-initial = "?";
                    CustomersState.customer-error-name = ""; CustomersState.customer-error-email = "";
                    CustomersState.customer-error-phone = ""; CustomersState.customer-error-document = ""; root.show-modal = true;
                }
                request-edit(c) => {
                    root.editing-id = c.id; CustomersState.customer-name = c.name;
                    CustomersState.customer-email = c.email; CustomersState.customer-phone = c.phone;
                    CustomersState.customer-document = c.document; CustomersState.customer-profile-picture = c.profile-picture;
                    CustomersState.customer-avatar-initial = c.avatar-initial;
                    CustomersState.customer-notes = c.notes;
                    CustomersState.customer-error-name = ""; CustomersState.customer-error-email = ""; CustomersState.customer-error-phone = ""; CustomersState.customer-error-document = "";
                    root.show-modal = true;
                }
                request-delete(id, name, type) => {
                    root.delete-target-id = id; root.delete-target-name = name;
                    root.delete-target-type = type; root.show-delete-confirm = true;
                }
                // Novo pedido: abre o PDV já com o cliente selecionado.
                new-order(id) => { root.active-tab = "pdv"; PdvUiState.pdv-pick-customer(id); }
                // ── Carteira ──
                wallet-summary: WalletState.wallet-summary;
                wallet-movements: WalletState.wallet-movements;
                wallet-open-deposit => { WalletState.wallet-open-deposit(); }
                wallet-open-withdraw => { WalletState.wallet-open-withdraw(); }
                wallet-open-adjust => { WalletState.wallet-open-adjust(); }
                wallet-open-limit => { WalletState.wallet-open-limit(); }
                wallet-open-wallet => { WalletState.wallet-confirm-open(); }
            }

            // PDV vive FORA deste ScrollView (irmão direto do
            // HorizontalLayout com Sidebar). Motivo arquitetural: o
            // ScrollView mede o conteúdo pela altura natural — não
            // estica filhos verticalmente. Resultado: o cart Rectangle
            // dentro do PdvPage ficava no tamanho dos próprios filhos
            // e o footer "Subtotal..Limpar" não colava na borda
            // inferior. Renderizado lá fora, PdvPage recebe a altura
            // total da janela direto do HorizontalLayout pai.

            // Caixa
            if root.active-tab == "cash": CashPage {
                summary: CashState.cash-summary;
                sessions: CashState.cash-sessions;
                movements: CashState.cash-movements;
                method-totals: CashState.cash-method-totals;
                request-open => { CashState.cash-show-open = true; }
                request-sangria => { CashState.cash-show-sangria = true; }
                request-suprimento => { CashState.cash-show-suprimento = true; }
                request-close => {
                    CashState.cash-show-close = true;
                    CashState.cash-close-recalc();
                }
            }

            // Dashboard
            if root.active-tab == "dashboard": DashboardPage {
                kpis: DashboardState.dashboard-kpis;
                sales-bars: DashboardState.dashboard-sales-bars;
                compare-points: DashboardState.dashboard-compare-points;
                compare-label: DashboardState.dashboard-compare-label;
                top-products: DashboardState.dashboard-top-products;
                payment-slices: DashboardState.dashboard-payment-slices;
                subtitle: DashboardState.dashboard-subtitle;
                week-revenue: DashboardState.dashboard-week-revenue;
                week-revenue-label: DashboardState.dashboard-week-revenue-label;
                week-delta: DashboardState.dashboard-week-delta;
                week-delta-tone: DashboardState.dashboard-week-delta-tone;
                week-has-chart: DashboardState.dashboard-week-has-chart;
                week-orders: DashboardState.dashboard-week-orders;
                week-ticket: DashboardState.dashboard-week-ticket;
                week-best-day: DashboardState.dashboard-week-best-day;
                week-line-path: DashboardState.dashboard-week-line-path;
                week-area-path: DashboardState.dashboard-week-area-path;
                line-points: DashboardState.dashboard-line-points;
                payment-total: DashboardState.dashboard-payment-total;
                period: DashboardState.dashboard-period;
                period-changed(p) => {
                    DashboardState.dashboard-period = p;
                    DashboardState.dashboard-refresh();
                }
            }

            // Relatórios
            if root.active-tab == "reports": ReportsPage {
                types: ReportsState.report-types;
                periods: ReportsState.report-periods;
                kpis: ReportsState.report-kpis;
                active-type: ReportsState.report-active-type;
                header-title: ReportsState.report-header-title;
                header-subtitle: ReportsState.report-header-subtitle;
                chart-title: ReportsState.report-chart-title;
                chart-subtitle: ReportsState.report-chart-subtitle;
                daily-bars: ReportsState.report-daily-bars;
                dre-lines: ReportsState.report-dre-lines;
                method-bars: ReportsState.report-method-bars;
                method-total: ReportsState.report-method-total;
                orders-bars: ReportsState.report-orders-bars;
                channel-bars: ReportsState.report-channel-bars;
                hourly-bars: ReportsState.report-hourly-bars;
                top-products: ReportsState.report-top-products;
                top-customers: ReportsState.report-top-customers;
                new-vs-ret: ReportsState.report-new-vs-ret;
                stock-rows: ReportsState.report-stock-rows;
                stock-kind <=> ReportsState.report-stock-kind;
                stock-search <=> ReportsState.report-stock-search;
                set-type(k) => { ReportsState.report-set-type(k); }
                set-period(k) => { ReportsState.report-set-period(k); }
                set-stock-kind(k) => { ReportsState.report-set-stock-kind(k); }
                set-stock-search(q) => { ReportsState.report-set-stock-search(q); }
                export-report => { ReportsState.report-export(); }
            }

            // Assinatura (Fase 13 — Plano & cobrança).
            if root.active-tab == "subscription": SubscriptionPage {
                data: SubscriptionState.subscription-data;
                plans: SubscriptionState.subscription-plans;
                invoices: SubscriptionState.subscription-invoices;
                payment-methods: SubscriptionState.payment-methods;
                payment-picker-open: SubscriptionState.payment-picker-open;
                choose-plan(k) => { SubscriptionState.subscription-choose-plan(k); }
                open-payment-change => { SubscriptionState.subscription-toggle-payment-picker(); }
                pick-payment-method(id) => { SubscriptionState.subscription-pick-payment-method(id); }
                download-invoice(id) => { SubscriptionState.subscription-download-invoice(id); }
                download-all => { SubscriptionState.subscription-download-all(); }
                open-invoice-id: SubscriptionState.subscription-open-invoice-id;
                open-invoice-amount: SubscriptionState.subscription-open-invoice-amount;
                open-invoice-label: SubscriptionState.subscription-open-invoice-label;
                open-invoice-overdue: SubscriptionState.subscription-open-invoice-overdue;
                pay-invoice(id) => { SubscriptionState.subscription-pay-invoice(id); }
                open-card-modal => { SubscriptionState.card-modal-open = true; }
                cancel-card => { SubscriptionState.subscription-cancel-card(); }
                open-pix-auto => { SubscriptionState.subscription-open-pix-auto(); }
                cancel-pix-auto => { SubscriptionState.subscription-cancel-pix-auto(); }
            }

            // Financeiro — contas a pagar/receber.
            if root.active-tab == "treasury": TreasuryPage {
                summary: TreasuryState.treasury-summary;
                movements: TreasuryState.treasury-movements;
                chart: TreasuryState.treasury-chart;
                breakdown-in: TreasuryState.treasury-breakdown-in;
                breakdown-out: TreasuryState.treasury-breakdown-out;
                initial-input <=> TreasuryState.treasury-initial-input;
                notes-input <=> TreasuryState.treasury-notes-input;
                setup-error: TreasuryState.treasury-setup-error;
                refresh => { TreasuryState.treasury-refresh(); }
                open-treasury => { TreasuryState.treasury-open(); }
                open-deposit => { TreasuryState.treasury-open-modal("deposit"); }
                open-withdraw => { TreasuryState.treasury-open-modal("withdraw"); }
                open-goal => { TreasuryState.treasury-open-modal("goal"); }
            }
            if root.active-tab == "finance": FinancePage {
                kpis: FinanceState.finance-kpis;
                tabs: FinanceState.finance-tabs;
                entries: FinanceState.finance-entries;
                cash-flow: FinanceState.finance-cash-flow;
                cash-flow-summary: FinanceState.finance-cash-flow-summary;
                active-tab: FinanceState.finance-active-tab;
                search-query <=> FinanceState.finance-search-query;
                view-mode: FinanceState.finance-view-mode;
                cal-title: FinanceState.finance-cal-title;
                cal-month-total: FinanceState.finance-cal-month-total;
                cal-cells: FinanceState.finance-cal-cells;
                cal-selected: FinanceState.finance-cal-selected;
                cal-detail-header: FinanceState.finance-cal-detail-header;
                cal-detail-summary: FinanceState.finance-cal-detail-summary;
                cal-detail-rows: FinanceState.finance-cal-detail-rows;
                status-filter: FinanceState.finance-status-filter;
                set-tab(k) => { FinanceState.finance-set-tab(k); }
                search-changed(q) => { FinanceState.finance-search-changed(q); }
                set-status-filter(k) => { FinanceState.finance-set-status-filter(k); }
                set-group-page(s, p) => { FinanceState.finance-set-group-page(s, p); }
                open-new(k) => { FinanceState.finance-open-new(k); }
                open-edit(id) => { FinanceState.finance-open-edit(id); }
                mark-settled(id) => { FinanceState.finance-request-settle(id); }
                request-delete(id) => { FinanceState.finance-request-delete(id); }
                set-view(m) => { FinanceState.finance-set-view(m); }
                cal-prev => { FinanceState.finance-cal-prev(); }
                cal-next => { FinanceState.finance-cal-next(); }
                cal-today => { FinanceState.finance-cal-today(); }
                cal-select-day(day) => { FinanceState.finance-cal-select-day(day); }
