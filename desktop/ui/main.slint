        confirm-delete => { root.confirm-delete(); }
    }

    if PdvUiState.pdv-show-customer-picker: PdvCustomerPickerModal {
        rows: PdvUiState.pdv-customer-rows;
        search <=> PdvUiState.pdv-customer-search;
        close => { PdvUiState.pdv-show-customer-picker = false; }
        search-changed(q) => { PdvUiState.pdv-customer-search-changed(q); }
        pick(id) => { PdvUiState.pdv-pick-customer(id); }
    }

    if PdvUiState.pdv-show-cart-modal: PdvCartModal {
        cart: PdvUiState.pdv-cart;
        total-display: PdvUiState.pdv-total-display;
        inc(id) => { PdvUiState.pdv-inc-line(id); }
        dec(id) => { PdvUiState.pdv-dec-line(id); }
