        save => { FinanceState.finance-save-modal(); }
        set-recurrence(k) => { FinanceState.finance-set-recurrence(k); }
        set-installments(n) => { FinanceState.finance-set-installments(n); }
        open-party-picker => { FinanceState.finance-open-party-picker(); }
        clear-party => { FinanceState.finance-pick-party(""); }
        toggle-due-cal => { FinanceState.finance-due-cal-toggle(); }
    }

    // Pop-up do calendário de vencimento (sobreposto ao modal).
    if FinanceState.finance-show-modal && FinanceState.finance-due-cal-open: CalendarPopup {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        title: FinanceState.finance-due-cal-title;
        days: FinanceState.finance-due-cal-days;
        prev => { FinanceState.finance-due-cal-prev(); }
        next => { FinanceState.finance-due-cal-next(); }
        pick(d) => { FinanceState.finance-due-cal-pick(d); }
        clear => { FinanceState.finance-due-cal-pick(""); }
        close => { FinanceState.finance-due-cal-toggle(); }
    }

    // Pop-up do picker de cliente/fornecedor (sobreposto ao modal).
    if FinanceState.finance-show-modal && FinanceState.finance-show-party-picker: PdvCustomerPickerModal {
        rows: FinanceState.finance-party-options;
        search <=> FinanceState.finance-party-search;
        search-changed(q) => { FinanceState.finance-party-search-changed(q); }
        pick(id) => { FinanceState.finance-pick-party(id); }
        close => { FinanceState.finance-close-party-picker(); }
    }

    // ── Modal de confirmação: dar baixa (Receber/Pagar) ──────
    if FinanceState.finance-show-settle-confirm: Rectangle {
        background: #00000080;
        TouchArea { clicked => { FinanceState.finance-close-settle-confirm(); } }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 420px;
                    // Contas a receber ganham VALOR + forma de pagamento.
                    height: FinanceState.finance-settle-target-kind == "receivable" ? 396px : 240px;
                    border-radius: 12px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    drop-shadow-blur: 12px;
                    drop-shadow-offset-y: 0px;
                    drop-shadow-color: Theme.card-shadow;
                    // Absorve cliques dentro do card.
                    TouchArea { }
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        // Conteúdo centralizado verticalmente dentro do
                        // card de altura fixa.
                        alignment: center;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: FinanceState.finance-settle-target-kind == "receivable"
                                    ? "Confirmar Recebimento"
                                    : "Confirmar Pagamento";
                                font-size: 16px; font-weight: 700;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: FinanceState.finance-settle-target-kind == "receivable"
                                    ? "O lançamento será marcado como Recebido."
                                    : "O lançamento será marcado como Pago.";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                            }
                        }
                        Rectangle {
                            background: Theme.bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.card-border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                HorizontalLayout {
                                    Text {
                                        horizontal-stretch: 1;
                                        text: FinanceState.finance-settle-target-desc;
                                        font-size: 13px; font-weight: 700;
                                        color: Theme.text-primary;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: FinanceState.finance-settle-target-amount;
                                        font-size: 14px; font-weight: 800;
                                        color: FinanceState.finance-settle-target-kind == "receivable"
                                            ? #2E7D32 : #E53935;
                                    }
                                }
                                if FinanceState.finance-settle-target-party != "": Text {
                                    text: FinanceState.finance-settle-target-party;
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                        // Valor recebido — obrigatório; abre pré-
                        // preenchido com o valor da conta e selecionado
                        // (digite para substituir). Menor abate; maior
                        // quita e o excesso vira saldo (fiado).
                        if FinanceState.finance-settle-target-kind == "receivable": VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "VALOR RECEBIDO";
                                font-size: 11px; font-weight: 700;
                                color: Theme.text-secondary;
                                letter-spacing: 0.5px;
                            }
                            Rectangle {
                                height: 40px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: settle-amount-in.has-focus ? Theme.primary : Theme.border;
                                background: Theme.surface;
                                settle-amount-in := TextInput {
                                    x: 12px; y: 0;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    text <=> FinanceState.finance-settle-amount-input;
                                    font-size: 14px; font-weight: 700;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    single-line: true;
                                }
                                // Foca e seleciona tudo ao abrir.
                                Timer {
                                    interval: 1ms; running: true;
                                    triggered => {
                                        settle-amount-in.focus();
                                        settle-amount-in.select-all();
                                        self.running = false;
                                    }
                                }
                            }
                        }
                        // Forma de pagamento do recebimento — entra no
                        // caixa com a forma escolhida.
                        if FinanceState.finance-settle-target-kind == "receivable": VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "FORMA DE PAGAMENTO";
                                font-size: 11px; font-weight: 700;
                                color: Theme.text-secondary;
                                letter-spacing: 0.5px;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                for opt[smi] in [
                                    { value: "cash",   label: "Dinheiro" },
                                    { value: "credit", label: "Crédito" },
                                    { value: "debit",  label: "Débito" },
                                    { value: "pix",    label: "Pix" },
                                ]: settle-pm-ta := TouchArea {
                                    horizontal-stretch: 1; min-width: 0; height: 32px;
                                    clicked => { FinanceState.finance-settle-method = opt.value; }
                                    Rectangle {
                                        border-radius: 6px;
                                        border-width: FinanceState.finance-settle-method == opt.value ? 1.5px : 1px;
                                        border-color: FinanceState.finance-settle-method == opt.value ? Theme.btn-accent : Theme.border;
                                        background: FinanceState.finance-settle-method == opt.value
                                            ? Theme.btn-accent.transparentize(0.88)
                                            : (settle-pm-ta.has-hover ? Theme.row-hover : Theme.surface);
                                        Text {
                                            width: parent.width; height: parent.height;
                                            text: opt.label;
                                            font-size: 11px; font-weight: 600;
                                            color: FinanceState.finance-settle-method == opt.value ? Theme.btn-accent : Theme.text-primary;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            cancel-ta := TouchArea {
                                width: 100px; height: 32px;
                                clicked => { FinanceState.finance-close-settle-confirm(); }
                                Rectangle {
                                    border-radius: 8px;
                                    // Cancelar = neutro (borda/texto cinza, sem fundo).
                                    border-width: 1px;
                                    border-color: Theme.text-secondary;
                                    background: cancel-ta.has-hover ? Theme.row-hover : transparent;
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: "Cancelar";
                                        font-size: 13px; font-weight: 700;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            confirm-ta := TouchArea {
                                width: 140px; height: 32px;
                                clicked => { FinanceState.finance-confirm-settle(); }
                                Rectangle {
                                    border-radius: 8px;
                                    background: confirm-ta.has-hover ? Theme.primary-dark : Theme.primary;
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: FinanceState.finance-settle-target-kind == "receivable"
                                            ? "Confirmar"
                                            : "Confirmar";
                                        font-size: 12px; font-weight: 700;
                                        color: white;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Modal de confirmação: excluir lançamento ─────────────
    if FinanceState.finance-show-delete-confirm: Rectangle {
        background: #00000080;
        TouchArea { clicked => { FinanceState.finance-close-delete-confirm(); } }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 420px;
                    height: 240px;
                    border-radius: 12px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    drop-shadow-blur: 12px;
                    drop-shadow-offset-y: 0px;
                    drop-shadow-color: Theme.card-shadow;
                    TouchArea { }
                    VerticalLayout {
                        padding: 22px;
                        spacing: 14px;
                        alignment: center;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Excluir Lançamento";
                                font-size: 16px; font-weight: 700;
                                color: Theme.text-primary;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Este lançamento será removido. Esta ação não pode ser desfeita.";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle {
                            background: Theme.bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.card-border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                HorizontalLayout {
                                    Text {
                                        horizontal-stretch: 1;
                                        text: FinanceState.finance-delete-target-desc;
                                        font-size: 13px; font-weight: 700;
                                        color: Theme.text-primary;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: FinanceState.finance-delete-target-amount;
                                        font-size: 14px; font-weight: 800;
                                        color: FinanceState.finance-delete-target-kind == "receivable"
                                            ? #2E7D32 : #E53935;
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: end;
                            del-cancel-ta := TouchArea {
                                width: 100px; height: 32px;
                                clicked => { FinanceState.finance-close-delete-confirm(); }
                                Rectangle {
                                    border-radius: 8px;
                                    // Cancelar = neutro (borda/texto cinza, sem fundo).
                                    border-width: 1px;
                                    border-color: Theme.text-secondary;
                                    background: del-cancel-ta.has-hover ? Theme.row-hover : transparent;
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: "Cancelar";
                                        font-size: 13px; font-weight: 700;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                            del-confirm-ta := TouchArea {
                                width: 140px; height: 32px;
                                clicked => { FinanceState.finance-confirm-delete(); }
                                Rectangle {
                                    border-radius: 8px;
                                    background: del-confirm-ta.has-hover ? #B71C1C : #E53935;
                                    Text {
                                        width: parent.width; height: parent.height;
                                        text: "Excluir";
                                        font-size: 13px; font-weight: 700;
                                        color: white;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Modais da carteira do cliente ────────────────────────
    if WalletState.wallet-show-deposit: WalletDepositModal {
        amount <=> WalletState.wallet-form-amount;
        notes <=> WalletState.wallet-form-notes;
        error: WalletState.wallet-form-error;
        close => { WalletState.wallet-close-modals(); }
        confirm => { WalletState.wallet-confirm-deposit(); }
    }
    if WalletState.wallet-show-withdraw: WalletWithdrawModal {
        amount <=> WalletState.wallet-form-amount;
        notes <=> WalletState.wallet-form-notes;
        error: WalletState.wallet-form-error;
        close => { WalletState.wallet-close-modals(); }
        confirm => { WalletState.wallet-confirm-withdraw(); }
    }
    if WalletState.wallet-show-adjust: WalletAdjustModal {
        amount <=> WalletState.wallet-form-amount;
        notes <=> WalletState.wallet-form-notes;
        error: WalletState.wallet-form-error;
        close => { WalletState.wallet-close-modals(); }
        confirm => { WalletState.wallet-confirm-adjust(); }
    }
    if WalletState.wallet-show-limit: WalletLimitModal {
        amount <=> WalletState.wallet-form-limit;
        notes <=> WalletState.wallet-form-notes;
        error: WalletState.wallet-form-error;
        close => { WalletState.wallet-close-modals(); }
        confirm => { WalletState.wallet-confirm-limit(); }
    }

    if CashState.cash-show-open: CashOpenModal {
        operator-label: CashState.cash-open-operator;
        suggested-display: CashState.cash-open-suggested;
        amount-input <=> CashState.cash-open-amount;
        notes-input <=> CashState.cash-open-notes;
        close => { CashState.cash-show-open = false; }
        confirm => { CashState.cash-open-confirm(); }
    }
    if CashState.cash-show-sangria: CashSangriaModal {
        cash-now-display: CashState.cash-summary.cash-now-display;
        amount-input <=> CashState.cash-sangria-amount;
        reason-selected <=> CashState.cash-sangria-reason;
        detail-input <=> CashState.cash-sangria-detail;
        close => { CashState.cash-show-sangria = false; }
        confirm => { CashState.cash-sangria-confirm(); }
    }
    if CashState.cash-show-suprimento: CashSuprimentoModal {
        cash-now-display: CashState.cash-summary.cash-now-display;
        amount-input <=> CashState.cash-suprimento-amount;
        origin-selected <=> CashState.cash-suprimento-origin;
        detail-input <=> CashState.cash-suprimento-detail;
        close => { CashState.cash-show-suprimento = false; }
        confirm => { CashState.cash-suprimento-confirm(); }
    }
    if CashState.cash-show-close: CashCloseModal {
        opened-at-display: CashState.cash-close-opened-at;
        duration-display: CashState.cash-close-duration;
        operator-label: CashState.cash-close-operator;
        sys-cash-display: CashState.cash-close-sys-cash;
        sys-pix-display: CashState.cash-close-sys-pix;
        sys-credit-display: CashState.cash-close-sys-credit;
        sys-debit-display: CashState.cash-close-sys-debit;
        sys-total-display: CashState.cash-close-sys-total;
        sales-cash-count: CashState.cash-close-cash-count;
        sales-pix-count: CashState.cash-close-pix-count;
        sales-credit-count: CashState.cash-close-credit-count;
        sales-debit-count: CashState.cash-close-debit-count;
        in-cash <=> CashState.cash-close-in-cash;
        in-pix <=> CashState.cash-close-in-pix;
        in-credit <=> CashState.cash-close-in-credit;
        in-debit <=> CashState.cash-close-in-debit;
        notes <=> CashState.cash-close-notes;
        diff-cash-display: CashState.cash-close-diff-cash;
        diff-pix-display: CashState.cash-close-diff-pix;
        diff-credit-display: CashState.cash-close-diff-credit;
        diff-debit-display: CashState.cash-close-diff-debit;
        diff-total-display: CashState.cash-close-diff-total;
        has-diff: CashState.cash-close-has-diff;
        in-total-display: CashState.cash-close-in-total;
        close => { CashState.cash-show-close = false; }
        recalc => { CashState.cash-close-recalc(); }
        confirm => { CashState.cash-close-confirm(); }
    }

    // Modal de ajuste de estoque (Controle de Estoque)
    if InventoryState.stock-adjust-show: StockAdjustModal {
        mode: InventoryState.stock-adjust-mode;
        direction <=> InventoryState.stock-adjust-direction;
        product-name: InventoryState.stock-adjust-product-name;
        current-display: InventoryState.stock-adjust-current;
        qty-input <=> InventoryState.stock-adjust-qty;
        reason-input <=> InventoryState.stock-adjust-reason;
        error-message: InventoryState.stock-adjust-error;
        close => { InventoryState.stock-adjust-show = false; InventoryState.stock-adjust-error = ""; }
        confirm => { InventoryState.inventory-confirm-adjust(); }
    }

    // PDV bloqueado por caixa fechado: implementado como PÁGINA
    // (PdvBlockedView) que substitui o PdvPage acima, não como modal
    // overlay. Overlay top-level mountado em conjunto com mudança de
    // aba causava panic "Recursion detected" no layout do Slint.

    if PrintersState.show-printer-modal: PrinterModal {
        editing-id <=> PrintersState.printer-editing-id;
        printer-name <=> PrintersState.printer-form-name;
        printer-kind <=> PrintersState.printer-form-kind;
        printer-system-name <=> PrintersState.printer-form-system-name;
        printer-is-default <=> PrintersState.printer-form-is-default;
        printer-paper-width <=> PrintersState.printer-form-paper-width;
        printer-error: PrintersState.printer-form-error;
        available-list: PrintersState.printer-available-list;
        categories <=> PrintersState.printer-form-categories;
        close => { PrintersState.show-printer-modal = false; }
        save => { PrintersState.printer-save(); }
        test-print => { PrintersState.printer-test-print(); }
        refresh-available => { PrintersState.refresh-available-printers(); }
    }

    // Alarme de novos pedidos — instanciado por ÚLTIMO entre os
    // modais globais para garantir z-order acima de qualquer outro
    // overlay (sobrepõe edit-order/configurador/comanda etc.).
    if root.alarm-visible: NewOrderAlarmModal {
        pending-count: root.alarm-pending-count;
        acknowledge => { root.alarm-acknowledge(); }
        dismiss => { root.alarm-dismiss(); }
    }

    // ════════════════════════════════════════════════
    //  MODAL DE ATUALIZAÇÃO (overlay global)
    // ════════════════════════════════════════════════
    if root.update-available: UpdateModal {
        version: root.update-version;
        notes: root.update-notes;
        mandatory: root.update-mandatory;
        status: root.update-status;
        error: root.update-error;
        update-now => { root.apply-update(); }
        download-manual => { root.open-update-url(); }
        later => { root.update-available = false; }
    }

    // ════════════════════════════════════════════════
    //  TOAST NOTIFICATION
    // ════════════════════════════════════════════════
    toast-el := Toast {
        x: root.width - toast-el.hint-width - 16px;
        y: root.height - self.height - 16px;
        width: toast-el.hint-width;
        height: 44px;
        opacity: root.toast-visible ? 1.0 : 0.0;
        animate opacity { duration: 250ms; easing: ease; }
        message: root.toast-message;
        toast-type: root.toast-type;
    }
}
