                filter-changed(k) => { InventoryState.inventory-filter-changed(k); }
                type-filter-changed(k) => { InventoryState.inventory-type-filter-changed(k); }
                refresh => { InventoryState.inventory-refresh(); }
                sync => { InventoryState.inventory-sync(); }
                request-add-stock(id) => { InventoryState.inventory-request-add(id); }
                request-consume-stock(id) => { InventoryState.inventory-request-consume(id); }
            }

            // Pedidos
            if root.active-tab == "orders": OrdersPage {
                orders: OrdersState.orders;
                kanban-cols: OrdersState.kanban-cols;
                order-search-query <=> OrdersState.order-search-query;
                order-date-start <=> OrdersState.order-date-start;
                order-date-label <=> OrdersState.order-date-label;
                cal-open <=> OrdersState.cal-open;
                cal-toggle => { OrdersState.cal-toggle(); }
                cal-clear => { OrdersState.cal-clear(); }
                order-filter-status <=> OrdersState.order-filter-status;
                order-detail-id <=> OrdersState.order-detail-id;
                detail-order: OrdersState.detail-order;
                detail-order-items: OrdersState.detail-order-items;
                orders-per-page: SettingsState.orders-per-page;
                open-order(id) => { OrdersState.open-order(id); }
                advance-order-status(id) => { OrdersState.advance-order-status(id); }
                set-payment(id, m, p) => { OrdersState.order-set-payment(id, m, p); }
                refresh-orders => { OrdersState.refresh-orders(); }
                refresh-order-elapsed => { OrdersState.refresh-order-elapsed(); }
                edit-order(id) => { OrdersState.edit-order(id); }
                // Cliques "Comanda" / "Cozinha" no detalhe abrem o
                // modal de preview interno (não navegador). O HTML +
                // impressão real só acontece via botão "Imprimir" do
                // próprio modal.
                print-order-receipt(_) => { OrdersState.receipt-modal-mode = "complete"; }
                print-order-kitchen(_) => { OrdersState.receipt-modal-mode = "kitchen"; }
                request-cancel(id, label) => {
                    OrdersState.cancel-target-id = id; OrdersState.cancel-target-label = label;
                    OrdersState.cancel-reason = ""; OrdersState.cancel-error = "";
                    OrdersState.show-cancel-modal = true;
                }
