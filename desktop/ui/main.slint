            // Configuracoes
            if root.active-tab == "settings": SettingsPage {
                business-hours: SettingsState.business-hours;
                store-override <=> SettingsState.store-override;
                store-name <=> SettingsState.store-name;
                store-address <=> SettingsState.store-address;
                store-phone <=> SettingsState.store-phone;
                store-whatsapp <=> SettingsState.store-whatsapp;
                store-email <=> SettingsState.store-email;
                store-instagram <=> SettingsState.store-instagram;
                store-document <=> SettingsState.store-document;
                store-neighborhood <=> SettingsState.store-neighborhood;
                store-zip-code <=> SettingsState.store-zip-code;
                store-city <=> SettingsState.store-city;
                store-uf <=> SettingsState.store-uf;
                store-logo-data <=> SettingsState.store-logo-data;
                store-logo-image: SettingsState.store-logo-image;
                store-logo-loading <=> SettingsState.store-logo-loading;
                store-cover-data <=> SettingsState.store-cover-data;
                store-cover-image: SettingsState.store-cover-image;
                store-cover-loading <=> SettingsState.store-cover-loading;
                store-synced: SettingsState.store-synced;
                products-per-page <=> SettingsState.products-per-page;
                orders-per-page <=> SettingsState.orders-per-page;
                store-delivery-fee <=> SettingsState.store-delivery-fee;
                store-site-palette <=> SettingsState.store-site-palette;
                set-store-override(v) => { SettingsState.set-store-override(v); }
                save-store-info => { SettingsState.save-store-info(); }
                pick-store-logo => { SettingsState.pick-store-logo(); }
                pick-store-cover => { SettingsState.pick-store-cover(); }
                format-store-phone(t) => { SettingsState.format-store-phone(t) }
                format-store-document(t) => { SettingsState.format-store-document(t) }
                format-store-zip(t) => { SettingsState.format-store-zip(t) }
                request-edit-bh(bh) => {
                    SettingsState.bh-editing-day = bh.day-of-week;
                    SettingsState.bh-editing-day-name = bh.day-name;
                    SettingsState.bh-open-time = bh.open-time;
                    SettingsState.bh-close-time = bh.close-time;
                    SettingsState.bh-is-open = bh.is-open;
                    root.modal-type = "business-hours";
                    root.show-modal = true;
                }
                // Impressoras
                printers: PrintersState.printers;
                refresh-printers => { PrintersState.refresh-printers(); }
                request-new-printer => {
                    PrintersState.printer-editing-id = "";
                    PrintersState.printer-form-name = "";
                    PrintersState.printer-form-kind = "order";
                    PrintersState.printer-form-system-name = "";
                    PrintersState.printer-form-is-default = false;
                    PrintersState.printer-form-paper-width = 80;
                    PrintersState.printer-form-error = "";
                    // Lista vazia → todas as categorias começam desmarcadas
                    // (UI fica em modo "catch-all" até o operador selecionar).
                    PrintersState.load-printer-categories([]);
                    PrintersState.refresh-available-printers();
                    PrintersState.show-printer-modal = true;
                }
                request-edit-printer(p) => {
                    PrintersState.printer-editing-id = p.id;
                    PrintersState.printer-form-name = p.name;
                    PrintersState.printer-form-kind = p.kind;
                    PrintersState.printer-form-system-name = p.system-name;
                    PrintersState.printer-form-is-default = p.is-default;
                    PrintersState.printer-form-paper-width = p.paper-width;
                    PrintersState.printer-form-error = "";
                    PrintersState.load-printer-categories(p.category-ids);
                    PrintersState.refresh-available-printers();
                    PrintersState.show-printer-modal = true;
                }
                delete-printer(id) => { PrintersState.printer-delete(id); }
                set-default-printer(id) => { PrintersState.printer-set-default(id); }
                }
            }
        }
    }
    }

    // ════════════════════════════════════════════════
    //  MODAIS (overlays sobre tudo)
    // ════════════════════════════════════════════════

    if root.show-modal && root.active-tab == "categories" && root.modal-type == "category": CategoryModal {
        editing-id <=> root.editing-id;
        category-name <=> CategoriesState.category-name;
        category-description <=> CategoriesState.category-description;
        category-error-name <=> CategoriesState.category-error-name;
        category-icon-name <=> CategoriesState.category-icon-name;
        icon-options: CategoriesState.category-icon-options;
        close => { root.show-modal = false; }
        add-category => { CategoriesState.add-category(); }
        update-category => { CategoriesState.update-category(); }
    }

    if root.show-modal && root.active-tab == "categories" && root.modal-type == "subcategory": SubcategoryModal {
        editing-id <=> root.editing-id;
        subcategory-name <=> CategoriesState.subcategory-name;
        subcategory-category-id <=> CategoriesState.subcategory-category-id;
        subcategory-category-name <=> CategoriesState.subcategory-category-name;
        subcategory-category-open <=> CategoriesState.subcategory-category-open;
        subcategory-error-name <=> CategoriesState.subcategory-error-name;
        subcategory-error-category <=> CategoriesState.subcategory-error-category;
        categories: CategoriesState.categories;
        close => { root.show-modal = false; CategoriesState.subcategory-category-open = false; }
        add-subcategory => { CategoriesState.add-subcategory(); }
        update-subcategory => { CategoriesState.update-subcategory(); }
    }

    // Modal de Banner (Fase 7). Form com upload de imagem + busca de
    // produto filtrante. `forward-focus` no Slint dá foco automático
    // na barra de busca assim que o dropdown abre.
    if root.show-modal && root.active-tab == "banners" && root.modal-type == "banner": BannerModal {
        products: ProductsState.products;
        products-filtered: BannersState.banner-product-filtered;
        filter-products => { BannersState.filter-banner-products(); }
        editing-id <=> root.editing-id;
        banner-title <=> BannersState.banner-title;
        banner-item-type <=> BannersState.banner-item-type;
        banner-product-id <=> BannersState.banner-product-id;
        banner-product-name <=> BannersState.banner-product-name;
        banner-product-search <=> BannersState.banner-product-search;
        banner-url <=> BannersState.banner-url;
        banner-image-data <=> BannersState.banner-image-data;
        banner-image <=> BannersState.banner-image;
        banner-image-loading <=> BannersState.banner-image-loading;
        banner-error-title <=> BannersState.banner-error-title;
        banner-error-image <=> BannersState.banner-error-image;
        banner-error-target <=> BannersState.banner-error-target;
        close => { root.show-modal = false; }
        request-pick-image => { BannersState.pick-banner-image(); }
        request-clear-image => { BannersState.banner-image-data = ""; }
        // Não fecha o modal aqui: o Rust valida primeiro e só fecha
        // (set_show_modal(false)) em caso de sucesso. Assim mensagens
        // de erro abaixo dos campos ficam visíveis para o operador.
        add-banner => { BannersState.add-banner(); }
        update-banner => { BannersState.update-banner(); }
    }

    // Modal de Cupom (Fase 8). Não fecha aqui: o Rust valida e só
    // fecha (set_show_modal(false)) em caso de sucesso, mantendo as
    // mensagens de erro visíveis abaixo dos campos.
    if root.show-modal && root.active-tab == "coupons" && root.modal-type == "coupon": CouponModal {
        editing-id <=> root.editing-id;
        coupon-title <=> CouponsState.coupon-title;
        coupon-code <=> CouponsState.coupon-code;
        coupon-type <=> CouponsState.coupon-type;
        coupon-discount-kind <=> CouponsState.coupon-discount-kind;
        coupon-discount-value <=> CouponsState.coupon-discount-value;
        coupon-min-order <=> CouponsState.coupon-min-order;
        coupon-max-discount <=> CouponsState.coupon-max-discount;
        coupon-per-user-limit <=> CouponsState.coupon-per-user-limit;
        coupon-usage-limit <=> CouponsState.coupon-usage-limit;
        coupon-valid-from <=> CouponsState.coupon-valid-from;
        coupon-valid-until <=> CouponsState.coupon-valid-until;
        coupon-error-title <=> CouponsState.coupon-error-title;
        coupon-error-code <=> CouponsState.coupon-error-code;
        coupon-error-discount <=> CouponsState.coupon-error-discount;
        coupon-error-min <=> CouponsState.coupon-error-min;
        coupon-error-per-user <=> CouponsState.coupon-error-per-user;
        coupon-error-usage <=> CouponsState.coupon-error-usage;
        coupon-error-validity <=> CouponsState.coupon-error-validity;
        format-date(t) => { CouponsState.format-coupon-date(t) }
        close => { root.show-modal = false; }
        add-coupon => { CouponsState.add-coupon(); }
        update-coupon => { CouponsState.update-coupon(); }
        open-from-cal => { CouponsState.coupon-cal-open("from"); }
        open-until-cal => { CouponsState.coupon-cal-open("until"); }
    }

    // Pop-up do calendário de validade do Cupom (sobreposto ao modal).
    // `coupon-cal-target` controla qual campo será preenchido pelo pick.
    if root.show-modal && root.active-tab == "coupons" && root.modal-type == "coupon" && CouponsState.coupon-cal-target != "": CalendarPopup {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        title: CouponsState.coupon-cal-title;
        days: CouponsState.coupon-cal-days;
        prev => { CouponsState.coupon-cal-prev(); }
        next => { CouponsState.coupon-cal-next(); }
        pick(d) => { CouponsState.coupon-cal-pick(d); }
        clear => { CouponsState.coupon-cal-pick(""); }
        close => { CouponsState.coupon-cal-close(); }
    }

    if root.show-modal && root.active-tab == "customers": CustomerModal {
        editing-id <=> root.editing-id;
        customer-name <=> CustomersState.customer-name;
        customer-email <=> CustomersState.customer-email;
        customer-phone <=> CustomersState.customer-phone;
        customer-document <=> CustomersState.customer-document;
        customer-notes <=> CustomersState.customer-notes;
        customer-profile-picture <=> CustomersState.customer-profile-picture;
        customer-avatar-initial <=> CustomersState.customer-avatar-initial;
        customer-error-name <=> CustomersState.customer-error-name;
        customer-error-email <=> CustomersState.customer-error-email;
        customer-error-phone <=> CustomersState.customer-error-phone;
        customer-error-document <=> CustomersState.customer-error-document;
        customer-addresses: CustomersState.detail-addresses;
        addr-label <=> CustomersState.customer-addr-label;
        addr-custom-label <=> CustomersState.customer-addr-custom-label;
        addr-street <=> CustomersState.customer-addr-street;
        addr-number <=> CustomersState.customer-addr-number;
        addr-neighborhood <=> CustomersState.customer-addr-neighborhood;
        addr-apartment <=> CustomersState.customer-addr-apartment;
        close => { root.show-modal = false; }
        add-customer => { CustomersState.add-customer(); }
        update-customer => { CustomersState.update-customer(); }
        add-customer-address => { CustomersState.add-customer-address(); }
        delete-customer-address(id) => { CustomersState.delete-customer-address(id); }
        format-customer-phone(t) => { CustomersState.format-customer-phone(t) }
        format-customer-document(t) => { CustomersState.format-customer-document(t) }
    }

    if root.show-modal && root.active-tab == "addons" && root.modal-type == "addon-group": AddonGroupModal {
        editing-id <=> AddonsState.addon-group-form-id;
        group-name <=> AddonsState.addon-group-form-name;
        group-selection <=> AddonsState.addon-group-form-selection;
        group-min <=> AddonsState.addon-group-form-min;
        group-max <=> AddonsState.addon-group-form-max;
        error-name <=> AddonsState.addon-group-form-error;
        close => { root.show-modal = false; }
        add-group => { AddonsState.save-addon-group(); }
        update-group => { AddonsState.save-addon-group(); }
    }

    if root.show-modal && root.active-tab == "addons" && root.modal-type == "addon": AddonItemModal {
        editing-id <=> AddonsState.addon-form-id;
        group-name: AddonsState.selected-addon-group-name;
        addon-name <=> AddonsState.addon-form-name;
        addon-price <=> AddonsState.addon-form-price;
        error-name <=> AddonsState.addon-form-error;
        close => { root.show-modal = false; }
        add-addon => { AddonsState.save-addon(); }
        update-addon => { AddonsState.save-addon(); }
    }

    if root.show-modal && root.active-tab == "settings" && root.modal-type == "business-hours": SettingsModal {
        bh-editing-day-name <=> SettingsState.bh-editing-day-name;
        bh-open-time <=> SettingsState.bh-open-time;
        bh-close-time <=> SettingsState.bh-close-time;
        bh-is-open <=> SettingsState.bh-is-open;
        close => { root.show-modal = false; }
        save-business-hours => { SettingsState.save-business-hours(); }
        apply-time-mask(s) => { SettingsState.apply-time-mask(s) }
    }

    if OrdersState.show-cancel-modal: CancelOrderModal {
        cancel-target-id <=> OrdersState.cancel-target-id;
        cancel-target-label <=> OrdersState.cancel-target-label;
        cancel-reason <=> OrdersState.cancel-reason;
        cancel-error <=> OrdersState.cancel-error;
        close => { OrdersState.show-cancel-modal = false; }
        cancel-order(id, reason) => { OrdersState.cancel-order(id, reason); }
    }

    if OrdersState.show-edit-order-modal: EditOrderModal {
        order: OrdersState.detail-order;
        items <=> OrdersState.edit-order-items;
        edit-notes <=> OrdersState.edit-order-notes;
        edit-error: OrdersState.edit-order-error;
        products: OrdersState.edit-order-picker-products;
        close => { OrdersState.show-edit-order-modal = false; }
        inc-qty(idx) => { OrdersState.edit-order-inc(idx); }
        dec-qty(idx) => { OrdersState.edit-order-dec(idx); }
        delete-item(idx) => { OrdersState.edit-order-delete(idx); }
        edit-item(idx) => { OrdersState.edit-order-edit-item(idx); }
        // O clique no produto agora dispara `start-product-config`: o
        // Rust decide se adiciona direto (sem addons/variações) ou
        // abre o ProductConfiguratorModal (renderizado abaixo, em
        // cima do EditOrderModal via z-order natural).
        add-product(pid) => { ProductConfigState.start-product-config(pid); }
        filter-picker(q) => { OrdersState.edit-order-filter-picker(q); }
        save => { OrdersState.save-edit-order(); }
    }

    // Configurador de produto — modal próprio, empilhado sobre o
    // EditOrderModal quando o operador escolhe um produto com
    // variações/adicionais OU clica em "Editar item". Removido do
    // body do EditOrderModal para garantir botões Cancelar/Adicionar
    // sempre visíveis em telas pequenas.
    if ProductConfigState.config-product-id != "": ProductConfiguratorModal {
        config-product-id: ProductConfigState.config-product-id;
        config-product-name: ProductConfigState.config-product-name;
        config-product-image: ProductConfigState.config-product-image;
        config-qty: ProductConfigState.config-qty;
        config-variations: ProductConfigState.config-variations;
        config-addon-groups: ProductConfigState.config-addon-groups;
        config-final-display: ProductConfigState.config-final-display;
        config-error: ProductConfigState.config-error;
        config-edit-idx: ProductConfigState.config-edit-idx;
        config-toggle-variation(v, o) => { ProductConfigState.config-toggle-variation(v, o); }
        config-toggle-addon(g, a) => { ProductConfigState.config-toggle-addon(g, a); }
        config-inc-qty => { ProductConfigState.config-inc-qty(); }
        config-dec-qty => { ProductConfigState.config-dec-qty(); }
        // Dispatch baseado no contexto: PDV (push no carrinho) vs
        // EditOrderModal (push em edit_order_items). Cada contexto
        // tem seu próprio callback wirado para a lógica certa em Rust.
        config-confirm => {
            if (ProductConfigState.config-context == "pdv") {
                PdvUiState.pdv-config-confirm();
            } else {
                ProductConfigState.config-confirm-add();
            }
        }
        config-cancel => { ProductConfigState.config-cancel(); }
    }

    if OrdersState.receipt-modal-mode != "": ReceiptModal {
        mode: OrdersState.receipt-modal-mode;
        order: OrdersState.detail-order;
        items: OrdersState.detail-order-items;
        close => { OrdersState.receipt-modal-mode = ""; }
        print => {
            OrdersState.print-receipt-now(OrdersState.detail-order.id, OrdersState.receipt-modal-mode);
            // O modal fecha após disparar a impressão — o navegador
            // assume daqui e mostra o diálogo de impressão.
            OrdersState.receipt-modal-mode = "";
        }
    }

    // Calendário de período (filtro de Pedidos) — overlay full-window.
    if root.active-tab == "orders" && OrdersState.cal-open: CalendarPopup {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        title: OrdersState.cal-title;
        days: OrdersState.cal-days;
        prev => { OrdersState.cal-prev(); }
        next => { OrdersState.cal-next(); }
        pick(ymd) => { OrdersState.cal-pick(ymd); }
        clear => { OrdersState.cal-clear(); }
        close => { OrdersState.cal-open = false; }
    }

    if root.show-logout-confirm: LogoutConfirmModal {
        close => { root.show-logout-confirm = false; }
        do-logout => { root.do-logout(); }
    }

    if AdminState.detail-open: AdminCompanyDetailModal {
        data: AdminState.detail;
        orders: AdminState.detail-orders;
        close => { AdminState.detail-open = false; }
        manage => {
            AdminState.detail-open = false;
            AdminState.company-impersonate(AdminState.detail.id);
        }
    }

    if AdminState.del-company-open: DeleteConfirmModal {
        delete-target-name <=> AdminState.del-company-name;
        close => { AdminState.del-company-open = false; }
        confirm-delete => { AdminState.confirm-delete-company(); }
    }

    if AdminState.del-plan-open: DeleteConfirmModal {
        delete-target-name <=> AdminState.del-plan-name;
        close => { AdminState.del-plan-open = false; }
        confirm-delete => {
            AdminState.del-plan-open = false;
            AdminState.plan-delete(AdminState.del-plan-id);
        }
    }

    if ProductsState.produce-modal-open: ProduceModal {
        product-name: ProductsState.produce-product-name;
        form-quantity <=> ProductsState.produce-quantity;
        error: ProductsState.produce-error;
        confirm => { ProductsState.produce-confirm(); }
        close => { ProductsState.produce-modal-open = false; }
    }

    if AdminState.user-modal-open: AdminUserModal {
        form-id: AdminState.form-id;
        form-name <=> AdminState.form-name;
        form-email <=> AdminState.form-email;
        form-password <=> AdminState.form-password;
        roles: AdminState.admin-role-options;
        role-id <=> AdminState.user-form-role-id;
        save => { AdminState.save-user(AdminState.form-id, AdminState.form-name, AdminState.form-email, AdminState.form-password); }
        close => { AdminState.user-modal-open = false; }
    }

    if AdminState.del-user-open: DeleteConfirmModal {
        delete-target-name <=> AdminState.del-user-name;
        close => { AdminState.del-user-open = false; }
        confirm-delete => {
            AdminState.del-user-open = false;
            AdminState.delete-user(AdminState.del-user-id);
        }
    }

    if AdminState.role-modal-open: AdminRoleModal {
        form-id: AdminState.role-form-id;
        form-name <=> AdminState.role-form-name;
        screens: AdminState.role-form-screens;
        toggle-screen(k) => { AdminState.role-toggle-screen(k); }
        save => { AdminState.role-save(); }
        close => { AdminState.role-modal-open = false; }
    }

    if AdminState.del-role-open: DeleteConfirmModal {
        delete-target-name <=> AdminState.del-role-name;
        close => { AdminState.del-role-open = false; }
        confirm-delete => {
            AdminState.del-role-open = false;
            AdminState.role-delete(AdminState.del-role-id);
        }
    }

    if AdminState.plan-modal-open: AdminPlanModal {
        form-id: AdminState.plan-id;
        form-name <=> AdminState.plan-name;
        form-amount <=> AdminState.plan-amount;
        form-period <=> AdminState.plan-period;
        form-trial <=> AdminState.plan-trial;
        form-description <=> AdminState.plan-description;
        form-highlight <=> AdminState.plan-highlight;
        form-active <=> AdminState.plan-active;
        save => { AdminState.plan-save(); }
        close => { AdminState.plan-modal-open = false; }
    }

    if AdminState.sub-edit-open: AdminSubscriptionModal {
        company-name: AdminState.sub-edit-company-name;
        plan <=> AdminState.sub-edit-plan;
        status <=> AdminState.sub-edit-status;
        discount <=> AdminState.sub-edit-discount;
        discount-name <=> AdminState.sub-edit-discount-name;
        busy: AdminState.sub-edit-busy;
        plans: AdminState.plans;
        save => { AdminState.save-subscription(); }
