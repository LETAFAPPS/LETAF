            // Controle de Estoque (Kanban por status de saúde)
            if root.active-tab == "inventory": InventoryPage {
                health: InventoryState.inventory-health;
                products: InventoryState.inventory-products;
                is-admin: root.nav-perms.is-admin;
                search <=> InventoryState.inventory-search;
                filter <=> InventoryState.inventory-filter;
                type-filter <=> InventoryState.inventory-type-filter;
